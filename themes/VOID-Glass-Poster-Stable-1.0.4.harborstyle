    musicFull.setAttribute('data-v-atmo-mode','meter');
  }
  function atmoStop(){if(atmoTimer)win.clearInterval(atmoTimer);atmoTimer=0;atmoArtwork='';atmoLastColor='';atmoLoadSrc='';atmoLastStrength=-1;}
  function atmoSyncSettings(){
    if(!musicFull)return;
    var on=!!prefs.ambient;
    musicFull.setAttribute('data-v-atmo',on?'on':'off');
    if(!on){atmoStop();return;}
    atmoSetStrength(.30);
    var reduced=false;try{reduced=win.matchMedia('(prefers-reduced-motion: reduce)').matches;}catch(_e){}
    var shouldPoll=!!(prefs.ambpulse&&!prefs.performance&&prefs.motion&&!reduced&&!doc.hidden);
    if(shouldPoll&&!atmoTimer){atmoTimer=win.setInterval(atmoReadMeter,250);atmoReadMeter();}
    if(!shouldPoll&&atmoTimer){win.clearInterval(atmoTimer);atmoTimer=0;}
    if(!shouldPoll)musicFull.setAttribute('data-v-atmo-mode','static');
  }
  function closeMusicFull(restore){if(!musicFull)return;atmoStop();if(musicViewCtrl){musicViewCtrl.abort();musicViewCtrl=null;}spoolLast=-1;musicFull.remove();musicFull=null;motorDrop('left');motorDrop('right');clearMusicChrome();root.removeAttribute('data-v-m-full');qa('.v-m-expand').forEach(function(b){b.setAttribute('aria-expanded','false');b.setAttribute('aria-label',tx('Expand cassette player'));b.title=tx('Expand cassette player');});if(restore!==false&&musicFocus&&musicFocus.isConnected)musicFocus.focus({preventScroll:true});musicFocus=null;}
  function updateMusicFull(){if(!musicFull||!musicHost)return;
