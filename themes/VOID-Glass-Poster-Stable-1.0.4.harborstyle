  }
  function atmoReadMeter(){
    if(!musicFull||!musicHost||!prefs.ambient||!prefs.ambpulse||prefs.performance||!prefs.motion||doc.hidden)return;
    var play=q('.music-dock-play',musicHost),playing=!!(play&&musicPlaying(play));
    if(!playing){atmoSetStrength(.30);musicFull.setAttribute('data-v-atmo-mode','static');return;}
    var native=q('.music-dock-viz',musicHost);
    if(!native||native.dataset.resting==='true'){
      atmoSetStrength(.30);musicFull.setAttribute('data-v-atmo-mode','static');return;
    }
    var bars=qa('.music-dock-viz-bar',native);if(!bars.length){atmoSetStrength(.24);return;}
    var sum=0,count=0;for(var i=0;i<bars.length;i++){
      var n=Number(bars[i].style.getPropertyValue('--v'));
      if(Number.isFinite(n)){sum+=Math.max(0,Math.min(1,n));count++;}
    }
