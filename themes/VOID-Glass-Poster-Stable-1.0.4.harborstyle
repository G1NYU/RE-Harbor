  function mountClock(){if(!prefs.clock){if(clock){clock.remove();clock=null;}return;}if(!clock){clock=doc.createElement('span');clock.className='v-clock';}var t=new Date().toLocaleTimeString(arabicMode?'ar':[],{hour:'2-digit',minute:'2-digit'});if(clock.textContent!==t)clock.textContent=t;var a=slot();if(a){clock.style.cssText='';var ref=hey&&hey.parentNode===a?hey.nextSibling:a.firstChild;if(ref!==clock)a.insertBefore(clock,ref);}else if(clock.parentNode!==doc.body){clock.style.cssText='position:fixed;z-index:120;top:14px;right:330px';doc.body.appendChild(clock);}}
