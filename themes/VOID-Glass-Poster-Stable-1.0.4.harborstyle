    var source=info&&q('img',info),image=q('.v-cassette-cover',musicFull);if(source&&source.getAttribute('src')){var src=source.getAttribute('src');if(image.getAttribute('src')!==src)image.setAttribute('src',src);image.hidden=false;}else{image.removeAttribute('src');image.hidden=true;}
    if(prefs.ambient)atmoArtworkSync(source);
    musicMark(musicFull,'data-playing',String(musicPlaying(q('.music-dock-play',musicHost))));syncSpin();deckUpdateControls();
  }
  function openMusicFull(){if(!musicHost||!musicHost.hasAttribute('data-v-m-deck'))return;if(musicFull){closeMusicFull();return;}
    spoolLast=-1;musicFocus=doc.activeElement;var view=doc.createElement('section');musicFull=view;view.id='v-cassette-view';view.setAttribute('role','dialog');view.setAttribute('aria-modal','false');view.setAttribute('aria-labelledby','v-cassette-title');
    view.innerHTML='<div class="v-cassette-head"><span>VOID / CASSETTE PLAYER</span><button type="button" class="v-cassette-close">Collapse player</button></div><div class="v-cassette-layout"><div class="v-cassette-mechanics"><div class="v-tape" aria-hidden="true"><div class="v-tape-label"><div class="v-tape-writing"><span class="v-tape-song"></span><span class="v-tape-artist"></span></div><div class="v-tape-band"><span class="v-tape-side">A</span><div class="v-tape-window"><i class="v-tape-reel v-tape-reel-left"><span class="v-tape-pack"></span><b class="v-tape-notch v-tape-notch-1"></b><b class="v-tape-notch v-tape-notch-2"></b><b class="v-tape-notch v-tape-notch-3"></b></i><i class="v-tape-glass"></i><svg class="v-tape-run" viewBox="0 0 600 180" preserveAspectRatio="none" aria-hidden="true"><path class="v-tape-path" d="M72 56 L165 56 L435 56 L528 56 M72 130 L200 130 Q260 148 300 148 Q340 148 400 130 L528 130"/><path class="v-tape-motion" d="M72 56 L165 56 L435 56 L528 56 M72 130 L200 130 Q260 148 300 148 Q340 148 400 130 L528 130"/><circle class="v-tape-guide" cx="205" cy="130" r="9"/><circle class="v-tape-guide" cx="395" cy="130" r="9"/><rect class="v-tape-head" x="278" y="130" width="44" height="36" rx="7"/><path class="v-tape-head-gap" d="M300 131 L300 145"/></svg><span class="v-tape-scan">00:00</span><i class="v-tape-reel v-tape-reel-right"><span class="v-tape-pack"></span><b class="v-tape-notch v-tape-notch-1"></b><b class="v-tape-notch v-tape-notch-2"></b><b class="v-tape-notch v-tape-notch-3"></b></i></div></div><div class="v-tape-footer"><span>VOID <small>ANALOGUE SERIES</small></span><span>TYPE I / 60</span></div></div><div class="v-tape-bottom"><span class="v-shield-lip"></span><span class="v-shield-hole v-shield-hole-1"></span><span class="v-shield-hole v-shield-hole-2"></span><span class="v-shield-head"></span><span class="v-shield-hole v-shield-hole-3"></span><span class="v-shield-hole v-shield-hole-4"></span></div><i class="v-tape-screw"></i><i class="v-tape-screw"></i><i class="v-tape-screw"></i><i class="v-tape-screw"></i></div><div class="v-tape-readout" aria-label="Live cassette mechanics"><div><span>SUPPLY REEL</span><strong class="v-pack-left">100%</strong><i class="v-pack-rail"><b class="v-pack-fill-left"></b></i></div><div class="v-tape-readout-center"><span>TAPE COUNTER</span><strong class="v-tape-counter">0:00 <em>/ 0:00</em></strong><small>POSITION SYNCHRONIZED TO TRACK</small></div><div><span>TAKE-UP REEL</span><strong class="v-pack-right">0%</strong><i class="v-pack-rail"><b class="v-pack-fill-right"></b></i></div></div></div><div class="v-cassette-copy"><div class="v-cassette-topline"><img class="v-cassette-cover" alt="" hidden><div class="v-cassette-tag">NOW PLAYING</div></div><h1 id="v-cassette-title" class="v-cassette-title"></h1><p class="v-cassette-artist"></p><div class="v-eq" aria-hidden="true"></div><div class="v-cassette-workbench"><div class="v-cassette-status-line"><span class="v-cassette-state" aria-live="polite">PAUSED</span><span class="v-cassette-format">ANALOG TRANSPORT · SIDE A</span></div><input class="v-cassette-progress" type="range" aria-label="Seek current track" min="0" max="1" value="0" step="0.1"><div class="v-cassette-times"><span class="v-cassette-elapsed">0:00</span><span class="v-cassette-remaining">−0:00</span></div><div class="v-cassette-controls"><button type="button" data-v-player-action="previous" aria-label="Previous track" title="Previous track"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M5 5h2v14H5zm3 7 11-7v14z"/></svg></button><button type="button" class="v-cassette-play" data-v-player-action="play" aria-label="Play" title="Play or pause"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4 20 12 8 20Z" fill="currentColor"/></svg></button><button type="button" data-v-player-action="next" aria-label="Next track" title="Next track"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria