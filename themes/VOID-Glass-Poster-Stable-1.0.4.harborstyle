    left:{el:null,a:null,rate:0,goal:0,duration:5600,factor:1},
    right:{el:null,a:null,rate:0,goal:0,duration:5600,factor:1}
  };
  function motorDrop(key){
    var part=motorParts[key];
    if(part.a){try{part.a.cancel();}catch(_e){}}
    if(part.el)part.el.removeAttribute('data-v-motor');
    part.el=null;part.a=null;part.rate=0;part.goal=0;
  }
  function motorAttach(key,el){
