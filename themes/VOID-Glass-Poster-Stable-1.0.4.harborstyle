      qa('[data-v-ranks]',panel).forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.vRanks===prefs.ranks));});
      qa('[data-v-corners]',panel).forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.vCorners===prefs.corners));});
      qa('[data-v-typography]',panel).forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.vTypography===prefs.typography));});
