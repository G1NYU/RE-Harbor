    var glow=doc.createElement('div');glow.className='v-atmo-field';glow.setAttribute('aria-hidden','true');view.insertBefore(glow,view.firstChild);
    doc.body.appendChild(view);localeText(view);root.setAttribute('data-v-m-full','true');atmoSyncSettings();musicWindowEdge();qa('.v-m-expand').forEach(function(b){b.setAttribute('aria-expanded','true');b.setAttribute('aria-label',tx('Collapse cassette player'));b.title=tx('Collapse cassette player');});
    musicViewCtrl=new AbortController();
    view.addEventListener('click',function(e){
      var button=e.target.closest('[data-v-player-action]');if(!button||button.disabled)return;
      deckAction(button.getAttribute('data-v-player-action'));
    },{signal:musicViewCtrl.signal});
    var seeker=q('.v-cassette-progress',view);
