  function spoolRadius(loaded){
    var hub=.34,full=.82;
    return Math.sqrt(hub*hub+Math.max(0,Math.min(1,loaded))*(full*full-hub*hub));
  }
  function spoolPosition(){
    if(!musicHost)return 0;
    var range=q('.music-dock-seek input[type="range"]',musicHost);
    if(range){var max=Number(range.max),pos=Number(range.value);
      if(Number.isFinite(max)&&max>0&&Number.isFinite(pos))return Math.max(0,Math.min(1,pos/max));}
    var fill=q('.music-dock-seek-fill',musicHost);
    if(fill){var percent=parseFloat(fill.style.width);if(Number.isFinite(percent))return Math.max(0,Math.min(1,percent/100));}
    var m=(musicHost.innerText||'').match(/(\d+):(\d\d)\s*\/\s*(\d+):(\d\d)/);
    if(m){var total=+m[3]*60+ +m[4];if(total>0)return Math.max(0,Math.min(1,(+m[1]*60+ +m[2])/total));}
    return 0;
  }
