  /* v23.6 album lighting: reuse Harbor's existing Music Dock Visualizer meter.
     Native meter data is read from already-painted CSS custom properties only,
     at <= 4Hz while the expanded player is visible; no second meter consumer. */
  var atmoTimer=0,atmoArtwork='',atmoLastColor='',atmoLoadSrc='',atmoValues=new Map(),atmoLastStrength=-1;
  function atmoRgb(value){
    if(!value)return null;
    var n=String(value).trim(),m=n.match(/^#([\da-f]{6})$/i);
    if(m)return [parseInt(m[1].slice(0,2),16),parseInt(m[1].slice(2,4),16),parseInt(m[1].slice(4,6),16)];
    var nums=n.match(/^rgba?\(\s*(\d{1,3})(?:\s*,\s*|\s+)(\d{1,3})(?:\s*,\s*|\s+)(\d{1,3})/i);
    if(nums)return [+nums[1],+nums[2],+nums[3]].map(function(v){return Math.min(255,v);});
    return null;
  }
  function atmoApplyColor(rgb){
    if(!musicFull||!rgb)return;
    var value=rgb.join(' ');
    if(value!==atmoLastColor){atmoLastColor=value;musicFull.style.setProperty('--v-atmo-rgb',value);}
  }
  function atmoArtPixels(img){
    try{
      if(!img||!img.complete||!img.naturalWidth)return null;
      var canvas=doc.createElement('canvas');canvas.width=16;canvas.height=16;
      var ctx=canvas.getContext('2d',{willReadFrequently:true});if(!ctx)return null;
      ctx.drawImage(img,0,0,16,16);
      var d=ctx.getImageData(0,0,16,16).data;
      var buckets=new Map();
      for(var k=0;k<d.length;k+=4){
        if(d[k+3]<128)continue;
        var r=d[k],g=d[k+1],b=d[k+2];var mx=Math.max(r,g,b),mn=Math.min(r,g,b);
        if(mx<32||mn>235)continue;
        var key=[r>>5,g>>5,b>>5].join(':');var bin=buckets.get(key)||{r:0,g:0,b:0,n:0,score:0};
        bin.r+=r;bin.g+=g;bin.b+=b;bin.n++;bin.score+=.2+(mx-mn)/255;buckets.set(key,bin);
      }
      var best=null;buckets.forEach(function(bin){if(!best||bin.score>best.score)best=bin;});
      return best?[Math.round(best.r/best.n),Math.round(best.g/best.n),Math.round(best.b/best.n)]:null;
    }catch(_e){return null;} // Cross-origin artwork is not readable in canvas.
  }
  function atmoArtworkSync(img){
    if(!musicFull||!prefs.ambient)return;
    var url=img&&(img.currentSrc||img.getAttribute('src'))||'';
    if(url!==atmoArtwork){atmoArtwork=url;atmoLastColor='';atmoLoadSrc='';atmoLastStrength=-1;}
    if(!url){atmoApplyColor([111,114,134]);return;}
