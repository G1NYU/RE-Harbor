  /* Space is transport control while the cassette is expanded, even after
     focusing a slider or button; never activates the collapse button. */
  function isDeckSpace(e){return e.code==='Space'||e.key===' '||e.key==='Spacebar';}
  function deckSpaceAllowed(e){
    if(!musicFull||!musicFull.isConnected||!isDeckSpace(e))return false;
    if(e.ctrlKey||e.altKey||e.metaKey||e.shiftKey)return false;
    var t=e.target instanceof Element?e.target:null;
    if(t&&t.closest('textarea,select,[contenteditable="true"],input:not([type="range"]):not([type="checkbox"]):not([type="button"])'))return false;
    if(t){var other=t.closest('[role="dialog"],[aria-modal="true"]');if(other&&other!==musicFull)return false;}
    if(doc.querySelector('[data-harbor-manga-reader]'))return false;
    var video=q('[data-harbor-player]');if(video&&video.getClientRects().length>0)return false;
    return true;
  }
  function onDeckSpace(e){
    if(!deckSpaceAllowed(e))return;
    e.preventDefault();e.stopImmediatePropagation();
    if(e.repeat)return;
    deckAction('play');
  }
  function onDeckSpaceUp(e){
    if(!deckSpaceAllowed(e))return;
    e.preventDefault();e.stopImmediatePropagation();
  }
  function onDeckSeekKey(e){
    if(!musicFull||!musicFull.isConnected||!['ArrowLeft','ArrowRight'].includes(e.key))return;
    if(e.ctrlKey||e.altKey||e.metaKey||e.shiftKey)return;
    var t=e.target instanceof Element?e.target:null;
    if(t&&t.closest('input,textarea,select,[contenteditable="true"],[role="dialog"]:not(#v-cassette-view)'))return;
