  var names={home:'Home',discover:'Discover',catalogs:'Catalogue',movies:'Films',shows:'Series',anime:'Anime',manga:'Manga',ebook:'Books',music:'Music',games:'Games',live:'Live TV',sports:'Sports',library:'My Stuff','collections-hub':'Collections',collections:'Collections',vod:'Playlists',kids:'Kids',downloads:'Downloads',calendar:'Calendar',addons:'Add-ons',plugins:'Plug-ins',settings:'Settings'};
  function iconKey(id,label){if(id==='collections-hub')return 'collections';if(id==='vod')return 'shows';if(id==='kids')return 'movies';if(ICONS[id])return id;var l=(label||id||'').toLowerCase();if(/collect|list|watchlist|favou?rite/.test(l))return'collections';if(/download/.test(l))return'downloads';if(/calendar|schedule/.test(l))return'calendar';if(/music|audio/.test(l))return'music';if(/game/.test(l))return'games';if(/live|tv/.test(l))return'live';if(/sport/.test(l))return'sports';if(/book/.test(l))return'ebook';if(/plug|add/.test(l))return'addons';if(/librar|stuff/.test(l))return'library';return'catalogs';}
  function groupOf(it){var l=(it.id+' '+(it.label||'')).toLowerCase();if(/collect|list|favou?rite|librar|stuff|download|calendar/.test(l))return 4;if(/manga|ebook|books/.test(l))return 2;if(/music|games/.test(l))return 3;return 5;}
  function icon(key){return '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">'+(ICONS[key]||ICONS.dot)+'</svg>';}
  function native(){return q('aside[data-harbor-sidebar]');}
  function nativeItems(){var s=native();if(!s)return[];var seen=Object.create(null);return qa('[data-harbor-nav]',s).filter(function(el){var id=el.getAttribute('data-harbor-nav');if(!id||seen[id]||el.disabled||el.closest('[hidden]'))return false;seen[id]=1;return true;}).map(function(el){return{id:el.getAttribute('data-harbor-nav'),node:el,label:(el.getAttribute('aria-label')||el.textContent||'').trim()};});}

