  var BNAME={netflix:'Netflix',disney:'Disney+',hulu:'Hulu',prime:'Prime Video',apple:'Apple TV',max:'Max',paramount:'Paramount+',peacock:'Peacock',crunchyroll:'Crunchyroll',amcplus:'AMC+',starz:'Starz',shudder:'Shudder',tubi:'Tubi',pluto:'Pluto TV',roku:'Roku',fubo:'fubo',mgm:'MGM+',philo:'Philo',britbox:'BritBox',acorn:'Acorn TV',mubi:'MUBI',curiosity:'Curiosity',kanopy:'Kanopy',hoopla:'hoopla',pbs:'PBS',cw:'The CW',hidive:'HIDIVE'};
