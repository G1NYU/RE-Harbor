    [['left',left],['right',right]].forEach(function(pair){
      var el=q('.v-tape-reel-'+pair[0],musicFull);
      if(el)el.style.setProperty('--v-pack-size',(pair[1]*100).toFixed(2)+'%');
      var part=motorParts[pair[0]];
