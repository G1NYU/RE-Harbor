    var toggle=q('.v-cassette-play',musicFull),state=q('.v-cassette-state',musicFull);
    if(toggle){
      toggle.disabled=!parts.play||loading;
      toggle.setAttribute('aria-label',tx(loading?'Loading track':playing?'Pause':'Play'));
      toggle.title=tx(loading?'Track loading':playing?'Pause (Space)':'Play (Space)');
      var desired=loading?'<circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="36 16"/>':playing?'<rect x="6" y="4" width="4" height="16" rx="1" fill="currentColor"/><rect x="14" y="4" width="4" height="16" rx="1" fill="currentColor"/>':'<path d="M8 4 20 12 8 20Z" fill="currentColor"/>';
      var svg=q('svg',toggle);if(svg&&svg.innerHTML!==desired)svg.innerHTML=desired;
    }
    if(state){var label=tx(loading?'LOADING':playing?'PLAYING':'PAUSED');if(state.textContent!==label)state.textContent=label;}
    ['previous','next','shuffle','repeat'].forEach(function(key){
      var b=q('[data-v-player-action="'+key+'"]',musicFull);if(!b)return;
      b.disabled=!parts[key]||parts[key].tagName!=='BUTTON'||parts[key].disabled;
      if(key==='shuffle'||key==='repeat'){
        var native=parts[key];var on=!!native&&(native.getAttribute('aria-pressed')==='true'||native.classList.contains('music-dock-icon-on'));
        b.setAttribute('aria-pressed',String(on));
