  /* Top 10 rows: Harbor sizes cells for a whole number of slots, so ten cards in eleven slots leave a blank one. Spread them across the row. */
  function clearFill(){qa('[data-v-fillrow]').forEach(function(t){t.removeAttribute('data-v-fillrow');t.style.removeProperty('--v-n');t.style.removeProperty('--v-gap');});}
  function fillRows(){if(!prefs.fill)return;var list=qa('main button[data-no-card-ring]');if(!list.length)return;var seen=[];
    list.forEach(function(b){var t=b.closest('.harbor-row-track');if(!t||seen.indexOf(t)>-1)return;seen.push(t);
      var n=t.children.length;
      if(n<2||n>14){if(t.hasAttribute('data-v-fillrow')){t.removeAttribute('data-v-fillrow');t.style.removeProperty('--v-n');t.style.removeProperty('--v-gap');}return;}
