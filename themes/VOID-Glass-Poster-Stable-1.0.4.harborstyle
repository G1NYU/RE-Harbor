html[data-v-motion="off"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el])::before,html[data-v-motion="off"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el]){transition:none!important;}
@media (max-width:1100px){html[data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el]){transform:none!important;}}

html[data-v-ready] .harbor-row-shell h3{font-size:clamp(20px,1.6vw,26px)!important;font-weight:650!important;color:var(--color-ink)!important;}
html[data-v-ready] .harbor-row-shell h3::after{content:"";display:block;width:28px;height:2px;margin-top:8px;border-radius:2px;background:rgb(var(--v-ac-rgb));opacity:.85;}
html[data-v-ready] .harbor-poster{border-radius:var(--v-r)!important;outline:1px solid rgba(255,255,255,.08);outline-offset:-1px;}
html[data-v-ready] [data-media-card]:hover .harbor-poster,html[data-v-ready] .pick-card:hover .harbor-poster{outline-color:rgba(255,255,255,.55);}
html[data-v-ready]:not([data-v-ranks="numerals"]) button[data-no-card-ring]{aspect-ratio:auto!important;height:auto!important;}
html[data-v-ready]:not([data-v-ranks="numerals"]) button[data-no-card-ring]>span[aria-hidden="true"]{display:none!important;}
html[data-v-ready]:not([data-v-ranks="numerals"]) button[data-no-card-ring]>[data-preview-anchor]{position:relative!important;inset:auto!important;width:100%!important;}
html[data-v-ready]:not([data-v-ranks="numerals"]) button[data-no-card-ring]>p{position:static!important;width:100%!important;margin-top:10px;text-align:left;font:500 14px var(--v-text);color:var(--color-ink-muted);}
html[data-v-ranks="chips"] button[data-no-card-ring][data-v-rank]>[data-preview-anchor]::before{content:attr(data-v-rank);position:absolute;z-index:4;left:10px;bottom:10px;min-width:32px;height:32px;padding:0 9px;display:grid;place-items:center;border-radius:10px;font:700 14px/1 var(--v-display);letter-spacing:.02em;color:#fff;background:rgba(var(--v-bg-rgb),.82);border:1px solid var(--v-rim);pointer-events:none;}
html[data-v-ranks="chips"] button[data-no-card-ring][data-v-rank="01"]>[data-preview-anchor]::before{color:#060607;background:#f4f4f6;border-color:transparent;}
html[data-v-ranks="chips"][data-v-mood="netflix"] button[data-no-card-ring][data-v-rank="01"]>[data-preview-anchor]::before{color:#fff;background:#e50914;}
html[data-v-ranks="chips"][data-v-mood="hbo"] button[data-no-card-ring][data-v-rank="01"]>[data-preview-anchor]::before{color:#fff;background:linear-gradient(135deg,#5822b4,#2b4bff);}
html[data-v-ranks="chips"][data-v-mood="mocha"] button[data-no-card-ring][data-v-rank="01"]>[data-preview-anchor]::before{color:#1e1e2e;background:#cba6f7;}

html[data-v-ready] [data-scroll-anchor="streaming"] .harbor-row-track{grid-auto-columns:clamp(380px,30vw,560px)!important;}
html[data-v-ready] .harbor-service-tile{position:relative;overflow:hidden;height:clamp(230px,18vw,320px)!important;min-height:0!important;border-radius:28px!important;border:1px solid var(--v-rim)!important;background:var(--v-flat)!important;box-shadow:none!important;transition:transform .35s var(--v-ease),border-color .25s!important;}
html[data-v-ready] .harbor-service-tile::after{content:"";position:absolute;left:0;right:0;bottom:0;height:5px;background:rgb(var(--v-brand-rgb,var(--v-a-rgb)));}
html[data-v-ready] .harbor-service-tile:hover{transform:translateY(-4px);border-color:rgba(255,255,255,.4)!important;}
html[data-v-ready] .harbor-service-tile img,html[data-v-ready] [data-harbor-stream-tile] img{position:relative;z-index:1;filter:none!important;-webkit-filter:none!important;max-height:clamp(70px,6.4vw,120px)!important;width:auto!important;max-width:70%!important;object-fit:contain;}
html[data-v-ready] .harbor-service-tile[data-v-brand="apple"] img,html[data-v-ready] .harbor-service-tile[data-v-brand="peacock"] img{filter:brightness(0) invert(1)!important;-webkit-filter:brightness(0) invert(1)!important;}

[data-v-flowhost] .harbor-row-track{position:absolute!important;left:0;top:0;width:max-content!important;max-width:none!important;overflow:visible!important;opacity:0!important;pointer-events:none!important;}
.v-flow{--cw:clamp(400px,34vw,640px);--ch:calc(var(--cw)*.56);position:relative;height:calc(var(--ch) + 70px);margin:6px 0 10px;overflow:hidden;touch-action:pan-y;user-select:none;outline:none;cursor:grab;contain:layout paint;}
.v-flow:active{cursor:grabbing;}
.v-flow-stage{position:absolute;inset:0;}
.v-card{position:absolute;left:50%;top:calc(50% - 16px);width:var(--cw);height:var(--ch);margin:calc(var(--ch)/-2) 0 0 calc(var(--cw)/-2);border-radius:30px;border:1px solid var(--v-rim);background:var(--v-flat);overflow:hidden;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform .5s var(--v-ease),opacity .35s ease;will-change:transform,opacity;backface-visibility:hidden;}
.v-card::before{content:"";position:absolute;inset:0;z-index:3;background:#000;opacity:var(--dim,0);transition:opacity .4s;pointer-events:none;}
.v-card::after{content:"";position:absolute;left:0;right:0;bottom:0;height:6px;background:rgb(var(--b,236,236,240));}
.v-card img{max-width:58%;max-height:44%;object-fit:contain;pointer-events:none;-webkit-user-drag:none;}
.v-card[data-b="apple"] img,.v-card[data-b="peacock"] img{filter:brightness(0) invert(1);}
.v-card .v-name{position:absolute;left:28px;bottom:26px;font:600 12px var(--v-text);letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.55);}
.v-card .v-go{position:absolute;right:24px;top:22px;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.08);color:#fff;font:600 16px var(--v-text);opacity:0;transition:opacity .3s;}
.v-card[data-c="true"]:hover{border-color:rgba(255,255,255,.4);}
.v-card[data-c="true"] .v-go{opacity:1;}
.v-flow-btn{appearance:none;position:absolute;top:calc(50% - 16px);margin-top:-24px;z-index:80;width:48px;height:48px;border-radius:50%;border:1px solid var(--v-rim);background:rgba(var(--v-bg-rgb),.9);color:#fff;cursor:pointer;display:grid;place-items:center;font:500 22px var(--v-text);transition:background .2s,border-color .2s;}
.v-flow-btn:hover{background:rgba(255,255,255,.14);border-color:rgba(255,255,255,.4);}
.v-flow-btn[data-d="-1"]{left:10px;}.v-flow-btn[data-d="1"]{right:10px;}
.v-flow-count{position:absolute;left:0;right:0;bottom:6px;text-align:center;font:600 12px var(--v-text);letter-spacing:.22em;color:rgba(255,255,255,.45);font-variant-numeric:tabular-nums;}

html[data-v-ready] .modal-panel,html[data-v-ready] .harbor-profile-dropdown{background:var(--v-glass),rgba(var(--v-bg-rgb),.94)!important;border:1px solid var(--v-rim)!important;box-shadow:0 30px 70px -30px rgba(0,0,0,.95)!important;border-radius:26px!important;}
html[data-v-ready] .harbor-search-backdrop{background:rgba(var(--v-bg-rgb),.86)!important;}
html[data-v-jump-open] .harbor-search-backdrop{opacity:0!important;pointer-events:none!important;}

html[data-v-blur="on"] :is(#v-rail,#v-panel),html[data-v-blur="on"][data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el]){-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);}
html[data-v-blur="on"] #v-rail{background:var(--v-glass),rgba(var(--v-bg-rgb),.72);}
html[data-v-blur="on"][data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el]){background:var(--v-glass),rgba(var(--v-bg-rgb),.42);}
html[data-v-blur="on"] header [data-harbor-search]{-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);}

[data-v-bd]{opacity:0!important;pointer-events:none!important;}
html[data-v-picker] main.flex-1.overflow-y-auto{padding-left:clamp(28px,4vw,88px)!important;padding-right:clamp(28px,4vw,88px)!important;background:var(--color-canvas);}
[data-v-take]{max-width:none!important;width:100%!important;margin-left:0!important;margin-right:0!important;}
html[data-v-picker="list"] main h1{font-size:clamp(44px,5vw,84px)!important;font-weight:700!important;line-height:.98!important;letter-spacing:-.04em!important;}
html[data-v-picker="list"] main header p[class*="tracking-"]{letter-spacing:.24em!important;color:rgba(var(--v-ac-rgb),.9)!important;}
html[data-v-picker="list"] main [class*="group/back"] span[class*="h-12"],html[data-v-picker="list"] main [class*="group/refresh"] span[class*="h-12"]{background:var(--v-flat)!important;border:1px solid var(--v-hair);box-shadow:none!important;--tw-ring-shadow:0 0 #0000!important;}
html[data-v-picker="list"] main div[class*="bg-amber"],html[data-v-picker="list"] main div[class*="border-amber"]{border-radius:12px!important;background:rgba(255,184,76,.05)!important;border:1px solid rgba(255,184,76,.26)!important;box-shadow:none!important;}
html[data-v-picker="list"] main button[class*="rounded-2xl"][class*="bg-elevated"]{background:var(--v-flat)!important;border-radius:12px!important;box-shadow:none!important;border:1px solid var(--v-hair);}
html[data-v-picker="list"] main button[class*="rounded-full"]{box-shadow:none!important;}
[data-v-slist]{display:flex!important;flex-direction:column;gap:10px!important;}
[data-v-srow]{display:grid!important;grid-template-columns:72px minmax(0,1fr) auto;align-items:center;gap:28px!important;padding:22px 30px!important;border-radius:14px!important;background:var(--v-flat)!important;border:1px solid var(--v-hair)!important;box-shadow:none!important;--tw-ring-shadow:0 0 #0000!important;transition:background .2s,border-color .2s!important;}
[data-v-srow]:hover{background:var(--v-flat-2)!important;border-color:rgba(255,255,255,.18)!important;}
[data-v-srow]>div:nth-child(2)>p{columns:3 260px;column-gap:48px;}
[data-v-srow]>div:nth-child(2)>p>*{break-inside:avoid;}
[data-v-srow] button[class*="h-16"]{width:56px!important;height:56px!important;background:#f4f4f6!important;color:#060607!important;box-shadow:none!important;transition:transform .3s var(--v-ease)!important;}
[data-v-srow] button[class*="h-16"]:hover{transform:scale(1.07);background:#fff!important;}
[data-v-tiers]{gap:16px!important;}
[data-v-tiers]>div:first-child p{font-family:var(--v-display)!important;font-size:13px!important;font-weight:700!important;letter-spacing:.22em!important;text-transform:uppercase!important;color:rgba(255,255,255,.55)!important;}
[data-v-tierlist]{display:grid!important;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px!important;}
[data-v-tierlist]>button{min-height:84px!important;padding:14px 20px!important;gap:16px!important;border-radius:12px!important;border:1px solid var(--v-hair)!important;background:var(--v-flat)!important;box-shadow:none!important;transition:background .2s,border-color .2s!important;}
[data-v-tierlist]>button:hover{background:var(--v-flat-2)!important;border-color:rgba(255,255,255,.25)!important;}
[data-v-tierlist]>button[class*="border-ink/35"]{background:#18181b!important;border-color:#f4f4f6!important;}
[data-v-drawer]{border-radius:10px!important;padding:12px 20px!important;border:1px solid var(--v-hair)!important;background:var(--v-flat)!important;box-shadow:none!important;letter-spacing:.16em!important;}
[data-v-sources]{display:block!important;background:transparent!important;border:0!important;border-top:1px solid var(--v-hair)!important;border-radius:0!important;overflow:visible!important;padding:0;margin:0;}
[data-v-sources]>li{border:0!important;border-bottom:1px solid var(--v-hair)!important;list-style:none;}
[data-v-sources]>li>button{--q:236,236,240;position:relative;border-radius:0;padding:20px 24px 20px 28px!important;background:transparent;}
[data-v-sources]>li[data-q="4k"]>button{--q:255,206,110;}
[data-v-sources]>li:is([data-q="hd"],[data-q="fhd"])>button{--q:120,200,230;}
[data-v-sources]>li[data-q="sd"]>button{--q:140,140,150;}
[data-v-sources]>li[data-q="cam"]>button{--q:255,110,110;}
[data-v-sources]>li>button::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:rgb(var(--q));}
[data-v-sources]>li>button:hover{background:var(--v-flat-2);}

[data-v-wide]{max-width:min(1720px,100%)!important;}
html[data-v-ready] [data-music-view]{padding-inline:clamp(28px,3.4vw,72px);}
html[data-v-ready] [data-music-view] h1{font-size:clamp(40px,4vw,64px)!important;font-weight:700!important;letter-spacing:-.04em!important;line-height:1!important;}
html[data-v-ready] [data-music-view] .music-navigation [role="tab"]{font-family:var(--v-text);font-weight:600;color:var(--color-ink-muted);transition:color .2s;}
html[data-v-ready] [data-music-view] .music-navigation [role="tab"]:hover,html[data-v-ready] [data-music-view] .music-navigation [role="tab"][aria-selected="true"]{color:#fff;}
html[data-v-ready] [data-music-view] .music-home-feature{border-radius:30px!important;overflow:hidden;background:var(--v-flat)!important;border:1px solid var(--v-hair)!important;box-shadow:none!important;min-height:clamp(340px,26vw,460px);}
html[data-v-ready] [data-music-view] .music-home-feature-copy h2{font-size:clamp(40px,4.6vw,76px)!important;font-weight:700!important;line-height:.98!important;letter-spacing:-.045em!important;}
html[data-v-ready] [data-music-view] .music-home-eyebrow{font:600 11px var(--v-text)!important;letter-spacing:.24em!important;text-transform:uppercase;color:rgba(255,255,255,.55)!important;}
html[data-v-ready] [data-music-view] .music-collection-play{width:64px!important;height:64px!important;background:#f4f4f6!important;color:#060607!important;box-shadow:none!important;border-radius:50%!important;transition:transform .3s var(--v-ease)!important;}
html[data-v-ready] [data-music-view] .music-collection-play:hover{transform:scale(1.06);}
html[data-v-ready] [data-music-view] :is(.music-home-text,.music-home-primary){border-radius:999px!important;height:40px;padding:0 16px!important;background:rgba(255,255,255,.06)!important;border:1px solid var(--v-hair)!important;color:#fff!important;transition:background .2s!important;}
html[data-v-ready] [data-music-view] :is(.music-home-text,.music-home-primary):hover{background:rgba(255,255,255,.12)!important;}
html[data-v-ready] [data-music-view] .music-feature-browse{margin-top:14px;}
html[data-v-ready] [data-music-view] .music-feature-choice{position:relative;overflow:hidden;isolation:isolate;border-radius:16px!important;background:var(--v-flat)!important;border:1px solid var(--v-hair)!important;transition:background .2s,box-shadow .2s!important;}
html[data-v-ready] [data-music-view] .music-feature-choice:hover{background:var(--v-flat-2)!important;}
html[data-v-ready] [data-music-view] .music-feature-choice[data-selected="true"]{background:var(--v-flat-2)!important;box-shadow:inset 0 0 0 1px rgba(255,255,255,.3)!important;}
html[data-v-ready] [data-music-view] .music-feature-choice>button{background:transparent!important;border:0!important;box-shadow:none!important;outline:none!important;border-radius:0!important;}
html[data-v-ready] [data-music-view] .music-feature-choice>button:focus-visible{outline:2px solid rgba(var(--v-ac-rgb),.9)!important;outline-offset:-3px!important;}
html[data-v-ready] [data-music-view] .music-feature-choice img{border-radius:10px;}
html[data-v-ready] [data-music-view] .music-feature-controls button{width:38px;height:38px;border-radius:50%!important;background:var(--v-flat)!important;border:1px solid var(--v-hair)!important;color:#fff;}
html[data-v-ready] [data-music-view] .music-home-local{border-radius:20px!important;background:var(--v-flat)!important;border:1px solid var(--v-hair)!important;padding:22px 28px!important;margin-top:18px;box-shadow:none!important;}
html[data-v-ready] [data-music-view] .music-home-local-title h3{font-size:18px!important;font-weight:650!important;}
html[data-v-ready] [data-music-view] .music-home-local>button{border-radius:999px!important;border:1px solid var(--v-rim)!important;background:rgba(255,255,255,.06)!important;height:40px;padding:0 18px!important;}
html[data-v-ready] [data-music-view] .music-home-services{gap:10px;margin-top:16px;padding-bottom:6px;}
html[data-v-ready] [data-music-view] .music-home-services>button{height:40px;padding:0 16px!important;border-radius:999px!important;background:var(--v-flat)!important;border:1px solid var(--v-hair)!important;transition:border-color .2s,background .2s!important;}
html[data-v-ready] [data-music-view] .music-home-services>button:hover{border-color:rgba(255,255,255,.3)!important;background:var(--v-flat-2)!important;}
html[data-v-ready] [data-music-view] section :is(h2,h3){font-size:clamp(20px,1.6vw,26px)!important;font-weight:650!important;}
html[data-v-ready] [data-music-dock]{background:rgba(var(--v-bg-rgb),.98)!important;border-top:1px solid var(--v-hair)!important;box-shadow:none!important;}

html[data-v-page="manga"]{--v-mcard:clamp(196px,13.6vw,280px);}
html[data-v-page="manga"] main.flex-1.overflow-y-auto{padding-left:clamp(28px,3.2vw,64px)!important;padding-right:clamp(28px,3.2vw,64px)!important;}
html[data-v-page="manga"] main>div.mt-8,html[data-v-page="manga"] main>div.mt-6{margin-top:48px!important;}
html[data-v-page="manga"] main section h2{font-size:clamp(20px,1.6vw,26px)!important;font-weight:650!important;}
html[data-v-page="manga"] main div>h2[class*="text-[22px]"]{font-size:clamp(24px,2vw,32px)!important;font-weight:700!important;letter-spacing:-.03em!important;}
html[data-v-page="manga"] main .harbor-hero-bleed h1{font-size:clamp(40px,4.2vw,68px)!important;font-weight:700!important;line-height:1!important;letter-spacing:-.04em!important;}
html[data-v-page="manga"] main .harbor-hero-bleed span[class*="uppercase"]{color:rgba(255,255,255,.7)!important;letter-spacing:.24em!important;}
html[data-v-page="manga"] main .harbor-hero-bleed button[class*="bg-canvas"]{background:rgba(255,255,255,.1)!important;border:1px solid var(--v-rim);}
html[data-v-page="manga"] main .grid>button[class*="min-h-[84px]"]{min-height:112px!important;padding:20px 28px!important;border-radius:22px!important;background:var(--v-flat)!important;border:1px solid var(--v-hair)!important;box-shadow:none!important;transition:border-color .25s,background .25s,transform .3s var(--v-ease)!important;}
html[data-v-page="manga"] main .grid>button[class*="min-h-[84px]"]:hover{background:var(--v-flat-2)!important;border-color:rgba(255,255,255,.3)!important;transform:translateY(-2px);}
html[data-v-page="manga"] main .grid>button[class*="min-h-[84px]"] span[class*="text-[15.5px]"]{font:650 18px var(--v-display);letter-spacing:-.02em;}
html[data-v-page="manga"] main button[class*="rounded-xl"][class*="border-edge-soft"]{border-radius:12px!important;background:var(--v-flat)!important;}

html[data-v-mood="netflix"] .v-navbtn[data-active="true"],html[data-v-mood="hbo"] .v-navbtn[data-active="true"],html[data-v-mood="mocha"] .v-navbtn[data-active="true"]{background:rgba(var(--v-a-rgb),.14);}
html[data-v-mood="hbo"] #v-progress i{background:linear-gradient(90deg,#5822b4,#2b4bff);}
html[data-v-mood="mocha"] ::selection{background:rgba(203,166,247,.35);}

#v-jump{position:fixed;inset:0;z-index:200;display:grid;place-items:start center;padding-top:16vh;background:rgba(var(--v-bg-rgb),.86);font-family:var(--v-text);}
#v-jump[hidden]{display:none;}
.v-jump-box{width:min(560px,92vw);border-radius:22px;background:var(--v-flat);border:1px solid var(--v-rim);overflow:hidden;box-shadow:0 40px 90px -30px #000;}
.v-jump-box input{width:100%;box-sizing:border-box;height:58px;padding:0 22px;border:0;border-bottom:1px solid var(--v-hair);background:transparent;color:#fff;font:500 16px var(--v-text);outline:none;}
.v-jump-box ul{list-style:none;margin:0;padding:8px;max-height:46vh;overflow:auto;}
.v-jump-box li{display:flex;align-items:center;gap:14px;height:44px;padding:0 14px;border-radius:12px;color:var(--color-ink-muted);cursor:pointer;font:500 14.5px var(--v-text);}
.v-jump-box li svg{width:18px;height:18px;fill:currentColor;opacity:.8;}
.v-jump-box li[aria-selected="true"]{background:rgba(255,255,255,.09);color:#fff;}
.v-jump-box li[aria-selected="true"] svg{color:rgb(var(--v-ac-rgb));opacity:1;}
.v-jump-hint{display:flex;gap:16px;padding:10px 20px 12px;border-top:1px solid var(--v-hair);font:500 11.5px var(--v-text);color:rgba(255,255,255,.4);}
.v-jump-hint kbd{display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;padding:0 5px;margin-right:6px;box-sizing:border-box;border:1px solid rgba(255,255,255,.16);border-radius:6px;font:600 10.5px/1 var(--v-text);color:rgba(255,255,255,.6);}

#v-panel{position:fixed;z-index:160;right:22px;top:76px;width:min(390px,calc(100vw - 32px));max-height:calc(100vh - 100px - var(--v-dock-h,0px));overflow:auto;padding:22px;border-radius:26px;color:var(--color-ink);font-family:var(--v-text);background:var(--v-glass),rgba(var(--v-bg-rgb),.97);border:1px solid var(--v-rim);box-shadow:0 40px 90px -30px rgba(0,0,0,.95);scrollbar-width:thin;animation:v-pop .3s var(--v-ease);}
#v-panel[hidden]{display:none;}
@keyframes v-pop{from{opacity:0;transform:translateY(-6px)}}
#v-panel h3{margin:0 0 4px;font:700 22px/1.1 var(--v-display);}
#v-panel .v-sub{margin:0 0 14px;color:var(--color-ink-subtle);font-size:13px;}
#v-panel .v-field{margin:18px 0 8px;font:600 10px var(--v-text);letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.4);}
#v-panel .v-choices{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;}
#v-panel .v-choices[data-n="3"]{grid-template-columns:repeat(3,1fr);}
.v-choice{appearance:none;cursor:pointer;display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:14px;border:1px solid var(--v-rim);background:rgba(255,255,255,.03);color:var(--color-ink-muted);font:500 14px var(--v-text);text-align:left;transition:background .2s,color .2s,border-color .2s;}
.v-choice:hover{background:rgba(255,255,255,.08);color:#fff;}
.v-choice[aria-pressed="true"]{color:#fff;border-color:rgba(255,255,255,.55);background:rgba(255,255,255,.1);}
.v-choice i{width:16px;height:16px;border-radius:50%;flex:none;box-shadow:inset 0 0 0 1px rgba(255,255,255,.3);}
.v-switch{appearance:none;cursor:pointer;width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:11px 2px;border:0;background:transparent;color:var(--color-ink);text-align:left;font:500 14.5px var(--v-text);border-bottom:1px solid rgba(255,255,255,.06);}
.v-switch small{display:block;margin-top:2px;font-size:12px;font-weight:400;color:var(--color-ink-subtle);}
.v-switch b{flex:none;width:38px;height:22px;border-radius:99px;background:rgba(255,255,255,.14);position:relative;transition:background .25s;}
.v-switch b::after{content:"";position:absolute;left:3px;top:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:transform .3s var(--v-ease);}
.v-switch[aria-pressed="true"] b{background:#f4f4f6;}
.v-switch[aria-pressed="true"] b::after{transform:translateX(16px);background:#060607;}
#v-panel .v-wide{grid-column:1/-1;width:100%;margin-top:12px;justify-content:space-between;}
#v-panel .v-ghost{margin-top:8px;}
#v-panel .v-foot{margin:12px 2px 0;font-size:12px;color:var(--color-ink-subtle);}

html[data-player-chrome-mounted] :is(#v-rail,#v-edge,#v-panel,#v-progress,#v-jump,.v-hey,.v-clock){display:none!important;}
html[data-chrome-hidden] :is(#v-rail,#v-edge,#v-panel,#v-jump),html[data-big-picture="true"] :is(#v-rail,#v-edge,#v-panel,#v-jump,#v-progress){display:none!important;}
@media (prefers-reduced-motion:reduce){.v-logo::before,.v-logo::after{animation:none!important}.v-card,.v-navbtn{transition:none!important}html[data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el]),html[data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el])::before{transition:none!important}html[data-v-fade="on"][data-v-entering] main{animation:none}}
@media (max-width:760px){#v-rail{left:8px;top:8px;bottom:calc(8px + var(--v-dock-h,0px));width:calc(100vw - 16px);max-width:340px}}

/* v17 shared layout, keyboard and responsive safeguards */
#v-panel,#v-rail,.v-navbtn,.v-choice,.v-switch{box-sizing:border-box;}
#v-panel{scrollbar-gutter:stable;overscroll-behavior:contain;}
.v-navbtn{flex-shrink:0;min-width:0;}
.v-navbtn>span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.v-nav{overscroll-behavior:contain;}
.v-nav-label,.v-rail-head,.v-rail-foot{flex-shrink:0;}
.v-navbtn[hidden],#v-panel[hidden],#v-jump[hidden]{display:none!important;}
#v-panel :is(button,input):focus-visible{outline:2px solid rgb(var(--v-ac-rgb));outline-offset:2px;}
.v-flow:focus-visible{outline:2px solid rgb(var(--v-ac-rgb));outline-offset:-3px;}
.v-flow{--cw:min(88vw,clamp(400px,34vw,640px));}
.v-flow-btn:disabled{opacity:.3;cursor:default;}
.v-panel-head{display:flex;align-items:center;justify-content:space-between;gap:16px;}
.v-close{display:grid;place-items:center;flex:none;width:30px;height:30px;padding:0;border:1px solid var(--v-rim);border-radius:50%;background:rgba(255,255,255,.06);color:var(--color-ink);font:22px/1 var(--v-text);cursor:pointer;}
.v-jump-empty{pointer-events:none;opacity:.65;}
@media(max-width:600px){
  html[data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el]){max-width:100%;width:100%;height:58px;}
  html[data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el])>button{min-width:0;padding:0 10px!important;font-size:12px!important;gap:6px;}
  [data-v-srow]{grid-template-columns:40px minmax(0,1fr) auto;gap:10px!important;padding:16px 12px!important;}
  [data-v-tierlist]{grid-template-columns:minmax(0,1fr);}
  [data-v-srow]>div:nth-child(2)>p{columns:auto;}
  [data-music-view] .music-home-local{flex-wrap:wrap;gap:16px;}
}
@media(min-width:1001px){html[data-v-pin="on"][data-v-page="manga"] main.flex-1.overflow-y-auto{padding-left:calc(var(--v-side) + 22px)!important;}}
@media(max-height:620px){.v-rail-head{padding:18px 20px 16px;}.v-rail-foot{padding:6px 14px 8px;}.v-rail-foot .v-navbtn{height:34px;}}
html[data-v-motion="off"] :is(.v-card,.v-flow-btn,.v-navbtn,#v-rail,#v-edge,.v-card::before){transition:none!important;}
html[data-v-motion="off"][data-v-entering] main{animation:none!important;}
@media(prefers-reduced-motion:reduce){#v-rail,#v-edge,.v-card::before{transition:none!important;}}

html[data-v-motion="off"] .v-card::before{transition:none!important;}

/* VOID v20: compact native controls, playback-linked record, original cassette view. */
html[data-v-deck="on"] [data-v-m-deck]{height:88px!important;overflow:visible!important;background:linear-gradient(180deg,rgba(255,255,255,.025),transparent 55%),rgb(var(--v-bg-rgb))!important;border-top:1px solid var(--v-rim)!important;box-shadow:0 -8px 24px -20px #000!important;font-family:var(--v-text);}
html[data-v-deck="on"] [data-v-m-grid]{display:grid!important;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr)!important;align-items:center!important;gap:10px!important;height:100%!important;padding:8px 18px 24px!important;box-sizing:border-box;}
html[data-v-deck="on"] [data-v-m-column="info"]{min-width:0;gap:8px!important;}
html[data-v-deck="on"] [data-v-m-column="info"]>*{min-width:0;}
html[data-v-deck="on"] [data-v-m-column="transport"]{display:flex!important;align-items:center!important;justify-content:center!important;gap:2px!important;background:none!important;border:0!important;box-shadow:none!important;border-radius:0!important;min-width:0;}
html[data-v-deck="on"] [data-v-m-column="tools"]{min-width:0;justify-self:end;gap:2px!important;}
html[data-v-deck="on"] [data-v-m-column="transport"]>button{position:relative!important;inset:auto!important;transform:none!important;flex-shrink:0;width:44px!important;height:44px!important;padding:0!important;margin:0!important;border:0!important;border-radius:8px!important;box-shadow:none!important;background:transparent!important;color:var(--color-ink-muted)!important;}
html[data-v-deck="on"] [data-v-m-column="transport"]>button:not(:disabled):hover{background:rgba(255,255,255,.045)!important;color:var(--color-ink)!important;}
html[data-v-deck="on"] [data-v-m-column="transport"]>.music-dock-play{border:1px solid var(--v-rim)!important;border-radius:50%!important;background:rgba(255,255,255,.065)!important;color:var(--color-ink)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.06)!important;}
html[data-v-deck="on"] [data-v-m-column="transport"]>button[data-v-m-toggle="on"]{background:rgba(var(--v-a-rgb),.13)!important;color:rgb(var(--v-a-rgb))!important;}
html[data-v-deck="on"] [data-v-m-column="transport"]>button[data-v-m-toggle="on"]::after{content:"";position:absolute;bottom:3px;left:calc(50% - 2px);width:4px;height:4px;border-radius:50%;background:currentColor;pointer-events:none;}
html[data-v-deck="on"] [data-v-m-column="transport"]>button:focus-visible,.v-m-expand:focus-visible,.v-m-record:focus-visible{outline:2px solid rgb(var(--v-a-rgb));outline-offset:2px;}
html[data-v-deck="on"] [data-v-m-deck]>.music-dock-seek{top:auto!important;bottom:2px!important;inset-inline:18px!important;height:20px!important;z-index:5;}
html[data-v-deck="on"] [data-v-m-deck] .music-dock-seek-track{top:9px!important;height:3px;border-radius:999px;background:rgba(255,255,255,.13)!important;}
html[data-v-deck="on"] [data-v-m-deck] .music-dock-seek-fill{border-radius:999px;background:rgb(var(--v-a-rgb))!important;}
.v-m-record{appearance:none;position:absolute;top:-38px;inset-inline-start:58px;width:112px;height:38px;overflow:hidden;padding:0!important;margin:0!important;border:0!important;border-radius:0!important;background:none!important;box-shadow:none!important;cursor:pointer;z-index:1;}
.v-m-record img{display:block;width:112px;height:112px;max-width:none;border-radius:50%;pointer-events:none;animation:v-media-turn 12s linear infinite;animation-play-state:paused;}
[data-v-m-playing="true"] .v-m-record img{animation-play-state:running;}
[data-music-dock]:is([data-auto-hidden],[data-closing]) .v-m-record{visibility:hidden;}
.v-m-expand{appearance:none;display:grid;place-items:center;flex-shrink:0;width:40px;height:44px;border:0;border-radius:8px;background:transparent;color:var(--color-ink-muted);cursor:pointer;padding:0;}
.v-m-expand:hover{color:var(--color-ink);background:rgba(255,255,255,.045);}
html[data-v-m-full="true"] [data-music-dock]{z-index:170!important;}
/* The cassette view is z=165 and the expanded dock z=170: keep navigation
   and its edge trigger reachable, without covering Harbor's window chrome. */
html[data-v-m-full="true"] #v-edge{z-index:181!important;}
html[data-v-m-full="true"] #v-rail{z-index:182!important;}
html[data-v-m-full="true"] #v-panel{z-index:183!important;}
html[data-v-m-full="true"] #v-jump{z-index:200!important;}
#v-cassette-view{position:fixed;inset:38px 0 calc(var(--v-dock-h,88px) + var(--harbor-viewport-bottom,0px));z-index:165;overflow:auto;overscroll-behavior:contain;background:radial-gradient(ellipse at 25% 30%,rgba(var(--v-a-rgb),.07),transparent 55%),rgb(var(--v-bg-rgb));color:var(--color-ink);font-family:var(--v-text);padding:24px clamp(20px,5vw,80px) 40px;box-sizing:border-box;}
.v-cassette-head{display:flex;align-items:center;justify-content:space-between;gap:20px;max-width:1180px;margin:0 auto 24px;font:600 11px/1.5 var(--v-text);letter-spacing:.16em;color:var(--color-ink-muted);}
.v-cassette-head button{appearance:none;min-height:44px;padding:0 16px;border:1px solid var(--v-rim);border-radius:10px;background:var(--v-flat-2);color:var(--color-ink);font:500 13px var(--v-text);cursor:pointer;letter-spacing:normal;}
.v-cassette-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);align-items:center;gap:clamp(24px,5vw,80px);max-width:1180px;min-height:calc(100% - 100px);margin:auto;}
.v-cassette-copy{min-width:0;}
.v-cassette-copy h1{font:700 clamp(28px,4vw,56px)/1.1 var(--v-display);letter-spacing:-.04em;overflow-wrap:anywhere;margin:16px 0;}
.v-cassette-copy p{font:400 clamp(16px,2vw,22px)/1.5 var(--v-text);color:var(--color-ink-muted);overflow-wrap:anywhere;margin:0 0 20px;}
.v-cassette-copy small{font:500 12px/1.6 var(--v-text);color:var(--color-ink-subtle);display:block;}
.v-cassette-tag{font:600 10px/1.5 var(--v-text);letter-spacing:.22em;color:rgb(var(--v-a-rgb));}
.v-cassette-cover{width:72px;height:72px;object-fit:cover;border-radius:8px;border:1px solid var(--v-rim);}
.v-tape{position:relative;width:100%;aspect-ratio:1.59;box-sizing:border-box;border:2px solid #49494c;border-radius:16px;background:repeating-linear-gradient(0deg,#222225 0 2px,#27272a 2px 4px);box-shadow:inset 0 1px 0 #ffffff18,0 18px 30px -22px #000;padding:7% 6% 17%;}
.v-tape-label{height:100%;background:#d9d4c9;border:4px solid #171719;border-radius:12px;overflow:hidden;display:flex;flex-direction:column;color:#242325;}
.v-tape-writing{display:flex;flex-direction:column;justify-content:center;gap:3px;height:35%;padding:3% 6%;background:repeating-linear-gradient(0deg,transparent 0 18px,#77777724 18px 19px);overflow:hidden;}
.v-tape-song,.v-tape-artist{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.v-tape-song{font:600 clamp(12px,1.5vw,19px)/1.25 Georgia,serif;font-style:italic;}
.v-tape-artist{font:500 clamp(9px,1vw,13px)/1.25 var(--v-text);}
.v-tape-band{display:flex;align-items:center;gap:4%;height:45%;padding:0 5%;background:rgba(70,61,59,.18);border-block:1px solid #605b5540;}
.v-tape-side{font:700 clamp(20px,3vw,34px)/1 var(--v-display);}
.v-tape-window{height:72%;flex:1;position:relative;display:flex;align-items:center;justify-content:space-between;padding:0 6%;border:3px solid #28282a;border-radius:5px;background:linear-gradient(120deg,#242427,#454447 55%,#242427);overflow:hidden;}
.v-tape-reel{height:82%;aspect-ratio:1;border:3px solid #b2b0aa;border-radius:50%;position:relative;flex:none;box-sizing:border-box;background:repeating-conic-gradient(#aaa8a1 0deg 12deg,#242427 12deg 60deg);box-shadow:0 0 0 3px #18181a;animation:v-media-turn 7s linear infinite;animation-play-state:paused;}
.v-tape-reel::after{content:"";position:absolute;inset:35%;border-radius:50%;background:#151517;border:1px solid #b7b5af;}
.v-tape-reel:last-child{animation-duration:9s;}
.v-tape-glass{width:26%;height:70%;border:2px solid #151517;border-radius:3px;background:radial-gradient(circle at -20% 50%,#4c3c30 0 56%,transparent 58%),radial-gradient(circle at 120% 50%,#4c3c30 0 56%,#151517 58%);}
.v-tape-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 6%;height:20%;font:700 clamp(9px,1.2vw,15px) var(--v-display);letter-spacing:.06em;}
.v-tape-footer small{font:600 8px var(--v-text);letter-spacing:.1em;}
.v-tape-bottom{position:absolute;left:17%;right:17%;bottom:0;height:15%;background:linear-gradient(180deg,#2c2c2f,#1e1e21);border:1px solid #111;clip-path:polygon(7% 0,93% 0,100% 100%,0 100%);}
.v-tape-bottom::before,.v-tape-bottom::after{content:"";position:absolute;top:32%;width:9%;aspect-ratio:1;border:2px solid #333;border-radius:50%;background:#111;}
.v-tape-bottom::before{left:10%;}.v-tape-bottom::after{right:10%;}
.v-tape-screw{position:absolute;width:3%;aspect-ratio:1;background:linear-gradient(45deg,#555 43%,#151517 44% 55%,#555 56%);border:1px solid #171719;border-radius:50%;}
.v-tape-screw:nth-last-child(1){bottom:3%;right:2%;}.v-tape-screw:nth-last-child(2){bottom:3%;left:2%;}.v-tape-screw:nth-last-child(3){top:3%;right:2%;}.v-tape-screw:nth-last-child(4){top:3%;left:2%;}
#v-cassette-view[data-playing="true"] .v-tape-reel{animation-play-state:running;}
@keyframes v-media-turn{to{transform:rotate(360deg);}}
html[data-v-motion="off"] :is(.v-m-record img,.v-tape-reel){animation:none!important;}
@media(prefers-reduced-motion:reduce){.v-m-record img,.v-tape-reel{animation:none!important;}}
@media(max-width:1099px){html[data-v-deck="on"] [data-v-m-grid]{grid-template-columns:minmax(0,1fr) auto auto!important;padding-inline:12px!important;gap:4px!important;}}
@media(max-width:699px){
 html[data-v-deck="on"] [data-v-m-deck]{height:116px!important;}
 html[data-v-deck="on"] [data-v-m-grid]{grid-template-columns:minmax(0,1fr) auto!important;grid-template-rows:38px 44px!important;padding:8px 10px 24px!important;gap:2px 4px!important;}
 html[data-v-deck="on"] [data-v-m-column="info"]{grid-row:1;grid-column:1;}
 html[data-v-deck="on"] [data-v-m-column="transport"]{grid-row:2;grid-column:1/-1;justify-self:center;}
 html[data-v-deck="on"] [data-v-m-column="tools"]{grid-row:1;grid-column:2;}
 .v-m-record{width:96px;height:32px;top:-32px;inset-inline-start:36px;}.v-m-record img{width:96px;height:96px;}
 .v-cassette-layout{grid-template-columns:minmax(0,1fr);gap:24px;align-content:start;}
 .v-cassette-copy h1{font-size:30px;}.v-tape{max-width:520px;margin:auto;}.v-tape-song{font-size:15px;}.v-tape-artist{font-size:11px;}
 .v-cassette-head{margin-bottom:28px;}.v-cassette-head span{letter-spacing:.08em;font-size:9px;}
}

html[data-v-m-full="true"] [data-music-dock]{transform:none!important;pointer-events:auto!important;will-change:auto!important;}
html[data-v-m-full="true"] [data-music-dock] .v-m-record{visibility:visible;}
#v-cassette-view button:focus-visible{outline:2px solid rgb(var(--v-a-rgb));outline-offset:3px;}

html[data-v-m-full="true"] [data-music-queue]{z-index:185!important;}

/* v20.2: real title-bar clearance and marker-lettered track titles only. */
#v-cassette-view{top:var(--v-player-top,80px)!important;}
html[data-v-m-full="true"] header:has([data-harbor-topbar-content]){z-index:190!important;}
#v-cassette-view .v-cassette-copy .v-cassette-title{
 font-family:'Permanent Marker','Segoe Print','Bradley Hand','Comic Sans MS',cursive!important;
 font-weight:400!important;font-style:normal!important;line-height:1.25!important;letter-spacing:.005em!important;
 overflow-wrap:anywhere;padding-block:4px 8px;text-transform:none;
}
#v-cassette-view .v-tape-song{
 font-family:'Permanent Marker','Segoe Print','Bradley Hand','Comic Sans MS',cursive!important;
 font-weight:400!important;font-style:normal!important;line-height:1.4!important;letter-spacing:.01em;
 padding-block:2px;
}

/* VOID v21: manga-only hardcovers; native cards, artwork and event handlers stay in place. */
html[data-v-page="manga"][data-v-books="on"] [data-v-book]{position:relative;perspective:1000px;isolation:isolate;}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage]{position:relative;overflow:visible!important;transform-style:preserve-3d;transform-origin:18% 50%;transform:rotateY(-46deg) translateZ(0)!important;transition:transform .5s cubic-bezier(.2,.75,.2,1)!important;}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage]::before{content:"";position:absolute;inset:4px 2px 4px 9px;z-index:0;border:1px solid #b6ad9b;border-radius:2px 7px 7px 2px;background:linear-gradient(90deg,#a99d85 0,#e6dfcf 8%,#f0eadc 40%,#e1d8c5 100%),repeating-linear-gradient(0deg,#d4cbb9 0 1px,#eee8da 1px 3px);background-blend-mode:multiply;transform:translateZ(-4px);box-shadow:inset 6px 0 9px -7px #4d4135,3px 3px 5px #0004;pointer-events:none;}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage]::after{content:"";position:absolute;inset:auto 1px -7px 0;height:7px;z-index:-1;border-radius:50%;background:#ffffff06;box-shadow:0 5px 10px #0008;pointer-events:none;}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-cover]{position:relative;z-index:2;border-radius:3px 8px 8px 3px!important;transform-origin:0 50%;transform:translateZ(5px) rotateY(0deg);transition:transform .55s cubic-bezier(.2,.75,.2,1) .08s!important;backface-visibility:hidden;box-shadow:inset 10px 0 10px -10px #000c,0 2px 7px #0008!important;}
.v-book-spine{position:absolute;z-index:4;inset:0 auto 0 0;width:18px;box-sizing:border-box;padding:34px 3px 12px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;writing-mode:vertical-rl;text-orientation:mixed;transform:translateZ(7px);border-radius:3px 0 0 3px;border-inline:1px solid #ffffff13;background:linear-gradient(90deg,#111114,#303035 46%,#151518);box-shadow:inset -2px 0 3px #0008;color:#dedad0;font:600 10px/12px var(--v-text);letter-spacing:.08em;pointer-events:none;user-select:none;}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage]>:is([role="button"],span.absolute,div.absolute){z-index:8;transform:translateZ(45px)!important;}
html[data-v-page="manga"][data-v-books="on"] [data-v-book]:focus-visible{outline:2px solid rgba(var(--v-a-rgb),.6);outline-offset:6px;border-radius:6px;}
html[data-v-page="manga"][data-v-books="on"] [data-v-book]:focus-visible [data-v-book-stage]{transform:translateY(-8px) rotateY(-5deg) translateZ(14px)!important;}
html[data-v-page="manga"][data-v-books="on"] [data-v-book]:focus-visible [data-v-book-cover]{transform:translateZ(5px) rotateY(-56deg);transition-delay:.15s!important;}
@media(hover:hover) and (pointer:fine){
 html[data-v-page="manga"][data-v-books="on"] [data-v-book]:hover{z-index:3;}
 html[data-v-page="manga"][data-v-books="on"] [data-v-book]:hover [data-v-book-stage]{transform:translateY(-8px) rotateY(-5deg) translateZ(14px)!important;}
 html[data-v-page="manga"][data-v-books="on"] [data-v-book]:hover [data-v-book-cover]{transform:translateZ(5px) rotateY(-56deg);transition-delay:.15s!important;}
}
@media(hover:none),(pointer:coarse){
 html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage]{transform:rotateY(-12deg)!important;transition:none!important;}
 html[data-v-page="manga"][data-v-books="on"] [data-v-book-cover]{transform:translateZ(5px)!important;transition:none!important;}
}
html[data-v-motion="off"][data-v-page="manga"][data-v-books="on"] [data-v-book-stage],html[data-v-motion="off"][data-v-page="manga"][data-v-books="on"] [data-v-book-cover]{transform:none!important;transition:none!important;}
@media(prefers-reduced-motion:reduce){
 html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage],html[data-v-page="manga"][data-v-books="on"] [data-v-book-cover]{transform:none!important;transition:none!important;}
}

/* ===== VOID v21.2 ===== */
/* -- Music deck: CD sheen, cassette life -- */
.v-m-record{--cd:112px;width:var(--cd);transition:filter .25s ease;}
.v-m-record img{animation:none!important;width:var(--cd);height:var(--cd);will-change:transform;}
.v-m-record::after{content:"";position:absolute;left:0;top:0;width:var(--cd);height:var(--cd);border-radius:50%;pointer-events:none;background:conic-gradient(from 25deg,transparent 0 18%,rgba(255,255,255,.28) 24%,transparent 31% 66%,rgba(255,255,255,.2) 73%,transparent 80%),radial-gradient(circle,transparent 0 21%,rgba(0,0,0,.35) 22% 23%,transparent 24%);mix-blend-mode:screen;}

.v-m-record{top:-32px;height:32px;}
@media(max-width:699px){.v-m-record{top:-28px;height:28px;}}
.v-m-record .v-cd{display:block;position:relative;width:var(--cd);height:var(--cd);border-radius:50%;will-change:transform;background:radial-gradient(circle,transparent 0 17%,#050506 17.5% 20%,transparent 20.5%),repeating-radial-gradient(circle,#1b1b1f 0 1.5px,#0e0e10 1.5px 3px);box-shadow:inset 0 0 0 2px #2c2c31,0 0 0 1px #000;}
.v-m-record .v-cd::before{content:"";position:absolute;inset:0;border-radius:50%;background:conic-gradient(transparent 0 6%,rgba(255,94,156,.5) 9%,rgba(94,200,255,.5) 13%,rgba(125,255,158,.4) 17%,transparent 21% 55%,rgba(255,210,94,.42) 59%,rgba(181,107,255,.5) 64%,transparent 69%);-webkit-mask:radial-gradient(circle,transparent 0 27%,#000 28%);mask:radial-gradient(circle,transparent 0 27%,#000 28%);}
.v-m-record .v-cd img.v-cd-art{position:absolute;left:30%;top:30%;width:40%;height:40%;max-width:none;object-fit:cover;border-radius:50%;box-shadow:0 0 0 2px #000,0 0 0 3px #ffffff22;pointer-events:none;}
.v-m-record .v-cd img.v-cd-art[hidden]{display:none;}
.v-m-record:hover{transform:none;filter:brightness(1.2) drop-shadow(0 -3px 9px rgba(var(--v-a-rgb),.28));}
[data-v-m-playing="true"] .v-m-record{filter:drop-shadow(0 -6px 14px rgba(var(--v-a-rgb),.22));}
@media(max-width:699px){.v-m-record{--cd:96px;}}
/* Script-driven inertia is preferred. CSS playback animation remains a
   fallback for older WebViews without Element.animate(). */
.v-m-record .v-cd:not([data-v-spin-waapi]){animation:v-media-turn 6s linear infinite;animation-play-state:paused;}
[data-v-m-playing="true"] .v-m-record .v-cd:not([data-v-spin-waapi]){animation-play-state:running;}
/* A running WAAPI spin must not compete with Harbor's earlier CSS reel animation. */
.v-tape-reel[data-v-spin-waapi]{animation:none!important;}
.v-tape-reel{will-change:transform;}
.v-tape-reel:not([data-v-spin-waapi]){animation:v-media-turn 7s linear infinite;animation-play-state:paused;}
.v-tape-reel:last-child:not([data-v-spin-waapi]){animation-duration:9s;}
#v-cassette-view[data-playing="true"] .v-tape-reel:not([data-v-spin-waapi]){animation-play-state:running;}
.v-tape-reel::before{content:"";position:absolute;inset:-9px;border-radius:50%;border:1px dashed rgba(255,255,255,.16);}
.v-tape{--p:0;transform:perspective(1000px) rotateX(5deg) rotateY(-7deg);transition:transform .6s var(--v-ease),box-shadow .6s;box-shadow:inset 0 1px 0 #ffffff18,0 30px 40px -24px #000,0 0 0 1px #00000066;}
.v-tape:hover{transform:perspective(1000px) rotateX(0) rotateY(0);}
#v-cassette-view[data-playing="true"] .v-tape{box-shadow:inset 0 1px 0 #ffffff18,0 30px 50px -24px rgba(var(--v-a-rgb),.35),0 0 0 1px #00000066;}
.v-tape-glass{background:radial-gradient(circle at -20% 50%,#4c3c30 0 calc(66% - var(--p)*30%),transparent calc(68% - var(--p)*30%)),radial-gradient(circle at 120% 50%,#4c3c30 0 calc(36% + var(--p)*30%),#151517 calc(38% + var(--p)*30%));}
#v-cassette-view .v-tape{animation:v-tape-in .7s var(--v-ease) both;}
#v-cassette-view .v-cassette-copy{animation:v-tape-in .7s var(--v-ease) .08s both;}
@keyframes v-tape-in{from{opacity:0;translate:0 26px;}}
.v-eq{display:flex;align-items:center;gap:3px;height:34px;margin:0 0 18px;max-width:440px;}
.v-eq i{flex:1;max-width:6px;height:var(--h,16px);border-radius:3px;background:rgba(255,255,255,.18);transition:background .35s;}
.v-eq i[data-on]{background:rgb(var(--v-a-rgb));}
#v-cassette-view[data-playing="true"] .v-eq i{animation:v-eq calc(.6s + var(--n)*.031s) ease-in-out calc(var(--n)*-.11s) infinite alternate;}
@keyframes v-eq{from{transform:scaleY(.4);}to{transform:scaleY(1);}}
html[data-v-motion="off"] :is(.v-eq i,#v-cassette-view .v-tape,#v-cassette-view .v-cassette-copy,.v-m-record .v-cd,.v-tape-reel){animation:none!important;}
html[data-v-motion="off"] .v-tape{transform:none;}
@media(prefers-reduced-motion:reduce){.v-eq i,#v-cassette-view .v-tape,#v-cassette-view .v-cassette-copy{animation:none!important;}.v-tape{transform:none;}
 html:not([data-v-motion="on"]) .v-m-record .v-cd,html:not([data-v-motion="on"]) .v-tape-reel{animation:none!important;}}

/* -- Music page: carbon glass + cover-flow reflections -- */
html[data-v-ready] [data-music-view] .music-home-feature{background:linear-gradient(135deg,rgba(255,255,255,.07),rgba(255,255,255,.015) 55%),rgba(var(--v-bg-rgb),.6)!important;border:1px solid var(--v-rim)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 30px 60px -40px #000!important;-webkit-backdrop-filter:blur(22px) saturate(1.25);backdrop-filter:blur(22px) saturate(1.25);}
html[data-v-ready] [data-music-view] :is(.music-feature-choice,.music-home-local,.music-home-services>button){background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02))!important;border:1px solid var(--v-hair)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.06)!important;}
html[data-v-ready] [data-music-view] .music-feature-choice{transition:transform .45s var(--v-ease),background .2s,box-shadow .2s;}
html[data-v-ready] [data-music-view] .music-feature-choice:hover{transform:translateY(-3px);}
html[data-v-ready] [data-music-view] .music-feature-choice[data-selected="true"]{box-shadow:inset 0 0 0 1px rgba(var(--v-a-rgb),.55),0 18px 36px -24px rgba(var(--v-a-rgb),.5)!important;}
html[data-v-ready] [data-music-view] .music-navigation{border-bottom:1px solid var(--v-hair);}
html[data-v-ready] [data-music-view] .music-navigation [role="tab"][aria-selected="true"]{box-shadow:inset 0 -2px 0 rgb(var(--v-a-rgb));}
html[data-v-ready] [data-music-view] .music-collection-play{box-shadow:0 10px 30px -10px rgba(var(--v-a-rgb),.55)!important;}
[data-music-view] img[data-v-art]{border-radius:10px;transform:perspective(900px) rotateY(0) translateZ(0);transition:transform .5s var(--v-ease),box-shadow .5s;box-shadow:0 14px 26px -14px #000c,inset 0 0 0 1px rgba(255,255,255,.08);margin-bottom:30px;-webkit-box-reflect:below 3px linear-gradient(transparent 62%,rgba(255,255,255,.2));}
:is(button,a,[role="button"]):hover>img[data-v-art],:is(button,a,[role="button"]):focus-visible>img[data-v-art],:is(button,a,[role="button"]):hover img[data-v-art],:is(button,a,[role="button"]):focus-visible img[data-v-art]{transform:perspective(900px) rotateY(-9deg) translateY(-6px) translateZ(16px);box-shadow:-14px 20px 30px -14px #000d,0 0 0 1px rgba(255,255,255,.14);}
html[data-v-motion="off"] [data-music-view] img[data-v-art]{transform:none!important;transition:none;}
@media(prefers-reduced-motion:reduce){[data-music-view] img[data-v-art]{transform:none!important;transition:none;}}

/* -- Manga: physical books -- */
html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage]::before{inset:3px 1px 3px 8px;background:linear-gradient(90deg,#8f846e 0,#e8e1d0 7%,#f2ecdf 38%,#e4dcc9 100%),repeating-linear-gradient(0deg,#d2c9b6 0 1px,#efe9db 1px 2px);box-shadow:inset 6px 0 9px -7px #4d4135,0 1px 0 #fff3,3px 3px 6px #0006;}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-cover]{box-shadow:inset 10px 0 10px -10px #000c,0 0 0 1px #0009,2px 0 0 #1b1b1e,3px 0 0 #0008,0 3px 9px #000a!important;}
.v-book-gloss{position:absolute;inset:0;z-index:3;pointer-events:none;border-radius:inherit;background:linear-gradient(90deg,rgba(0,0,0,.55) 0,rgba(0,0,0,.12) 3.5%,rgba(255,255,255,.2) 5.2%,rgba(0,0,0,.28) 6.6%,transparent 10%),linear-gradient(115deg,rgba(255,255,255,.17) 0,rgba(255,255,255,.04) 28%,transparent 42%,rgba(255,255,255,.05) 78%,rgba(255,255,255,.12) 100%);box-shadow:inset 0 0 0 1px rgba(255,255,255,.1),inset 0 -14px 14px -14px #000a;}
html:not([data-v-page="manga"]) .v-book-gloss,html:not([data-v-books="on"]) .v-book-gloss,.v-book-plank{display:none;}
html[data-v-page="manga"][data-v-books="on"] .v-book-plank{display:block;position:relative;height:9px;margin:-4px -12px 14px;border-radius:2px;background:linear-gradient(180deg,#2b2b30,#141416 70%,#0c0c0e);box-shadow:inset 0 1px 0 rgba(255,255,255,.16),0 8px 14px -6px #000;pointer-events:none;}

/* -- Manga hub bar -- */
.v-hub{position:relative;z-index:5;display:flex;align-items:center;gap:14px;margin:22px 0 14px;padding:0;}
.v-hub-title{display:flex;align-items:baseline;gap:10px;flex:none;font:700 22px var(--v-display);letter-spacing:-.03em;}
.v-hub-title small{font:600 10px var(--v-text);letter-spacing:.2em;color:var(--color-ink-subtle);text-transform:uppercase;}
.v-hub-chips{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;min-width:0;flex:1;}
.v-hub-chips::-webkit-scrollbar{display:none;}
.v-hub button{appearance:none;flex:none;height:34px;padding:0 14px;border-radius:999px;border:1px solid var(--v-hair);background:rgba(255,255,255,.05);color:var(--color-ink-muted);font:550 12.5px var(--v-text);cursor:pointer;transition:background .2s,color .2s,border-color .2s;white-space:nowrap;}
.v-hub button:hover,.v-hub button[aria-current="true"]{background:rgba(255,255,255,.12);color:#fff;border-color:var(--v-rim);}
.v-hub button:focus-visible{outline:2px solid rgb(var(--v-a-rgb));outline-offset:2px;}
.v-hub-end{margin-left:auto;font:500 11px var(--v-text);color:var(--color-ink-subtle);flex:none;}
html:not([data-v-page="manga"]) .v-hub{display:none;}
html[data-v-page="manga"] main section h2{display:flex;align-items:center;gap:10px;}
html[data-v-page="manga"] main section h2::before{content:"";width:4px;height:1em;border-radius:2px;background:rgb(var(--v-a-rgb));opacity:.8;flex:none;}

/* -- QoL -- */
.v-top{position:fixed;right:22px;bottom:calc(var(--v-dock-h,0px) + 22px);z-index:120;width:44px;height:44px;border-radius:50%;border:1px solid var(--v-rim);background:rgba(var(--v-bg-rgb),.82);color:var(--color-ink);display:grid;place-items:center;cursor:pointer;opacity:0;pointer-events:none;transform:translateY(8px);transition:opacity .25s,transform .25s var(--v-ease);box-shadow:0 10px 24px -10px #000;}
html[data-v-scrolled="true"] .v-top{opacity:1;pointer-events:auto;transform:none;}
.v-top:hover{background:rgba(255,255,255,.14);}
.v-top:focus-visible{outline:2px solid rgb(var(--v-a-rgb));outline-offset:2px;}
.v-top svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;}
@media(prefers-reduced-motion:reduce){html main.flex-1.overflow-y-auto{scroll-behavior:auto!important;}.v-top{transition:none;}}
html[data-v-ready] :is(button,a,[role="button"],input,select):focus-visible{outline:2px solid rgba(var(--v-a-rgb),.85);outline-offset:2px;}

.v-book-spine{display:none;}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage]>.v-book-spine{display:block;}

/* VOID v21.4: the original Poster (including the loaded manga artwork)
   is always the visible FRONT of the book, never backface-culled. */
html[data-v-page="manga"][data-v-books="on"] [data-v-book-cover]{
  backface-visibility:visible!important;
  -webkit-backface-visibility:visible!important;
  transform-style:flat!important;
  z-index:5;
}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-cover] .harbor-poster-img{
  backface-visibility:visible!important;
  -webkit-backface-visibility:visible!important;
}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-cover][data-loaded] .harbor-poster-img{
  opacity:1!important;visibility:visible!important;
}
html[data-v-page="manga"][data-v-books="on"] [data-v-book]:focus-visible [data-v-book-cover]{
  transform:translateZ(9px) rotateY(-18deg)!important;
}
@media(hover:hover) and (pointer:fine){
 html[data-v-page="manga"][data-v-books="on"] [data-v-book]:hover [data-v-book-cover]{
  transform:translateZ(9px) rotateY(-18deg)!important;
 }
}
@media(hover:none),(pointer:coarse){
 html[data-v-page="manga"][data-v-books="on"] [data-v-book-cover]{
  transform:translateZ(5px)!important;
 }
}
html[data-v-motion="off"][data-v-page="manga"] [data-v-book-cover]{
  transform:none!important;
}
@media(prefers-reduced-motion:reduce){
 html[data-v-page="manga"][data-v-books="on"] [data-v-book-cover]{
  transform:none!important;
 }
}

/* VOID v21.1: page-flip leaves, hover focus, tidy edges */
.v-book-leaves{display:none;}
html[data-v-page="manga"][data-v-books="on"][data-v-flip="on"] [data-v-book-stage]>.v-book-leaves{display:block;position:absolute;inset:0;z-index:1;transform-style:preserve-3d;pointer-events:none;}
.v-book-leaves i{--a:calc(-48deg + var(--i)*11deg);--z:calc(2.6px - var(--i)*.5px);opacity:0;position:absolute;inset:5px 3px 5px 9px;border-radius:1px 6px 6px 1px;transform-origin:0 50%;transform:translateZ(var(--z)) rotateY(0deg);backface-visibility:visible;background:linear-gradient(#0000001a,#0000001a) 20% 12%/62% 34% no-repeat,linear-gradient(#0000001a,#0000001a) 20% 52%/62% 34% no-repeat,linear-gradient(90deg,#b5ab97,#ece5d4 9%,#f3eee1 60%,#ddd4c0);box-shadow:0 0 3px #0005;transition:transform .5s cubic-bezier(.2,.75,.2,1) calc(.1s + var(--i)*55ms),opacity .2s;}
@keyframes v-leaf-riffle{0%,100%{transform:translateZ(var(--z)) rotateY(var(--a));}50%{transform:translateZ(var(--z)) rotateY(calc(var(--a) - 16deg));}}
html[data-v-page="manga"][data-v-books="on"][data-v-flip="on"] [data-v-book]:focus-visible .v-book-leaves i{opacity:1;transform:translateZ(var(--z)) rotateY(var(--a));animation:v-leaf-riffle 1.5s ease-in-out calc(.8s + var(--i)*.14s) infinite;}
@media(hover:hover) and (pointer:fine){
 html[data-v-page="manga"][data-v-books="on"][data-v-flip="on"] [data-v-book]:hover .v-book-leaves i{opacity:1;transform:translateZ(var(--z)) rotateY(var(--a));animation:v-leaf-riffle 1.5s ease-in-out calc(.8s + var(--i)*.14s) infinite;}
 html[data-v-page="manga"][data-v-books="on"] .grid:has([data-v-book]:hover) [data-v-book]:not(:hover){opacity:.7;filter:saturate(.75);transition:opacity .3s,filter .3s;}
 html[data-v-page="manga"][data-v-books="on"] [data-v-book]:hover [data-v-book-stage]::after{box-shadow:0 8px 14px #000a;}
}
@media(hover:none),(pointer:coarse){.v-book-leaves{display:none!important;}}
html[data-v-motion="off"] .v-book-leaves,html[data-v-flip="off"] .v-book-leaves{display:none!important;}
@media(prefers-reduced-motion:reduce){.v-book-leaves i{animation:none!important;transition:none!important;}}


/* VOID v21.6: The native Manga Collections CTA uses three remote CoverImg
   thumbnails in its decorative icon. When they fail, Chromium shows three
   broken-image placeholders. Keep the native CTA and its navigation but paint
   its decorative covers locally, requiring zero image requests. */
html[data-v-page="manga"] main button:has(> span.relative.grid.h-12.w-16)
  > span.relative.grid.h-12.w-16{
  isolation:isolate;
}
html[data-v-page="manga"] main button:has(> span.relative.grid.h-12.w-16)
  > span.relative.grid.h-12.w-16 img{
  display:none!important;
}
html[data-v-page="manga"] main button:has(> span.relative.grid.h-12.w-16)
  > span.relative.grid.h-12.w-16 > span{
  box-shadow:inset 2px 0 0 rgba(0,0,0,.38),inset 0 0 0 1px rgba(255,255,255,.12),0 3px 8px #0008!important;
  border:1px solid rgba(255,255,255,.13);
  overflow:hidden;
}
html[data-v-page="manga"] main button:has(> span.relative.grid.h-12.w-16)
  > span.relative.grid.h-12.w-16 > span:nth-child(1){
  background:linear-gradient(155deg,#7793a8,#2d405a 53%,#172139)!important;
}
html[data-v-page="manga"] main button:has(> span.relative.grid.h-12.w-16)
  > span.relative.grid.h-12.w-16 > span:nth-child(2){
  background:linear-gradient(150deg,#957b81,#5a435d 48%,#24213c)!important;
}
html[data-v-page="manga"] main button:has(> span.relative.grid.h-12.w-16)
  > span.relative.grid.h-12.w-16 > span:nth-child(3){
  background:linear-gradient(155deg,#b9b9c7,#747a9a 45%,#393952)!important;
}
html[data-v-page="manga"] main button:has(> span.relative.grid.h-12.w-16)
  > span.relative.grid.h-12.w-16 > span::before{
  content:"";
  position:absolute;
  inset:6px 5px 10px;
  border-top:1px solid rgba(255,255,255,.65);
  border-bottom:1px solid rgba(255,255,255,.34);
  background:linear-gradient(to bottom,transparent 26%,rgba(255,255,255,.42) 27% 29%,transparent 30% 38%,rgba(255,255,255,.24) 39% 40%,transparent 41%);
  pointer-events:none;
}
html[data-v-page="manga"] main button:has(> span.relative.grid.h-12.w-16)
  > span.relative.grid.h-12.w-16 > span:nth-child(3)::after{
  content:"✦";
  position:absolute;
  left:0;right:0;bottom:3px;
  font:700 8px/1 Georgia,serif;
  color:rgba(255,255,255,.88);
  text-align:center;
  pointer-events:none;
}

/* VOID v21.5: physical tape reels inspired by G1NYU/cassette/src/index.css.
   Deliberate continuous rotation while the cassette is visible, just as in the
   standalone CSS cassette. The three bright, fixed spokes make rotation visible. */
#v-cassette-view .v-tape-window{
  background:linear-gradient(125deg,#171719,#343338 50%,#151518);
  border-color:#19191b;
  box-shadow:inset 0 2px 9px #000a,inset 0 0 0 1px #7773;
}
#v-cassette-view .v-tape-reel{
  display:flex;align-items:center;justify-content:center;
  position:relative;flex-shrink:0;
  border:3px solid #c4c0b5;
  background:radial-gradient(circle,#252428 0 19%,#aaa69c 20% 25%,#272629 26% 58%,#716b61 59% 63%,#18181a 64%);
  box-shadow:0 0 0 3px #0b0b0d,inset 0 0 0 2px #504e49;
  transform:rotate(0deg);
  will-change:transform;
}
#v-cassette-view .v-tape-reel:not([data-v-motor]){
  animation:v-tape-rotate 6s linear infinite reverse!important;
  animation-play-state:paused!important;
}
#v-cassette-view .v-tape-reel-right:not([data-v-motor]){
  animation-duration:8s!important;
}
#v-cassette-view[data-playing="true"] .v-tape-reel:not([data-v-motor]){
  animation-play-state:running!important;
}
#v-cassette-view .v-tape-reel[data-v-motor],
.v-m-record .v-cd[data-v-motor]{
  animation:none!important;
  animation-play-state:paused!important;
}
#v-cassette-view .v-tape-notch{
  position:absolute;top:calc(50% - 6%);left:5%;width:90%;height:12%;
  border-radius:3px;
  background:linear-gradient(90deg,#ded8cb 0 14%,transparent 16% 84%,#ded8cb 86% 100%);
  filter:drop-shadow(0 0 1px #111a);
  pointer-events:none;
}
#v-cassette-view .v-tape-notch-1{transform:rotate(0deg)}
#v-cassette-view .v-tape-notch-2{transform:rotate(60deg)}
#v-cassette-view .v-tape-notch-3{transform:rotate(-60deg)}
#v-cassette-view .v-tape-reel::after{
  content:"";inset:41%;z-index:2;border-radius:50%;
  background:radial-gradient(circle at 38% 32%,#77736c,#29282b 65%,#0e0e10);
  border:1px solid #ccc7bb;
  box-shadow:0 0 0 2px #1b1a1b;
}
#v-cassette-view .v-tape-reel::before{
  content:"";position:absolute;inset:5% auto auto 46%;width:9%;height:9%;
  border:0;border-radius:50%;background:#d4cdc0;
  box-shadow:0 0 0 1px #0009;z-index:3;
}
@keyframes v-tape-rotate{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
html[data-v-motion="off"] #v-cassette-view .v-tape-reel{
  animation:none!important;transform:none!important;
}
@media(prefers-reduced-motion:reduce){
 html:not([data-v-motion="on"]) #v-cassette-view .v-tape-reel{animation:none!important;transform:none!important;}
}

/* VOID v23.0 — actual magnetic tape packs, not just two spinning discs.
   Pack radii are set from the playing track's position by JS; the visible
   radial layers stay *behind* the three reel spokes. */
#v-cassette-view .v-tape-reel .v-tape-pack {
  position:absolute;
  left:50%;top:50%;
  width:var(--v-pack-size,60%);
  height:var(--v-pack-size,60%);
  aspect-ratio:1;
  border-radius:50%;
  transform:translate(-50%,-50%);
  background:
    radial-gradient(circle at center, transparent 0 17%, #120d0c 17% 20%,transparent 21%),
    repeating-radial-gradient(circle at center, #453124 0 2px, #74543c 2px 2.7px,#301f1b 2.7px 4px);
  border:1px solid #91704c;
  box-shadow:inset 0 0 5px #080607,0 0 2px #14100e;
  z-index:0;
  pointer-events:none;
  box-sizing:border-box;
  transition:width .6s linear,height .6s linear;
}
#v-cassette-view .v-tape-reel .v-tape-notch {z-index:1;}
#v-cassette-view .v-tape-window::after {
  content:"";position:absolute;left:18%;right:18%;bottom:8%;height:2px;
  background:linear-gradient(to right,transparent,#7a5234 16%,#ad8052 50%,#7a5234 84%,transparent);
  opacity:.62;pointer-events:none;z-index:0;
}
html[data-v-motion="off"] #v-cassette-view .v-tape-reel .v-tape-pack {transition:none;}
@media(prefers-reduced-motion:reduce) {
 html:not([data-v-motion="on"]) #v-cassette-view .v-tape-reel .v-tape-pack {transition:none;}
}

/* VOID v21.5: use the actual Harbor poster as the front face at all times.
   Previous full-size fake leaves were being painted in front of the real cover.
   The new narrow animated page edges sit OUTSIDE its right edge instead. */
html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage] > [data-v-book-cover]{
  position:relative;
  z-index:20!important;
  backface-visibility:visible!important;
  -webkit-backface-visibility:visible!important;
  transform:translateZ(24px) rotateY(0deg)!important;
  transform-origin:0 50%;
  transition:transform .45s cubic-bezier(.16,1,.3,1)!important;
}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage] > [data-v-book-cover][data-loaded] .harbor-poster-img{
  opacity:1!important;
  visibility:visible!important;
  backface-visibility:visible!important;
  -webkit-backface-visibility:visible!important;
}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage] > .v-book-spine{
  z-index:24!important;
  transform:translateZ(27px)!important;
}
html[data-v-page="manga"][data-v-books="on"] [data-v-book-stage] > :is([role="button"],span.absolute,div.absolute){
  z-index:40!important;
}
html[data-v-page="manga"][data-v-books="on"][data-v-flip="on"] [data-v-book-stage] > .v-book-leaves{
  display:block;
  position:absolute;
  top:2%;bottom:2%;left:auto;right:-9px;width:22px;
  transform:translateZ(8px);
  z-index:7!important;
  pointer-events:none;
}
html[data-v-page="manga"][data-v-books="on"][data-v-flip="on"] .v-book-leaves i{
  inset:0;
  width:100%;height:100%;
  transform-origin:left 50%;
  background:repeating-linear-gradient(90deg,#dfd7c5 0 1.5px,#eee8dc 1.5px 3px);
  border:1px solid #b8af9c;
  border-radius:0 4px 4px 0;
  opacity:.8;
  animation:none;
  transform:translateX(0) rotateY(0deg);
}
html[data-v-page="manga"][data-v-books="on"][data-v-flip="on"] .v-book-leaves i:nth-child(1){--v-fan:1}
html[data-v-page="manga"][data-v-books="on"][data-v-flip="on"] .v-book-leaves i:nth-child(2){--v-fan:2}
html[data-v-page="manga"][data-v-books="on"][data-v-flip="on"] .v-book-leaves i:nth-child(3){--v-fan:3}
html[data-v-page="manga"][data-v-books="on"][data-v-flip="on"] .v-book-leaves i:nth-child(4){--v-fan:4}
@media(hover:hover) and (pointer:fine){
 html[data-v-page="manga"][data-v-books="on"] [data-v-book]:hover [data-v-book-stage] > [data-v-book-cover]{
  transform:translateZ(24px) rotateY(-4deg)!important;
 }
 html[data-v-page="manga"][data-v-books="on"][data-v-flip="on"] [data-v-book]:hover .v-book-leaves i{
  animation:v-v215-page-edge 1.8s ease-in-out calc(var(--v-fan)*-.13s) infinite alternate!important;
  opacity:.94;
 }
}
html[data-v-page="manga"][data-v-books="on"] [data-v-book]:focus-visible [data-v-book-stage] > [data-v-book-cover]{
 transform:translateZ(24px) rotateY(-4deg)!important;
}
html[data-v-page="manga"][data-v-books="on"][data-v-flip="on"] [data-v-book]:focus-visible .v-book-leaves i{
 animation:v-v215-page-edge 1.8s ease-in-out calc(var(--v-fan)*-.13s) infinite alternate!important;
 opacity:.94;
}
@keyframes v-v215-page-edge{
  0%{transform:translateX(0) rotateY(0deg)}
  55%{transform:translateX(calc(var(--v-fan)*1.5px)) rotateY(-32deg)}
  100%{transform:translateX(calc(var(--v-fan)*2px)) rotateY(-8deg)}
}
html[data-v-motion="off"] [data-v-book-stage] > [data-v-book-cover],
html[data-v-motion="off"] .v-book-leaves i{animation:none!important;transform:none!important;transition:none!important;}
@media(prefers-reduced-motion:reduce){
 html[data-v-page="manga"] [data-v-book-stage] > [data-v-book-cover]{transform:none!important;transition:none!important;}
 html[data-v-page="manga"] .v-book-leaves i{animation:none!important;transition:none!important;}
}


/* ===== VOID v22.1: reachable CD opener with a nearly hidden disc ===== */
/* 40px invisible click area above the player; the disc itself is translated
   vertically using top, NOT transform (which the rotation motor owns). */
html[data-v-ready] [data-music-dock][data-v-m-deck] .v-m-record{
  top:-40px!important;
  height:40px!important;
  overflow:hidden;
  transition:filter .25s ease;
  z-index:5;
}
html[data-v-ready] [data-music-dock][data-v-m-deck] .v-m-record .v-cd,
html[data-v-ready] [data-music-dock][data-v-m-deck] .v-m-record::after{
  top:33px;
  transition:top .34s var(--v-ease);
}
html[data-v-ready] [data-music-dock][data-v-m-deck][data-v-m-playing="true"] .v-m-record .v-cd,
html[data-v-ready] [data-music-dock][data-v-m-deck][data-v-m-playing="true"] .v-m-record::after{
  top:8px;
}
html[data-v-ready] [data-music-dock][data-v-m-deck]:not([data-v-m-playing="true"]) .v-m-record:is(:hover,:focus-visible) .v-cd,
html[data-v-ready] [data-music-dock][data-v-m-deck]:not([data-v-m-playing="true"]) .v-m-record:is(:hover,:focus-visible)::after{
  top:20px;
}
@media(max-width:699px){
 html[data-v-ready] [data-music-dock][data-v-m-deck] .v-m-record .v-cd,
 html[data-v-ready] [data-music-dock][data-v-m-deck] .v-m-record::after{top:34px;}
 html[data-v-ready] [data-music-dock][data-v-m-deck][data-v-m-playing="true"] .v-m-record .v-cd,
 html[data-v-ready] [data-music-dock][data-v-m-deck][data-v-m-playing="true"] .v-m-record::after{top:12px;}
 html[data-v-ready] [data-music-dock][data-v-m-deck]:not([data-v-m-playing="true"]) .v-m-record:is(:hover,:focus-visible) .v-cd,
 html[data-v-ready] [data-music-dock][data-v-m-deck]:not([data-v-m-playing="true"]) .v-m-record:is(:hover,:focus-visible)::after{top:24px;}
}
/* Restore Harbor's rounded-rectangle chapter controls, not pill buttons.
   Manga inherits a blanket radius override earlier in this theme; these
   rules also catch native grid chapter cards when switching list/grid view. */
html[data-v-page="manga"] main button[class*="min-h-[64px]"][class*="rounded-xl"],
html[data-v-page="manga"] main button[class*="rounded-xl"][class*="border-edge-soft"]{
  border-radius:12px!important;
}
/* Ebook chapters and volume selectors retain a consistent 10–12px corner,
   including Show More chapters, which Harbor normally makes pill-shaped. */
html[data-v-page="ebook"] main button[class*="rounded-full"][class*="bg-surface/60"][class*="border-edge-soft"],
html[data-v-page="ebook"] main button[class*="min-h-[68px]"][class*="rounded-xl"],
html[data-v-page="ebook"] main button[class*="min-h-[64px]"][class*="rounded-lg"]{
  border-radius:12px!important;
}

/* VOID FINAL: the compositor owns spindle motion. Keep idle layers
   unpromoted to save graphics memory on low-power devices. */
html[data-v-ready] .v-m-record .v-cd:not([data-v-motor]),
html[data-v-ready] #v-cassette-view .v-tape-reel:not([data-v-motor]){
  will-change:auto;
}

/* VOID v22.2 — Visualizer clearance / manga hover polish
   Harbor mounts Miku at inline-start:6px, width:189px (149px on narrow
   docks). The peeking CD was also inline-start. Move only our opener to
   inline-end while preserving the 40px above-dock click surface, animation
   motor, idle peek and expanded-player click handler. */
html[data-v-ready] [data-music-dock][data-v-m-deck] > .v-m-record {
  inset-inline-start:auto!important;
  inset-inline-end:58px!important;
}
@media (max-width:699px) {
  html[data-v-ready] [data-music-dock][data-v-m-deck] > .v-m-record {
    inset-inline-end:36px!important;
  }
}
/* The decorative gloss creates a bright streak as the hardcover tilts;
   Harbor adds an abrupt accent border via .harbor-card-ring::after on hover.
   Remove only these lights, not the original artwork or page-edge animation. */
html[data-v-page="manga"][data-v-books="on"] [data-v-book] .v-book-gloss {
  display:none!important;
}
html[data-v-page="manga"][data-v-books="on"] [data-v-book] .harbor-card-ring::after {
  content:none!important;
  box-shadow:none!important;
  animation:none!important;
}


/* ===== VOID v23.1: Cassette workbench ===== */
html[data-v-ready] [data-music-dock][data-v-m-deck] [data-v-m-column="transport"] {
  position:relative!important;z-index:9!important;isolation:isolate;
  pointer-events:auto!important;
}
html[data-v-ready] [data-music-dock][data-v-m-deck] [data-v-m-column="transport"] > .music-dock-play {
  width:54px!important;height:54px!important;min-width:54px!important;
  cursor:pointer!important;touch-action:manipulation;position:relative!important;z-index:2;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.09),0 0 0 1px rgba(var(--v-a-rgb),.12)!important;
}
html[data-v-ready] [data-music-dock][data-v-m-deck] [data-v-m-column="transport"] > .music-dock-play:disabled {
  cursor:wait!important;opacity:.6!important;
}
html[data-v-ready] [data-music-dock][data-v-m-deck] .music-dock-seek {
  pointer-events:auto;z-index:6!important;
}
html[data-v-ready] [data-music-dock][data-v-m-deck] .music-dock-seek input {cursor:pointer;}

#v-cassette-view .v-cassette-layout {min-height:0!important;align-items:center;gap:clamp(24px,4vw,64px);}
#v-cassette-view .v-cassette-copy {display:flex;flex-direction:column;min-width:0;max-width:100%;gap:0;}
#v-cassette-view .v-cassette-copy .v-cassette-title {
  display:block;min-width:0;max-width:100%;white-space:nowrap!important;
  overflow:hidden!important;text-overflow:ellipsis!important;overflow-wrap:normal!important;
  word-break:normal!important;line-height:1.38!important;margin:8px 0!important;
  font-size:clamp(18px,3.2vw,45px);padding-block:0!important;
}
#v-cassette-view .v-cassette-copy .v-cassette-artist {
  display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  margin:0 0 14px!important;
}
#v-cassette-view .v-cassette-cover {width:60px;height:60px;flex:none;}
#v-cassette-view .v-cassette-topline {display:flex;align-items:center;gap:14px;min-width:0;}
#v-cassette-view .v-cassette-topline .v-cassette-tag {letter-spacing:.14em;}
#v-cassette-view .v-eq {margin:8px 0 20px;min-height:33px;}
#v-cassette-view .v-cassette-workbench {
  padding:18px 20px 16px;border:1px solid var(--v-rim);border-radius:16px;
  background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.012) 72%);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.045);
  min-width:0;
}
#v-cassette-view .v-cassette-status-line {display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:14px;}
#v-cassette-view .v-cassette-state {display:inline-flex;align-items:center;gap:8px;font:650 11px/1.4 var(--v-text);letter-spacing:.13em;}
#v-cassette-view .v-cassette-state:before {content:"";width:6px;height:6px;border-radius:100%;background:#717179;box-shadow:0 0 0 3px #71717914;}
#v-cassette-view[data-playing="true"] .v-cassette-state:before {background:#8fd1a9;box-shadow:0 0 0 3px #8fd1a920;}
#v-cassette-view .v-cassette-format {font:500 10px/1.4 var(--v-text);letter-spacing:.1em;color:var(--color-ink-subtle);}
#v-cassette-view .v-cassette-time {font:550 11px/1.3 var(--v-text);letter-spacing:.04em;color:var(--color-ink-muted);font-variant-numeric:tabular-nums;white-space:nowrap;}
#v-cassette-view .v-cassette-progress {display:block;width:100%;height:26px;margin:0;accent-color:rgb(var(--v-a-rgb));cursor:pointer;}
#v-cassette-view .v-cassette-progress:disabled{cursor:wait;opacity:.55;}
#v-cassette-view .v-cassette-times{display:flex;justify-content:space-between;margin-top:0;font:500 11px/1.4 var(--v-text);font-variant-numeric:tabular-nums;color:var(--color-ink-muted);}
#v-cassette-view .v-cassette-controls{display:flex;align-items:center;justify-content:center;gap:10px;margin:12px 0 10px;}
#v-cassette-view .v-cassette-controls button{
  appearance:none;display:grid;place-items:center;cursor:pointer;color:var(--color-ink);
  border:1px solid var(--v-rim);background:rgba(255,255,255,.055);
  border-radius:12px;width:52px;height:48px;min-width:48px;padding:0;
  transition:background .16s ease,transform .16s ease;
}
#v-cassette-view .v-cassette-controls button:hover:not(:disabled){background:rgba(var(--v-a-rgb),.16);transform:translateY(-1px);}
#v-cassette-view .v-cassette-controls button:active:not(:disabled){transform:scale(.96);}
#v-cassette-view .v-cassette-controls button:disabled{opacity:.35;cursor:not-allowed;}
#v-cassette-view .v-cassette-controls .v-cassette-play{width:72px;height:60px;border-radius:15px;background:rgba(var(--v-a-rgb),.16);color:rgb(var(--v-a-rgb));}
#v-cassette-view .v-cassette-controls .v-cassette-play svg {width:24px;height:24px;}
#v-cassette-view .v-cassette-extra{display:flex;gap:8px;justify-content:center;align-items:center;flex-wrap:wrap;margin-top:4px;}
#v-cassette-view .v-cassette-extra button{
  border:1px solid var(--v-rim);border-radius:8px;background:transparent;color:var(--color-ink-muted);
  font:550 11px/1.3 var(--v-text);padding:8px 10px;cursor:pointer;min-width:72px;
}
#v-cassette-view .v-cassette-extra button[aria-pressed="true"] {background:rgba(var(--v-a-rgb),.13);color:rgb(var(--v-a-rgb));}
#v-cassette-view .v-cassette-extra button:disabled {opacity:.4;cursor:not-allowed;}
#v-cassette-view .v-cassette-keyhint{text-align:center;color:var(--color-ink-subtle);font:500 10px/1.4 var(--v-text);margin:12px 0 0;letter-spacing:.02em;}
#v-cassette-view .v-cassette-keyhint kbd{font:inherit;border:1px solid var(--v-rim);padding:2px 5px;border-radius:4px;color:var(--color-ink-muted);}
/* The ribbon runs across the real reel window and through a visible capstan / read head. */
#v-cassette-view .v-tape-window{background:linear-gradient(180deg,#111114,#28262a 46%,#171518);}
#v-cassette-view .v-tape-glass{
  position:relative;z-index:0;background:linear-gradient(90deg,#1c1919 0%,#44372d 20%,#7d5b40 49%,#44382d 78%,#171516 100%);
  border-color:#181717;box-shadow:inset 0 0 12px #100b0b;
}
#v-cassette-view .v-tape-run{position:absolute;inset:0;width:100%;height:100%;z-index:2;pointer-events:none;overflow:visible;}
#v-cassette-view .v-tape-run .v-tape-path{fill:none;stroke:#b48b64;stroke-width:6;stroke-linecap:round;opacity:.86;filter:drop-shadow(0 1px 1px #000);}
#v-cassette-view .v-tape-run .v-tape-motion{fill:none;stroke:#e0b38a;stroke-width:1.3;opacity:.62;stroke-dasharray:10 15;animation:v-tape-travel 2.4s linear infinite;animation-play-state:paused;}
#v-cassette-view[data-playing="true"] .v-tape-motion{animation-play-state:running;}
#v-cassette-view .v-tape-run .v-tape-guide{fill:#585154;stroke:#b8b2a6;stroke-width:3;}
#v-cassette-view .v-tape-run .v-tape-head{fill:#797a7d;stroke:#d0c9be;stroke-width:3;}
#v-cassette-view .v-tape-run .v-tape-head-gap{stroke:#171719;stroke-width:2;}
#v-cassette-view .v-tape-window::after{content:none!important;}
@keyframes v-tape-travel{to{stroke-dashoffset:-100;}}
#v-cassette-view .v-tape-window .v-tape-reel{z-index:3;}
#v-cassette-view .v-tape-window .v-tape-glass{z-index:1;}
#v-cassette-view .v-tape-scan{position:absolute;left:38%;right:38%;bottom:8%;z-index:5;
  font:700 clamp(7px,.8vw,10px)/1.2 monospace;color:#d8c7ac;text-align:center;letter-spacing:.1em;
  text-shadow:0 1px 2px #000;pointer-events:none;}
html[data-v-motion="off"] #v-cassette-view .v-tape-run .v-tape-motion{animation:none!important;}
@media(prefers-reduced-motion:reduce){
  html:not([data-v-motion="on"]) #v-cassette-view .v-tape-run .v-tape-motion{animation:none!important;}
}
@media(max-width:850px){
  #v-cassette-view .v-cassette-layout{grid-template-columns:minmax(0,1fr)!important;gap:18px;align-content:start;}
  #v-cassette-view .v-tape{max-width:640px;margin:auto;}
  #v-cassette-view .v-cassette-copy{width:100%;max-width:640px;margin:auto;}
  #v-cassette-view .v-cassette-workbench{padding:14px;}
  #v-cassette-view .v-cassette-controls button{width:46px;height:44px;}
  #v-cassette-view .v-cassette-controls .v-cassette-play{width:64px;height:56px;}
}
@media(max-height:700px) and (min-width:851px){
  #v-cassette-view{padding-top:10px!important;padding-bottom:18px!important;}
  #v-cassette-view .v-cassette-head{margin-bottom:8px;}
  #v-cassette-view .v-cassette-workbench{padding:12px 16px;}
  #v-cassette-view .v-eq{margin:4px 0 8px;}
}

#v-cassette-view .v-cassette-volume-row{display:flex;align-items:center;gap:12px;border-top:1px solid var(--v-rim);margin-top:13px;padding-top:13px;}
#v-cassette-view .v-cassette-volume-row label{font:650 10px/1.4 var(--v-text);letter-spacing:.13em;color:var(--color-ink-muted);white-space:nowrap;}
#v-cassette-view .v-cassette-volume-row .v-cassette-volume{flex:1;min-width:0;height:22px;accent-color:rgb(var(--v-a-rgb));cursor:pointer;}
#v-cassette-view .v-cassette-volume-row .v-cassette-volume:disabled{cursor:default;opacity:.38;}
#v-cassette-view .v-cassette-volume-row output{min-width:42px;text-align:right;font:550 12px var(--v-text);color:var(--color-ink-muted);font-variant-numeric:tabular-nums;}


/* ===== VOID v23.2: full-height composed cassette deck ===== */
#v-cassette-view {
  display:flex!important;flex-direction:column!important;
  background:
    radial-gradient(ellipse 44% 43% at 29% 53%,rgba(var(--v-a-rgb),.048),transparent 90%),
    linear-gradient(180deg,rgba(255,255,255,.014),transparent 42%),
    rgb(var(--v-bg-rgb))!important;
  padding:clamp(16px,2.5vh,30px) clamp(24px,4.8vw,90px) clamp(25px,4vh,50px)!important;
  overflow-y:auto!important;
}
#v-cassette-view .v-cassette-head {width:100%;max-width:1380px!important;margin:0 auto!important;
  padding:0 0 17px;border-bottom:1px solid rgba(255,255,255,.055);flex:0 0 auto;}
#v-cassette-view .v-cassette-head span{font-size:11px!important;font-weight:700;letter-spacing:.16em!important;}
#v-cassette-view .v-cassette-close{font-weight:600;border-radius:999px!important;padding:0 19px!important;}
#v-cassette-view .v-cassette-layout {
  width:100%;max-width:1380px!important;min-height:0!important;flex:1 0 auto;
  grid-template-columns:minmax(0,1.15fr) minmax(0,1fr)!important;
  gap:clamp(28px,5vw,84px)!important;align-items:center!important;align-content:center;
  margin:0 auto!important;padding-block:32px!important;box-sizing:border-box;
}
#v-cassette-view .v-cassette-mechanics{width:100%;min-width:0;display:flex;flex-direction:column;gap:24px;}
#v-cassette-view .v-cassette-mechanics .v-tape {width:100%;max-width:680px;margin:0 auto;
  box-shadow:0 2px 0 #151518,0 32px 80px -34px #000,0 0 0 1px #000a!important;}
#v-cassette-view .v-cassette-copy{max-width:none!important;width:100%;gap:0;}
#v-cassette-view .v-cassette-topline {margin-bottom:15px;}
#v-cassette-view .v-cassette-cover {width:76px!important;height:76px!important;border-radius:10px!important;object-fit:cover;}
#v-cassette-view .v-cassette-tag {letter-spacing:.18em;font-size:11px;}
#v-cassette-view .v-cassette-title{font-size:clamp(30px,3.2vw,52px)!important;margin:0 0 5px!important;line-height:1.32!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;}
#v-cassette-view .v-cassette-artist{font-size:clamp(15px,1.3vw,19px)!important;margin:0 0 24px!important;white-space:nowrap!important;}
#v-cassette-view .v-eq{height:42px;margin:0 0 28px!important;max-width:none;}
#v-cassette-view .v-eq i{max-width:9px;border-radius:3px;opacity:.66;}
#v-cassette-view .v-cassette-workbench {max-width:none;padding:26px 27px 20px;
  border-radius:20px;background:linear-gradient(145deg,#19191caa,#0d0d0fb0);
  box-shadow:inset 0 1px 0 #ffffff12,0 18px 45px -30px #000;}
#v-cassette-view .v-cassette-controls{margin:16px 0 15px;gap:14px;}
#v-cassette-view .v-cassette-controls button{width:62px;height:56px;border-radius:15px;}
#v-cassette-view .v-cassette-controls .v-cassette-play{width:82px;height:66px;border-radius:18px;box-shadow:0 0 0 1px rgba(var(--v-a-rgb),.23);}
#v-cassette-view .v-cassette-extra button{min-width:80px;padding:9px 13px;}
#v-cassette-view .v-cassette-keyhint{margin-top:15px;padding-top:12px;border-top:1px solid #ffffff12;}
#v-cassette-view .v-deck-readout {display:flex;align-items:center;gap:9px;margin:18px 0 0;
  border-top:1px solid #ffffff14;padding-top:14px;min-width:0;flex-wrap:wrap;font:600 10px/1.5 var(--v-text);
  letter-spacing:.11em;color:var(--color-ink-subtle);}
#v-cassette-view .v-deck-readout strong {font-size:11px;letter-spacing:.02em;color:var(--color-ink-muted);margin-inline:4px auto;}
#v-cassette-view .v-deck-readout .v-deck-rate b{font-weight:700;color:var(--color-ink);font-variant-numeric:tabular-nums;}
/* Real source/take-up indicators, rather than decorative fake VU telemetry. */
#v-cassette-view .v-tape-readout {display:grid;grid-template-columns:1fr 1.25fr 1fr;gap:12px;
  border-top:1px solid #ffffff14;border-bottom:1px solid #ffffff10;
  padding:20px 0 18px;max-width:680px;width:100%;margin:0 auto;}
#v-cassette-view .v-tape-readout>div{display:flex;flex-direction:column;gap:6px;min-width:0;}
#v-cassette-view .v-tape-readout>div:last-child{text-align:right;align-items:flex-end;}
#v-cassette-view .v-tape-readout-center{text-align:center;align-items:center;}
#v-cassette-view .v-tape-readout span{font:700 10px/1.2 var(--v-text);letter-spacing:.12em;color:var(--color-ink-subtle);}
#v-cassette-view .v-tape-readout strong{font:650 clamp(17px,2vw,25px)/1.2 var(--v-text);color:var(--color-ink);font-variant-numeric:tabular-nums;white-space:nowrap;}
#v-cassette-view .v-tape-readout strong em{font-style:normal;color:var(--color-ink-subtle);font-size:.6em;font-weight:400;}
#v-cassette-view .v-tape-readout small{font:550 9px/1.3 var(--v-text);letter-spacing:.05em;color:var(--color-ink-subtle);}
#v-cassette-view .v-pack-rail{display:block;width:90%;height:3px;background:#ffffff18;border-radius:99px;overflow:hidden;}
#v-cassette-view .v-pack-rail b{display:block;height:100%;background:rgb(var(--v-a-rgb));border-radius:inherit;}
#v-cassette-view .v-pack-fill-left{width:100%;}#v-cassette-view .v-pack-fill-right{width:0%;}
/* Manz cassette reference: recessed trapezoid magnetic shield, four apertures and azimuth screw. */
#v-cassette-view .v-tape-bottom{height:17%;left:16%;right:16%;
  display:flex;justify-content:space-around;align-items:flex-end;gap:3%;
  padding:0 5% 3%;box-sizing:border-box;
  clip-path:polygon(5% 0,95% 0,100% 100%,0 100%);
  background:repeating-linear-gradient(180deg,#333338 0 3px,#202023 3px 6px);border-top:3px solid #151518;
  filter:drop-shadow(0 -2px 2px #000);}
#v-cassette-view .v-tape-bottom::before,#v-cassette-view .v-tape-bottom::after{content:none!important;}
#v-cassette-view .v-shield-hole{position:relative;display:block;flex:none;width:11%;height:36%;border-radius:40%;border:2px solid #101011;
  background:radial-gradient(ellipse,#080808 15%,#161619 80%);box-shadow:0 1px 0 #7773,inset 0 2px 3px #000;}
#v-cassette-view .v-shield-hole-2,#v-cassette-view .v-shield-hole-3{height:48%;transform:translateY(-22%);width:9%;}
#v-cassette-view .v-shield-head{width:14%;height:54%;border-radius:5px 5px 0 0;display:block;align-self:flex-end;
  background:linear-gradient(90deg,#1d1d20,#88827b 48%,#18181c 51%,#74716d 54%,#232327);
  border:2px solid #111;box-shadow:0 1px 5px #000,inset 0 0 0 1px #b1a69a55;}
#v-cassette-view .v-tape-run .v-tape-path{stroke:#5b3825!important;stroke-width:10!important;opacity:.96;}
#v-cassette-view .v-tape-run .v-tape-motion{stroke:#d2a174!important;stroke-width:1.8!important;opacity:.67;animation-duration:var(--v-tape-speed,2.4s)!important;}
#v-cassette-view .v-tape-run .v-tape-head {fill:#777a79;stroke:#d3c7b6;stroke-width:4;}
#v-cassette-view .v-tape-run .v-tape-guide{fill:#2a2a2d;stroke:#b4aea1;stroke-width:4;}
#v-cassette-view .v-tape-glass {overflow:hidden!important;position:relative;
  /* Restore the original progress-driven tape packs that v23.1 replaced with a static band. */
  background:
    radial-gradient(circle at -19% 50%,#65432f 0 calc(65% - var(--p,0)*37%),transparent calc(67% - var(--p,0)*37%)),
    radial-gradient(circle at 119% 50%,#835b3e 0 calc(32% + var(--p,0)*36%),#141214 calc(34% + var(--p,0)*36%))!important;
  box-shadow:inset 0 0 9px #0a0708,inset 0 1px 2px #c4a57a60!important;
}
#v-cassette-view .v-tape-glass:before{content:"";position:absolute;inset:0;pointer-events:none;
  background:repeating-radial-gradient(circle at -17% 50%,transparent 0 3px,#140b0918 4px 6px,transparent 7px 9px);opacity:.7;}
#v-cassette-view .v-tape-reel .v-tape-pack{
  background:radial-gradient(circle,transparent 0 20%,#120b09 21% 22%,transparent 23%),
    repeating-radial-gradient(circle,#543723 0 2px,#996f49 2px 3px,#321d15 3px 4px)!important;
  border-color:#b5895d!important;box-shadow:inset 0 0 3px #120b09,0 0 1px #d7a46b88!important;
}
@media(min-width:901px) and (max-height:860px){
 #v-cassette-view{padding-block:10px 14px!important;}
 #v-cassette-view .v-cassette-head{padding-bottom:6px;}
 #v-cassette-view .v-cassette-layout{padding-block:8px!important;}
 #v-cassette-view .v-cassette-topline{margin-bottom:6px;}
 #v-cassette-view .v-cassette-cover{width:56px!important;height:56px!important;}
 #v-cassette-view .v-cassette-title{font-size:clamp(26px,3vw,42px)!important;margin-bottom:0!important;}
 #v-cassette-view .v-cassette-artist{margin-bottom:8px!important;}
 #v-cassette-view .v-eq{height:28px!important;min-height:28px;margin:0 0 9px!important;}
 #v-cassette-view .v-cassette-workbench{padding:13px 17px 11px;}
 #v-cassette-view .v-cassette-status-line{margin-bottom:3px;}
 #v-cassette-view .v-cassette-controls{margin:6px 0 7px;}
 #v-cassette-view .v-cassette-controls button{height:43px;width:52px;}
 #v-cassette-view .v-cassette-controls .v-cassette-play{height:54px;width:68px;}
 #v-cassette-view .v-cassette-extra button{padding:6px 8px;}
 #v-cassette-view .v-cassette-volume-row{margin-top:6px;padding-top:7px;}
 #v-cassette-view .v-deck-readout{margin-top:6px;padding-top:6px;}
 #v-cassette-view .v-cassette-keyhint{margin-top:6px;padding-top:7px;}
 #v-cassette-view .v-cassette-mechanics{gap:12px;}
 #v-cassette-view .v-tape-readout{padding-block:9px;}
}

/* The real CD hit target covers every visible pixel of the disc, not a 32px strip. */
html[data-v-ready] [data-music-dock][data-v-m-deck] > .v-m-record {
  top:-76px!important;height:76px!important;width:var(--cd,112px)!important;
  inset-inline-start:auto!important;inset-inline-end:58px!important;
  overflow:hidden!important;pointer-events:auto!important;touch-action:manipulation!important;
  cursor:pointer!important;z-index:40!important;isolation:isolate;
}
html[data-v-ready] [data-music-dock][data-v-m-deck] > .v-m-record .v-cd{pointer-events:none!important;}
html[data-v-ready] [data-music-dock][data-v-m-deck] > .v-m-record:is(:hover,:focus-visible){filter:brightness(1.25) drop-shadow(0 -4px 13px rgba(var(--v-a-rgb),.38));}
@media (max-width:900px){
 #v-cassette-view .v-cassette-layout{grid-template-columns:minmax(0,1fr)!important;gap:24px!important;align-content:start!important;flex:0 0 auto!important;padding-block:24px!important;}
 #v-cassette-view .v-cassette-mechanics{max-width:620px;margin:auto;gap:16px;}
 #v-cassette-view .v-cassette-copy{max-width:620px!important;margin:auto;}
 #v-cassette-view .v-cassette-workbench{padding:19px 21px;}
 #v-cassette-view .v-tape-readout{padding-block:12px;}
 #v-cassette-view .v-cassette-title{font-size:clamp(26px,4vw,38px)!important;}
}
@media(max-width:699px){
 html[data-v-ready] [data-music-dock][data-v-m-deck] > .v-m-record{--cd:96px;top:-64px!important;height:64px!important;inset-inline-end:36px!important;}
 #v-cassette-view{padding:14px 18px 30px!important;}
 #v-cassette-view .v-cassette-head{gap:12px;}
 #v-cassette-view .v-cassette-head span{font-size:9px!important;}
 #v-cassette-view .v-cassette-layout{gap:20px!important;}
 #v-cassette-view .v-cassette-controls .v-cassette-play{width:70px;height:62px;}
 #v-cassette-view .v-tape-readout{gap:5px;}
 #v-cassette-view .v-tape-readout span{font-size:8px;}
 #v-cassette-view .v-tape-readout small{font-size:7px;}
}
@media(prefers-reduced-motion:reduce){
 #v-cassette-view .v-tape-readout *{transition:none!important;}
}


/* ===== VOID v23.3: CD is a body-level portal, never dock-clipped. =====
   The button is stationary and covers precisely the visible disc. Only the
   child .v-cd rotates. The button is above native music-dock hit layers. */
html[data-v-ready] body > button.v-m-record[data-v-cd-portal] {
  --cd:112px; --v-peek:60px;
  position:fixed!important;
  inset: auto 58px auto auto!important;
  bottom:calc(var(--v-dock-h,88px) + var(--harbor-viewport-bottom,0px) - 1px)!important;
  top:auto!important;
  left:auto!important;
  width:var(--cd)!important;
  height:var(--v-peek)!important;
  z-index:172!important;
  display:block!important;
  overflow:hidden!important;
  opacity:1!important;
  visibility:visible!important;
  padding:0!important;
  border:0!important;
  border-radius:0!important;
  background:transparent!important;
  box-shadow:none!important;
  cursor:pointer!important;
  touch-action:manipulation!important;
  pointer-events:auto!important;
  transform:none!important;
  filter:none!important;
  isolation:isolate;
  -webkit-tap-highlight-color:transparent;
  transition:height 180ms ease!important;
}
html[data-v-ready] body > button.v-m-record[data-v-cd-portal][data-v-floating-play="true"] { --v-peek:82px; }
html[data-v-ready] body > button.v-m-record[data-v-cd-portal]:is(:hover,:focus-visible) { --v-peek:92px; }
html[data-v-ready] body > button.v-m-record[data-v-cd-portal][data-v-dock-hidden="true"] { pointer-events:none!important;visibility:hidden!important; }
html[data-v-ready] body > button.v-m-record[data-v-cd-portal] .v-cd,
html[data-v-ready] body > button.v-m-record[data-v-cd-portal]::after {
  position:absolute!important;
  inset:0 auto auto 0!important;
  top:0!important;
  left:0!important;
  width:var(--cd)!important;
  height:var(--cd)!important;
  pointer-events:none!important;
  transition:none!important;
}
html[data-v-ready] body > button.v-m-record[data-v-cd-portal] .v-cd { display:block!important; border-radius:50%; }
html[data-v-ready] body > button.v-m-record[data-v-cd-portal] .v-cd img { pointer-events:none!important; }
@media(max-width:699px){
 html[data-v-ready] body > button.v-m-record[data-v-cd-portal]{--cd:96px;--v-peek:53px;right:36px!important;}
 html[data-v-ready] body > button.v-m-record[data-v-cd-portal][data-v-floating-play="true"]{--v-peek:72px;}
 html[data-v-ready] body > button.v-m-record[data-v-cd-portal]:is(:hover,:focus-visible){--v-peek:79px;}
}
/* Do not animate 30 individual equalizer DOM bars or a complex SVG stroke.
   Native playback and progress/reel physics remain untouched. */
#v-cassette-view .v-eq i{animation:none!important;transition:opacity 120ms linear!important;}
#v-cassette-view .v-tape-motion{animation:none!important;opacity:.45!important;filter:none!important;}
#v-cassette-view .v-tape-path{filter:none!important;}
#v-cassette-view .v-tape-glass{background:linear-gradient(90deg,#3c2b24,#181719 35%,#20191a 65%,#4d3629)!important;filter:none!important;}
#v-cassette-view .v-tape-glass:before{content:none!important;}
#v-cassette-view .v-tape-bottom{filter:none!important;}
#v-cassette-view .v-tape{filter:none!important;}
#v-cassette-view .v-tape-reel .v-tape-pack{
  background:repeating-radial-gradient(circle,#654830 0 3px,#9b744c 3px 4px,#4e321f 4px 5px)!important;
  filter:none!important;
}

/* VOID v23.4 — flattened native transport and music hub, performance-safe */
#v-cassette-view .v-cassette-workbench{
  padding:0!important;border:0!important;border-radius:0!important;background:none!important;
  box-shadow:none!important;backdrop-filter:none!important;
}
#v-cassette-view .v-cassette-controls{margin:16px 0 12px!important;gap:clamp(9px,1.5vw,24px)!important}
#v-cassette-view .v-cassette-controls button{
  border:0!important;border-radius:50%!important;background:transparent!important;
  width:54px;height:54px;box-shadow:none!important;
  transition:background-color .15s ease,color .15s ease,transform .15s ease;
}
#v-cassette-view .v-cassette-controls button:hover:not(:disabled){background:rgba(255,255,255,.075)!important;transform:none!important}
#v-cassette-view .v-cassette-controls button:active:not(:disabled){transform:scale(.93)!important}
#v-cassette-view .v-cassette-controls .v-cassette-play{
  width:70px;height:70px;border-radius:50%!important;
  background:rgb(var(--v-a-rgb))!important;color:rgb(var(--v-bg-rgb))!important;
  box-shadow:0 3px 18px rgba(0,0,0,.23)!important;
}
#v-cassette-view .v-cassette-controls .v-cassette-play:hover:not(:disabled){background:rgb(var(--v-a-rgb))!important;filter:brightness(1.08)}
#v-cassette-view .v-cassette-controls button:focus-visible,
#v-cassette-view .v-cassette-extra button:focus-visible {outline:2px solid rgb(var(--v-a-rgb));outline-offset:3px}
#v-cassette-view .v-cassette-extra button{border-radius:999px!important;background:transparent!important}
#v-cassette-view .v-cassette-extra button:hover:not(:disabled){background:rgba(255,255,255,.06)!important}
#v-cassette-view .v-cassette-volume-row{border-top:1px solid rgba(255,255,255,.055)!important}
#v-cassette-view .v-cassette-status-line{border:0!important}
@media(max-width:700px){#v-cassette-view .v-cassette-controls .v-cassette-play{width:60px;height:60px}}

/* Replace the catalog-first billboard (which ignores the passed 'recent' tracks)
   with a compact, dynamic desk. Native Music rows, tabs, provider buttons and
   playlists remain mounted and interactive; only the oversized billboard is hidden. */
html[data-v-ready] [data-music-view] .music-home-intro > .music-home-feature,
html[data-v-ready] [data-music-view] .music-home-intro > .music-feature-browse{
  display:none!important;
}
html[data-v-ready] [data-music-view] .music-home-intro{gap:14px!important}
html[data-v-ready] [data-music-view] .v-music-desk{
  display:grid;grid-template-columns:minmax(0,1.06fr) minmax(340px,.94fr);
  align-items:stretch;gap:clamp(16px,2vw,26px);border:1px solid var(--v-rim);
  background:linear-gradient(125deg,rgba(255,255,255,.036),rgba(255,255,255,.009) 65%),rgb(var(--v-bg-rgb));
  border-radius:22px;padding:clamp(23px,3.2vw,42px);isolation:isolate;
}
html[data-v-ready] [data-music-view] .v-music-desk-lead{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;min-width:0}
html[data-v-ready] [data-music-view] .v-music-eyebrow{font:700 10px/1.4 var(--v-text);color:var(--color-ink-subtle);letter-spacing:.24em}
html[data-v-ready] [data-music-view] .v-music-desk h2{
  font:750 clamp(26px,3.2vw,49px)/1.08 var(--v-display)!important;
  letter-spacing:-.042em;color:var(--color-ink);margin:13px 0 10px;max-width:12ch;
}
html[data-v-ready] [data-music-view] .v-music-desk-lead p{
  font:400 13px/1.6 var(--v-text);color:var(--color-ink-muted);margin:0;max-width:52ch;
}
html[data-v-ready] [data-music-view] .v-music-links{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}
html[data-v-ready] [data-music-view] .v-music-links button,
html[data-v-ready] [data-music-view] .v-music-now button{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--v-rim);
  border-radius:999px;padding:10px 15px;min-height:40px;
  color:var(--color-ink);background:rgba(255,255,255,.045);font:650 12px/1.2 var(--v-text);
  cursor:pointer;transition:background-color .15s ease,border-color .15s ease;
}
html[data-v-ready] [data-music-view] .v-music-links button:hover,
html[data-v-ready] [data-music-view] .v-music-now button:hover:not(:disabled){background:rgba(255,255,255,.11);border-color:rgba(255,255,255,.3)}
html[data-v-ready] [data-music-view] .v-music-links button:focus-visible,
html[data-v-ready] [data-music-view] .v-music-now button:focus-visible{outline:2px solid rgb(var(--v-a-rgb));outline-offset:2px}
html[data-v-ready] [data-music-view] .v-music-now{
  display:flex;flex-direction:column;justify-content:center;gap:17px;min-width:0;
  background:rgba(255,255,255,.032);border:1px solid rgba(255,255,255,.065);
  padding:clamp(18px,2vw,25px);border-radius:17px;
}
html[data-v-ready] [data-music-view] .v-music-now-info{display:flex;align-items:center;gap:15px;min-width:0}
html[data-v-ready] [data-music-view] .v-music-now-art{width:76px;height:76px;flex:none;border-radius:10px;
  object-fit:cover;background:radial-gradient(circle,#303034,#171719);border:1px solid rgba(255,255,255,.08)}
html[data-v-ready] [data-music-view] .v-music-now-art:not([src]){opacity:.5}
html[data-v-ready] [data-music-view] .v-music-now-lines{min-width:0;flex:1}
html[data-v-ready] [data-music-view] .v-music-now-state{font:650 10px/1.3 var(--v-text);letter-spacing:.14em;color:var(--color-ink-subtle)}
html[data-v-ready] [data-music-view] .v-music-now-title{font:720 clamp(16px,2vw,22px)/1.24 var(--v-display);margin:6px 0 4px;color:var(--color-ink);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
html[data-v-ready] [data-music-view] .v-music-now-artist{font:500 12px/1.4 var(--v-text);color:var(--color-ink-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
html[data-v-ready] [data-music-view] .v-music-now-progress{height:3px;border-radius:999px;background:rgba(255,255,255,.12);overflow:hidden}
html[data-v-ready] [data-music-view] .v-music-now-progress > span{display:block;height:100%;background:rgb(var(--v-a-rgb));width:0%;transform-origin:left center;transition:width .25s linear}
html[data-v-ready] [data-music-view] .v-music-now-actions{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
html[data-v-ready] [data-music-view] .v-music-now-actions button:first-child{background:rgb(var(--v-a-rgb));color:rgb(var(--v-bg-rgb));border-color:transparent}
html[data-v-ready] [data-music-view] .v-music-now-actions button:disabled{opacity:.45;cursor:not-allowed}
html[data-v-ready] [data-music-view] .music-home-local{margin-top:0!important}
html[data-v-ready] [data-music-view] .music-home-services{margin-top:0!important}
@media(max-width:900px){html[data-v-ready] [data-music-view] .v-music-desk{grid-template-columns:minmax(0,1fr)!important}}
@media(max-width:500px){html[data-v-ready] [data-music-view] .v-music-desk{padding:20px;border-radius:15px}html[data-v-ready] [data-music-view] .v-music-now-art{width:62px;height:62px}}
@media(prefers-reduced-motion:reduce){html[data-v-ready] [data-music-view] .v-music-desk *{transition:none!important}}

/* Optional GPU-saving mode. This avoids backdrop blur over a huge video hero.
   Physical-media interactions and the compositor-owned cassette motor remain. */
html[data-v-performance="on"] main [data-tv-hero-zone][data-scroll-anchor="hero"] .harbor-hero-stage::before{
  -webkit-backdrop-filter:none!important;backdrop-filter:none!important;
  -webkit-mask-image:none!important;mask-image:none!important;
  background:linear-gradient(to top,rgb(var(--v-bg-rgb)),transparent 82%)!important;
}
html[data-v-performance="on"] .v-logo::before,
html[data-v-performance="on"] .v-logo::after{animation:none!important}
html[data-v-performance="on"] :is(#v-rail,#v-panel,header [data-harbor-search]){
  -webkit-backdrop-filter:none!important;backdrop-filter:none!important;
}


/* v23.4.1 final touch-up: smoother cassette meter motion + column alignment */
#v-cassette-view .v-cassette-layout{align-items:end!important;}
#v-cassette-view .v-cassette-copy{
  display:flex!important;
  flex-direction:column!important;
  justify-content:flex-end!important;
  align-self:end!important;
  padding-bottom:2px!important;
}
#v-cassette-view .v-cassette-workbench{margin-top:8px!important;}
#v-cassette-view .v-cassette-status-line{
  margin-bottom:12px!important;
  transition:transform .28s ease, opacity .28s ease;
}
#v-cassette-view .v-cassette-format{
  display:inline-flex!important;
  align-items:center!important;
  justify-content:flex-end!important;
  min-height:1.2em;
  transition:letter-spacing .22s ease, opacity .22s ease;
}
#v-cassette-view .v-eq{align-items:flex-end!important;gap:4px!important;height:42px!important;}
#v-cassette-view .v-eq i{
  transform-origin:50% 100%!important;
  opacity:.72!important;
  background:rgba(255,255,255,.13)!important;
  transition:transform .26s cubic-bezier(.22,.61,.36,1), opacity .22s ease, background-color .28s ease!important;
  will-change:transform,opacity;
}
#v-cassette-view .v-eq i[data-on]{background:rgb(var(--v-a-rgb))!important;opacity:1!important;}
#v-cassette-view[data-playing="true"] .v-eq i{
  animation:v-eq-smooth calc(1.05s + var(--n)*.045s) cubic-bezier(.45,.05,.55,.95) calc(var(--n)*-.11s) infinite alternate!important;
}
#v-cassette-view[data-playing="false"] .v-eq i,
#v-cassette-view[data-playing="paused"] .v-eq i{animation:none!important;transform:scaleY(.52)!important;}
@keyframes v-eq-smooth{
  0%{transform:scaleY(.34);opacity:.52;}
  35%{transform:scaleY(.68);opacity:.84;}
  65%{transform:scaleY(1);opacity:1;}
  100%{transform:scaleY(.44);opacity:.62;}
}
@media(max-width:1040px){
  #v-cassette-view .v-cassette-layout{align-items:start!important;}
  #v-cassette-view .v-cassette-copy{justify-content:flex-start!important;align-self:auto!important;padding-bottom:0!important;}
}


/* v23.4.2 — Music controls: immediate hit-target affordance, no expensive
   mirrored artwork/composited 3D tilt on large music shelves. */
html[data-v-ready] [data-music-view] :is(button:not(:disabled),a[href],[role="button"]:not([aria-disabled="true"]),[role="tab"]:not([aria-disabled="true"]),[role="link"]) {
  cursor:pointer!important;
}
html[data-v-ready] [data-music-view] :is(button:disabled,[aria-disabled="true"]) {
  cursor:not-allowed!important;
}
html[data-v-ready] [data-music-view] img[data-v-art] {
  -webkit-box-reflect:none!important;
  transform:none!important;
  margin-bottom:0!important;
  box-shadow:0 7px 18px -12px #000a!important;
  transition:opacity .14s ease!important;
}
html[data-v-ready] [data-music-view] :is(button,a[href],[role="button"]):is(:hover,:focus-visible) img[data-v-art] {
  transform:none!important;
  box-shadow:0 7px 18px -12px #000a!important;
}
html[data-v-ready] [data-music-view] :is(.music-feature-choice,.v-music-links button,.v-music-now button) {
  transition-duration:.14s!important;
}


/* VOID v23.5: chapter-reading bookmarks (not whole-series completion) */
.v-book-ribbon{display:none;pointer-events:none;user-select:none;position:absolute;top:-1px;right:clamp(9px,8%,20px);width:29px;height:65px;z-index:48;box-sizing:border-box;padding:8px 3px 10px;
  clip-path:polygon(0 0,100% 0,100% 100%,50% 84%,0 100%);
  background:linear-gradient(90deg,#513231 0%,#a7605b 17%,#c0796c 50%,#96534e 86%,#462c2d 100%);
  color:#fff2dd;filter:drop-shadow(0px 2px 2px #0007);
  transform:translateZ(56px) rotate(2deg);transform-origin:50% 0;
  font:700 10px/1.2 var(--v-text);letter-spacing:.005em;text-align:center;
  transition:transform .22s cubic-bezier(.2,.75,.3,1);
}
.v-book-ribbon::before{content:"";position:absolute;inset:3px 3px 10px;border-left:1px dashed #fff6e453;border-right:1px dashed #fff6e453;pointer-events:none;}
.v-book-ribbon .v-ribbon-icon{position:relative;z-index:1;display:grid;place-items:center;height:24px;font:700 19px/1 var(--v-text);text-shadow:0 1px 1px #0007;}
.v-book-ribbon .v-ribbon-progress{position:relative;z-index:1;display:block;margin:3px 0 0;font:700 9px/1.2 var(--v-text);white-space:nowrap;font-variant-numeric:tabular-nums;text-shadow:0 1px 1px #0008;}
.v-book-ribbon .v-ribbon-track{position:relative;z-index:1;display:block;width:17px;height:2px;margin:4px auto 0;background:#ffffff48;overflow:hidden;border-radius:3px;}
.v-book-ribbon .v-ribbon-track > i{display:block;height:100%;width:var(--v-progress,0%);background:#fff5d6;transition:width .3s ease-out;}
.v-book-ribbon[data-state="done"]{background:linear-gradient(90deg,#59472c 0%,#b48f53 17%,#d7b778 50%,#9f7d42 86%,#51412e 100%);color:#231a11;}
.v-book-ribbon[data-state="done"]::before{border-color:#3d2a184e;}
.v-book-ribbon[data-state="done"] .v-ribbon-icon{text-shadow:none;}
.v-book-ribbon[data-state="done"] .v-ribbon-track{background:#47331a55;}
.v-book-ribbon[data-state="done"] .v-ribbon-track > i{background:#47331a;}
.v-book-ribbon[data-state="next"]{background:linear-gradient(90deg,#2f4550,#547487 19%,#7d9aa7 52%,#456579 86%,#2c3945);}
html[data-v-page="manga"][data-v-books="on"][data-v-ribbons="on"] [data-v-book-stage] > .v-book-ribbon{display:block;}
@media(hover:hover) and (pointer:fine){html[data-v-motion="on"] [data-v-book]:hover .v-book-ribbon{transform:translateY(-3px) translateZ(56px) rotate(2deg);}}
html[data-v-motion="off"] .v-book-ribbon,html[data-v-performance="on"] .v-book-ribbon{transition:none!important;filter:none!important;}
@media(prefers-reduced-motion:reduce){.v-book-ribbon,.v-book-ribbon .v-ribbon-track > i{transition:none!important;}}


/* VOID v23.6 — opt-in intensity / album-derived lighting. No additional backdrop filters,
   audio capture, rAF painting, animated gradients, or high-frequency forced reflows. */
#v-cassette-view{isolation:isolate;--v-atmo-rgb:105 117 142;--v-atmo-strength:.20;}
#v-cassette-view .v-atmo-field{
  position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden;
  opacity:0;transition:opacity 360ms ease-out;contain:paint;
}
#v-cassette-view .v-atmo-field::before,
#v-cassette-view .v-atmo-field::after{
  content:"";position:absolute;display:block;pointer-events:none;
  background:radial-gradient(ellipse at center,rgb(var(--v-atmo-rgb) / .57) 0%,rgb(var(--v-atmo-rgb) / .21) 38%,transparent 72%);
  will-change:auto;
}
#v-cassette-view .v-atmo-field::before{
  width:80%;height:85%;left:-16%;top:0;
}
#v-cassette-view .v-atmo-field::after{
  width:83%;height:95%;right:-20%;top:-5%;
  background:radial-gradient(ellipse at center,rgb(var(--v-atmo-rgb) / .49) 0%,rgb(var(--v-atmo-rgb) / .17) 38%,transparent 70%);
}
#v-cassette-view[data-v-atmo="on"] .v-atmo-field{opacity:var(--v-atmo-strength,.20);}
#v-cassette-view .v-cassette-head,
#v-cassette-view .v-cassette-layout{position:relative;z-index:1;}
#v-cassette-view[data-v-atmo="on"] .v-tape{
  box-shadow:0 2px 0 #151518,0 32px 80px -34px #000,0 0 0 1px #000a,0 0 44px -29px rgb(var(--v-atmo-rgb) / .35)!important;
}
#v-cassette-view .v-atmo-mode{display:inline-block;color:var(--color-ink-subtle);font:600 9px/1.4 var(--v-text);letter-spacing:.09em;white-space:nowrap;}
#v-cassette-view[data-v-atmo="off"] .v-atmo-mode{display:none;}
html[data-v-performance="on"] #v-cassette-view[data-v-atmo="on"] .v-atmo-field{opacity:.13!important;transition:none!important;}
html[data-v-performance="on"] #v-cassette-view .v-tape{box-shadow:0 2px 0 #151518,0 32px 80px -34px #000,0 0 0 1px #000a!important;}
html[data-v-motion="off"] #v-cassette-view .v-atmo-field{transition:none!important;}
@media(prefers-reduced-motion:reduce){#v-cassette-view .v-atmo-field{transition:none!important;}}
@media(max-width:1040px){#v-cassette-view .v-atmo-field::before{left:-29%;width:125%;}#v-cassette-view .v-atmo-field::after{right:-30%;width:118%;}}


/* VOID v23.7 — Preset Studio: scoped native controls, no animations or backdrop filters. */
#v-panel .v-studio{margin:14px 0 17px;border:1px solid var(--v-rim);border-radius:17px;background:rgba(255,255,255,.035);overflow:hidden;}
#v-panel .v-studio>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 15px;color:var(--color-ink);font:700 14px var(--v-text);user-select:none;}
#v-panel .v-studio>summary::-webkit-details-marker{display:none;}
#v-panel .v-studio>summary .v-studio-caption{display:block;color:var(--color-ink-subtle);font:400 11px/1.45 var(--v-text);margin-top:2px;}
#v-panel .v-studio>summary .v-studio-chevron{flex:none;font:700 22px/1 var(--v-text);color:var(--color-ink-muted);transition:transform .18s ease;}
#v-panel .v-studio[open]>summary .v-studio-chevron{transform:rotate(90deg);}
#v-panel .v-studio>summary:hover{background:rgba(255,255,255,.04);}
#v-panel .v-studio-body{padding:0 14px 15px;border-top:1px solid var(--v-rim);}
#v-panel .v-studio-status{display:block;padding:12px 0 7px;color:var(--color-ink-muted);font:500 12px/1.45 var(--v-text);}
#v-panel .v-studio-feedback{min-height:0;margin:3px 0 8px;color:var(--color-ink-muted);font:500 12px/1.45 var(--v-text);}
#v-panel .v-studio-feedback[data-kind="error"]{color:#ee9292;}
#v-panel .v-studio-feedback[data-kind="success"]{color:#9ed1b2;}
#v-panel .v-studio-label{display:block;margin:12px 0 6px;color:var(--color-ink-subtle);font:700 10px/1.35 var(--v-text);text-transform:uppercase;letter-spacing:.12em;}
#v-panel .v-studio-name,#v-panel .v-studio-json{display:block;width:100%;box-sizing:border-box;border:1px solid var(--v-rim);border-radius:10px;background:rgba(0,0,0,.22);color:var(--color-ink);font:500 12.5px/1.4 var(--v-text);padding:11px;outline:none;}
#v-panel .v-studio-json{font:400 11.5px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace;min-height:64px;max-height:155px;resize:vertical;}
#v-panel .v-studio-name:focus-visible,#v-panel .v-studio-json:focus-visible{border-color:rgba(var(--v-a-rgb),.7);outline:2px solid rgba(var(--v-a-rgb),.35);outline-offset:1px;}
#v-panel .v-studio-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:9px;}
#v-panel .v-studio-btn{appearance:none;border:1px solid var(--v-rim);background:rgba(255,255,255,.055);border-radius:10px;padding:9px 12px;color:var(--color-ink-muted);font:600 12px/1.2 var(--v-text);cursor:pointer;white-space:nowrap;}
#v-panel .v-studio-btn:hover{background:rgba(255,255,255,.11);color:var(--color-ink);}
#v-panel .v-studio-btn:active{background:rgba(255,255,255,.16);}
#v-panel .v-studio-btn[data-primary="true"]{background:rgba(var(--v-a-rgb),.20);border-color:rgba(var(--v-a-rgb),.3);color:var(--color-ink);}
#v-panel .v-studio-list{display:grid;gap:8px;margin-top:9px;}
#v-panel .v-studio-empty{font:400 12px/1.4 var(--v-text);color:var(--color-ink-subtle);padding:12px 2px;margin:0;}
#v-panel .v-studio-row{border:1px solid var(--v-rim);border-radius:12px;padding:10px;background:rgba(255,255,255,.025);}
#v-panel .v-studio-row[data-current="true"]{border-color:rgba(var(--v-a-rgb),.4);}
#v-panel .v-studio-row-head{display:flex;align-items:center;gap:9px;min-width:0;}
#v-panel .v-studio-swatch{width:22px;height:22px;flex:none;border:1px solid rgba(255,255,255,.18);border-radius:7px;background:#ececf0;}
#v-panel .v-studio-row-text{display:flex;flex-direction:column;min-width:0;gap:2px;}
#v-panel .v-studio-row-title{font:650 12.5px/1.3 var(--v-text);color:var(--color-ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
#v-panel .v-studio-row-sub{font:400 11px/1.3 var(--v-text);color:var(--color-ink-subtle);}
#v-panel .v-studio-row-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px;}
#v-panel .v-studio-row-actions .v-studio-btn{font-size:11px;padding:6px 9px;}
#v-panel .v-studio-row-actions .v-studio-btn[data-confirm="true"]{border-color:#e78c8c;color:#f6b1b1;}
#v-panel .v-studio-divider{border:0;border-top:1px solid var(--v-rim);margin:15px 0 12px;}
#v-panel .v-studio-help{margin:8px 0 0;font:400 11px/1.45 var(--v-text);color:var(--color-ink-subtle);}
#v-panel .v-studio-file{display:none;}
@media(prefers-reduced-motion:reduce){#v-panel .v-studio-chevron{transition:none!important;}}


/* VOID v23.8 — optical cases. No per-card JS, no canvas, no per-frame layout work.
   Only Films/Series page poster cards: avoids treating manga/artwork in mixed feeds as a disc. */
html[data-v-ready][data-v-cases="on"]:is([data-v-page="movies"],[data-v-page="shows"])
  [data-media-card]:not([data-row-card-expanded="true"]) > [data-preview-anchor] {
  isolation:isolate;
  overflow:visible;
  --v-case-hue:#20588e;
  --v-case-rim:#153956;
  --v-case-edge:rgba(173,215,255,.24);
}
html[data-v-ready][data-v-cases="on"][data-v-casefmt="dvd"]:is([data-v-page="movies"],[data-v-page="shows"])
  [data-media-card]:not([data-row-card-expanded="true"]) > [data-preview-anchor] {
  --v-case-hue:#3b3a39;
  --v-case-rim:#1a1919;
  --v-case-edge:rgba(231,225,216,.20);
}
/* The native Poster component and its badges remain intact and clickable. */
html[data-v-ready][data-v-cases="on"]:is([data-v-page="movies"],[data-v-page="shows"])
  [data-media-card]:not([data-row-card-expanded="true"]) > [data-preview-anchor] > .harbor-poster {
  z-index:1;
  isolation:isolate;
  border-radius:3px 9px 9px 3px!important;
  outline:1px solid var(--v-case-edge)!important;
  outline-offset:-1px;
  box-shadow:inset 0 0 0 2px rgba(0,0,0,.45), 2px 3px 0 var(--v-case-rim), 3px 5px 12px -3px #000b!important;
  contain:paint;
}
/* Case header: embossed translucent blue for BD, smoky graphite for DVD. */
html[data-v-ready][data-v-cases="on"]:is([data-v-page="movies"],[data-v-page="shows"])
  [data-media-card]:not([data-row-card-expanded="true"]) > [data-preview-anchor] > .harbor-poster::before {
  content:"BLU-RAY";
  position:absolute;
  z-index:3;
  inset:0 0 auto 0;
  height:clamp(16px,10%,24px);
  display:flex;
  align-items:center;
  justify-content:center;
  padding-left:8px;
  box-sizing:border-box;
  background:linear-gradient(180deg,#3676b1 0%,var(--v-case-hue) 63%,var(--v-case-rim) 100%);
  color:#eff7ff;
  font:800 clamp(8px,.7vw,10px)/1 Arial,sans-serif;
  letter-spacing:.17em;
  text-shadow:0 1px 2px #000a;
  box-shadow:0 2px 3px #0006,inset 0 1px 0 #ffffff35;
  border-radius:3px 8px 0 0;
  pointer-events:none;
}
html[data-v-ready][data-v-cases="on"][data-v-casefmt="dvd"]:is([data-v-page="movies"],[data-v-page="shows"])
  [data-media-card]:not([data-row-card-expanded="true"]) > [data-preview-anchor] > .harbor-poster::before {
  content:"DVD VIDEO";
  background:linear-gradient(180deg,#64605c,#3b3937 55%,#191818);
  color:#ede6dd;
}
/* Injection-moulded translucent hinge edge; no new DOM nodes or hover targets. */
html[data-v-ready][data-v-cases="on"]:is([data-v-page="movies"],[data-v-page="shows"])
  [data-media-card]:not([data-row-card-expanded="true"]) > [data-preview-anchor] > .harbor-poster::after {
  content:"";
  position:absolute;
  z-index:4;
  inset:0 auto 0 0;
  width:clamp(7px,7%,12px);
  border-radius:3px 0 0 3px;
  background:linear-gradient(90deg,rgba(0,0,0,.83) 0%,var(--v-case-rim) 24%,rgba(238,244,255,.28) 48%,var(--v-case-hue) 68%,rgba(8,14,22,.65) 95%);
  border-right:1px solid #ffffff1b;
  box-shadow:1px 0 5px #0007;
  pointer-events:none;
}
/* The disc begins behind the poster, not over its artwork or native buttons. */
html[data-v-ready][data-v-cases="on"]:is([data-v-page="movies"],[data-v-page="shows"])
  [data-media-card]:not([data-row-card-expanded="true"]) > [data-preview-anchor]::after {
  content:"";
  position:absolute;
  top:25%;right:1%;width:64%;aspect-ratio:1;
  z-index:0;
  border-radius:50%;
  pointer-events:none;
  opacity:.9;
  border:1px solid #c3c9d054;
  background:
    radial-gradient(circle at 50% 50%,#121317 0 7%,#c3c7cb 7.5% 8.8%,#313337 9% 12%,transparent 12.5%),
    repeating-radial-gradient(circle at 50% 50%,transparent 0 2px,rgba(255,255,255,.07) 2.5px 3px,transparent 3.5px 5px),
    conic-gradient(from 27deg,#29252c,#867d8e,#2d4660,#79837a,#9c6c5e,#333041,#ad9ca4,#29252c);
  box-shadow:0 5px 14px #0009, inset 0 0 0 2px #ffffff17;
  transform:translateX(-29%) rotate(-19deg);
  transition:transform 380ms cubic-bezier(.19,.8,.25,1),opacity 380ms ease;
}
@media(hover:hover) and (pointer:fine){
  html[data-v-ready][data-v-cases="on"][data-v-motion="on"][data-v-performance="off"]:is([data-v-page="movies"],[data-v-page="shows"])
    [data-media-card]:not([data-row-card-expanded="true"]):hover > [data-preview-anchor]::after {
    transform:translateX(25%) rotate(35deg);
    opacity:1;
  }
}
html[data-v-ready][data-v-cases="on"][data-v-motion="on"][data-v-performance="off"]:is([data-v-page="movies"],[data-v-page="shows"])
  [data-media-card]:not([data-row-card-expanded="true"]):focus-visible > [data-preview-anchor]::after {
  transform:translateX(25%) rotate(35deg);
  opacity:1;
}
/* In performance/reduced motion, keep the physical case, but hide the moving disc. */
html[data-v-cases="on"]:is([data-v-motion="off"],[data-v-performance="on"]):is([data-v-page="movies"],[data-v-page="shows"])
  [data-media-card] > [data-preview-anchor]::after {display:none!important;}
@media(prefers-reduced-motion:reduce){
  html[data-v-cases="on"]:is([data-v-page="movies"],[data-v-page="shows"])
    [data-media-card] > [data-preview-anchor]::after{display:none!important;}
}


/* VOID v23.9 — small, composited keyboard shortcut guide; no continuous work. */
#v-shortcuts{position:fixed;inset:0;z-index:260;display:flex;align-items:flex-start;justify-content:center;
  box-sizing:border-box;padding:clamp(24px,11vh,110px) 18px 24px;background:rgba(3,3,5,.80);
  color:var(--color-ink,#f3f3f5);font-family:var(--v-text,Inter,Arial,sans-serif);}
#v-shortcuts[hidden]{display:none!important;}
#v-shortcuts .v-shortcuts-shell{width:min(608px,100%);max-height:min(74vh,710px);display:flex;flex-direction:column;
  overflow:hidden;border:1px solid var(--v-rim,rgba(255,255,255,.13));border-radius:22px;
  background:var(--v-flat,#141416);box-shadow:0 35px 100px -28px #000;}
#v-shortcuts .v-shortcuts-head{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:23px 23px 17px;flex-shrink:0;}
#v-shortcuts .v-shortcuts-heading{min-width:0;}
#v-shortcuts .v-shortcuts-overline{font:650 10px/1.5 var(--v-text,Inter,Arial,sans-serif);letter-spacing:.22em;color:rgba(255,255,255,.43);}
#v-shortcuts h3{font:750 clamp(23px,4vw,30px)/1.22 var(--v-display,Inter,Arial,sans-serif);letter-spacing:-.045em;margin:3px 0 0;}
#v-shortcuts .v-shortcuts-close{width:34px;height:34px;flex:none;border:1px solid var(--v-rim,rgba(255,255,255,.16));
  border-radius:11px;background:rgba(255,255,255,.055);color:inherit;cursor:pointer;font:500 24px/1 var(--v-text,Inter,Arial,sans-serif);}
#v-shortcuts .v-shortcuts-close:hover{background:rgba(255,255,255,.12);}
#v-shortcuts .v-shortcuts-search-wrap{margin:0 23px 10px;display:flex;align-items:center;gap:11px;
  padding:0 15px;border-radius:12px;background:rgba(255,255,255,.055);border:1px solid var(--v-rim,rgba(255,255,255,.11));}
#v-shortcuts .v-shortcuts-search-wrap svg{height:17px;width:17px;fill:none;stroke:currentColor;stroke-width:1.8;color:var(--color-ink-subtle,#888);}
#v-shortcuts .v-shortcuts-search{min-width:0;min-height:45px;flex:1;border:0;outline:0;background:transparent;
  color:inherit;font:500 13px/1.4 var(--v-text,Inter,Arial,sans-serif);}
#v-shortcuts .v-shortcuts-search::placeholder{color:var(--color-ink-subtle,#777);}
#v-shortcuts .v-shortcuts-search:focus-visible{outline:none!important;}
#v-shortcuts .v-shortcuts-search-wrap:focus-within{border-color:rgba(255,255,255,.31);box-shadow:0 0 0 2px rgba(255,255,255,.08);}
#v-shortcuts .v-shortcuts-body{overflow:auto;overscroll-behavior:contain;scrollbar-width:thin;padding:3px 23px 14px;}
#v-shortcuts .v-shortcuts-group{margin-top:16px;}
#v-shortcuts .v-shortcuts-group:first-child{margin-top:8px;}
#v-shortcuts .v-shortcuts-group h4{font:700 10px/1.4 var(--v-text,Inter,Arial,sans-serif);color:var(--color-ink-subtle,#888);
  letter-spacing:.15em;text-transform:uppercase;margin:0 0 7px;}
#v-shortcuts .v-shortcuts-row{display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:11px 0;border-bottom:1px solid rgba(255,255,255,.065);min-height:42px;box-sizing:border-box;}
#v-shortcuts .v-shortcuts-label{font:550 13px/1.35 var(--v-text,Inter,Arial,sans-serif);min-width:0;}
#v-shortcuts .v-shortcuts-description{font:450 11px/1.5 var(--v-text,Inter,Arial,sans-serif);color:var(--color-ink-subtle,#888);margin-top:3px;}
#v-shortcuts .v-shortcuts-keys{display:flex;gap:4px;flex:none;align-items:center;}
#v-shortcuts kbd{display:inline-flex;align-items:center;justify-content:center;min-height:26px;min-width:26px;
  box-sizing:border-box;padding:4px 7px;border:1px solid rgba(255,255,255,.14);border-bottom-color:rgba(255,255,255,.24);
  border-radius:7px;background:rgba(255,255,255,.06);color:var(--color-ink,#eee);font:650 11px/1 var(--v-text,Inter,Arial,sans-serif);white-space:nowrap;}
#v-shortcuts .v-shortcuts-empty{padding:36px 0;text-align:center;color:var(--color-ink-muted,#aaa);font:500 13px/1.5 var(--v-text,Inter,Arial,sans-serif);}
#v-shortcuts .v-shortcuts-foot{padding:12px 23px 14px;border-top:1px solid rgba(255,255,255,.09);
  display:flex;justify-content:space-between;gap:10px;align-items:center;font:450 11px/1.5 var(--v-text,Inter,Arial,sans-serif);
  color:var(--color-ink-subtle,#888);flex-shrink:0;}
#v-shortcuts :is(button,input):focus-visible{outline:2px solid rgb(var(--v-a-rgb,235 235 238));outline-offset:3px;}
@media(max-width:520px){#v-shortcuts{padding:64px 12px 14px;}#v-shortcuts .v-shortcuts-shell{max-height:calc(100vh - 82px);}
 #v-shortcuts .v-shortcuts-head{padding:17px 17px 12px;}#v-shortcuts .v-shortcuts-search-wrap{margin:0 17px 7px;}
 #v-shortcuts .v-shortcuts-body{padding:2px 17px 10px;}#v-shortcuts .v-shortcuts-foot{padding:10px 17px;}
 #v-shortcuts .v-shortcuts-row{gap:9px;}#v-shortcuts .v-shortcuts-label{font-size:12px;}}
@media(prefers-reduced-motion:reduce){#v-shortcuts *,#v-shortcuts *::before,#v-shortcuts *::after{animation:none!important;transition:none!important;}}


/* VOID v23.10 — Search workspace + shared UI cohesion
   CSS-only. No observers, timers, repaint loops or replacement native event handlers. */

/* Consistent small-control language across Harbor, without overriding layout or native state. */
html[data-v-ready]{
  --v-ui-hair:rgba(255,255,255,.105);
  --v-ui-hair-hover:rgba(255,255,255,.27);
  --v-ui-panel:var(--v-flat);
  --v-ui-tile:var(--v-flat-2);
  --v-ui-tile-hover:color-mix(in srgb,var(--v-flat-2) 82%,white);
  --v-ui-focus:rgba(var(--v-a-rgb),.72);
}
html[data-v-ready] :is(.modal-panel,.harbor-profile-dropdown){
  border-color:var(--v-ui-hair)!important;
  background:var(--v-ui-panel)!important;
  box-shadow:0 24px 76px -38px rgba(0,0,0,.92)!important;
}
html[data-v-ready] .modal-panel :is(button,a,[role="button"]){
  cursor:pointer;
  -webkit-tap-highlight-color:transparent;
}
html[data-v-ready] :is(.modal-panel,.harbor-profile-dropdown) :is(button,a,input,select,textarea):focus-visible{
  outline:2px solid var(--v-ui-focus)!important;
  outline-offset:2px;
}
html[data-v-ready] main :is([role="tab"],[role="button"]):focus-visible{
  outline:2px solid var(--v-ui-focus);
  outline-offset:2px;
}
html[data-v-ready] main [role="tablist"] [role="tab"]{
  transition:color 140ms ease,background-color 140ms ease,border-color 140ms ease;
  cursor:pointer;
}

/* Shared list / settings surfaces on the previously less customized pages.
   These operate on native utility tokens; no new dom wrappers, translations,
   filters or badge replacement. */
html[data-v-ready]:is([data-v-page="addons"],[data-v-page="calendar"],[data-v-page="downloads"],
  [data-v-page="library"],[data-v-page="collections"],[data-v-page="games"],[data-v-page="settings"],
  [data-v-page="ebook"],[data-v-page="live"],[data-v-page="sports"])
  main :is(button,[role="button"])[class*="border-edge-soft"][class*="bg-elevated"]{
  border-color:var(--v-ui-hair)!important;
  background:var(--v-ui-tile)!important;
  box-shadow:none!important;
}
html[data-v-ready]:is([data-v-page="addons"],[data-v-page="calendar"],[data-v-page="downloads"],
  [data-v-page="library"],[data-v-page="collections"],[data-v-page="games"],[data-v-page="settings"],
  [data-v-page="ebook"],[data-v-page="live"],[data-v-page="sports"])
  main :is(button,[role="button"])[class*="border-edge-soft"][class*="bg-elevated"]:hover{
  border-color:var(--v-ui-hair-hover)!important;
  background:var(--v-ui-tile-hover)!important;
}
/* Keep every section's own layout and native card/CTA logic; this is only
   shared type scale for section titles outside cinematic hero cards. */
html[data-v-ready]:is([data-v-page="addons"],[data-v-page="calendar"],[data-v-page="downloads"],
  [data-v-page="library"],[data-v-page="collections"],[data-v-page="games"],[data-v-page="settings"],
  [data-v-page="ebook"],[data-v-page="live"],[data-v-page="sports"])
  main section > h2:not([class*="sr-only"]){
  font-family:var(--v-display)!important;
  letter-spacing:-.025em!important;
}

/* Search overlay: actual Harbor SearchOverlay markup, not a synthetic popup.
   No backdrop blur, filter animation, clone, new fetch or DOM observer. */
html[data-v-ready] [data-search-overlay="true"]{
  color:var(--color-ink);
  font-family:var(--v-text);
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-backdrop{
  background:rgba(0,0,0,.84)!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
}
html[data-v-ready] [data-search-overlay="true"] > div.relative{
  width:100%;
  max-width:1050px!important;
  padding:clamp(17px,4vh,44px) clamp(13px,3vw,30px) 16px!important;
  box-sizing:border-box;
}
html[data-v-ready] [data-search-overlay="true"] > div.relative > .modal-panel{
  isolation:isolate;
  max-height:min(88dvh,790px);
  width:100%;
  border:1px solid var(--v-ui-hair)!important;
  border-radius:22px!important;
  background:var(--v-ui-panel)!important;
  box-shadow:0 36px 110px -43px #000!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
}
html[data-v-ready] [data-search-overlay="true"] > div.relative > .modal-panel::before{
  content:"VOID  /  UNIVERSAL SEARCH";
  display:block;
  flex:none;
  padding:20px 28px 0;
  color:rgba(var(--v-a-rgb),.65);
  font:700 10px/1.3 var(--v-text);
  letter-spacing:.21em;
  pointer-events:none;
}
html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container]{
  min-height:82px;
  padding:7px 28px 14px!important;
  gap:15px!important;
  border-bottom:1px solid var(--v-ui-hair)!important;
  background:transparent!important;
}
html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container] > svg{
  width:21px;height:21px;
  color:rgba(var(--v-a-rgb),.83)!important;
}
html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container] input[type="text"]{
  min-height:62px!important;
  height:62px!important;
  min-width:0;
  padding:0!important;
  border:0!important;
  outline:0!important;
  box-shadow:none!important;
  background:transparent!important;
  color:var(--color-ink)!important;
  font:560 clamp(18px,2.25vw,24px)/1.2 var(--v-display)!important;
  letter-spacing:-.028em;
}
html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container] input[type="text"]::placeholder{
  opacity:1;
  color:rgba(226,226,235,.43)!important;
}
html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container] input[type="text"]:focus-visible{
  outline:0!important;
  box-shadow:none!important;
}
html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container]:focus-within{
  box-shadow:inset 0 -2px 0 rgba(var(--v-a-rgb),.54);
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-body{
  padding:23px 28px 27px!important;
  scrollbar-width:thin!important;
  scrollbar-color:rgba(255,255,255,.19) transparent!important;
  overscroll-behavior:contain;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade{
  display:flex!important;
  flex-direction:column!important;
  gap:22px!important;
  padding:0!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section{
  min-width:0;
  padding:0;
}
/* Small editorial headings and dividers: repeat in each group. */
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section h3{
  margin:0 0 12px!important;
  color:rgba(242,242,246,.59)!important;
  font:700 11px/1.4 var(--v-text)!important;
  text-transform:uppercase;
  letter-spacing:.17em!important;
}
/* Recent searches: slim horizontal toolbar without the old oversized pills. */
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(4){
  padding-bottom:20px;
  border-bottom:1px solid var(--v-ui-hair);
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(4) > div:first-child{
  margin-bottom:9px!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(4) > div:nth-child(2) > span{
  border-radius:9px!important;
  background:var(--v-ui-tile)!important;
  border:1px solid var(--v-ui-hair)!important;
  gap:0!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(4) > div:nth-child(2) > span:hover{
  background:var(--v-ui-tile-hover)!important;
  border-color:var(--v-ui-hair-hover)!important;
}
/* "Jump to": square command tiles, matching VOID's hard-edged media furniture. */
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div{
  display:grid!important;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:9px!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div > button{
  min-width:0;
  min-height:67px!important;
  height:auto!important;
  width:100%;
  padding:13px 10px!important;
  display:flex!important;
  align-items:center;
  justify-content:flex-start;
  gap:10px!important;
  border:1px solid var(--v-ui-hair)!important;
  border-radius:12px!important;
  background:var(--v-ui-tile)!important;
  box-shadow:none!important;
  color:var(--color-ink)!important;
  font:650 13px/1.24 var(--v-text)!important;
  text-align:left;
  transition:background-color 150ms ease,border-color 150ms ease!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div > button:hover{
  background:var(--v-ui-tile-hover)!important;
  border-color:var(--v-ui-hair-hover)!important;
  transform:none!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div > button > span{
  flex:0 0 auto;
  width:23px!important;
  height:23px!important;
  display:grid;
  place-items:center;
  color:rgb(var(--v-a-rgb))!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div > button > span svg{
  width:21px!important;
  height:21px!important;
  padding:0!important;
}
/* Genres are secondary refinements, not primary navigation tiles. */
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(2){
  padding-top:17px;
  border-top:1px solid var(--v-ui-hair);
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(2) > div{
  gap:7px!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(2) > div > button{
  height:33px!important;
  padding:0 13px!important;
  border-radius:9px!important;
  background:transparent!important;
  border:1px solid var(--v-ui-hair)!important;
  color:var(--color-ink-muted)!important;
  font:550 12px/1.3 var(--v-text)!important;
  transition:color 150ms ease,background-color 150ms ease,border-color 150ms ease!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(2) > div > button:hover{
  background:var(--v-ui-tile)!important;
  color:var(--color-ink)!important;
  border-color:var(--v-ui-hair-hover)!important;
}
/* Single utility action at the bottom, not a randomly floating button. */
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:last-child{
  padding-top:13px;
  border-top:1px solid var(--v-ui-hair);
  justify-content:flex-start!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:last-child > button{
  min-height:43px!important;
  height:43px!important;
  border-radius:11px!important;
  padding:0 18px!important;
  color:var(--color-ink)!important;
  background:rgba(var(--v-a-rgb),.10)!important;
  border:1px solid rgba(var(--v-a-rgb),.27)!important;
  box-shadow:none!important;
  font:650 12px/1.3 var(--v-text)!important;
  transition:background-color 150ms ease,border-color 150ms ease!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:last-child > button:hover{
  background:rgba(var(--v-a-rgb),.17)!important;
  border-color:rgba(var(--v-a-rgb),.48)!important;
}
html[data-v-ready] [data-search-overlay="true"] :is(.harbor-search-section,.harbor-search-cascade) :is(button,a){
  cursor:pointer;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-section :is(button,a):focus-visible,
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade button:focus-visible{
  outline:2px solid var(--v-ui-focus)!important;
  outline-offset:2px;
}
@media(max-width:820px){
  html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }
}
@media(max-width:530px){
  html[data-v-ready] [data-search-overlay="true"] > div.relative{
    padding:12px 9px!important;
  }
  html[data-v-ready] [data-search-overlay="true"] > div.relative > .modal-panel{
    max-height:calc(100dvh - 24px);
    border-radius:16px!important;
  }
  html[data-v-ready] [data-search-overlay="true"] > div.relative > .modal-panel::before{
    padding:15px 15px 0;font-size:9px;
  }
  html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container]{
    min-height:70px;
    padding:5px 15px 8px!important;
    gap:10px!important;
  }
  html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container] input[type="text"]{
    min-height:52px!important;height:52px!important;font-size:16px!important;
  }
  html[data-v-ready] [data-search-overlay="true"] .harbor-search-body{
    padding:17px 15px 22px!important;
  }
  html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade{
    gap:18px!important;
  }
  html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:7px!important;
  }
  html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div > button{
    min-height:54px!important;padding:10px!important;font-size:12px!important;
  }
}
@media(prefers-reduced-motion:reduce){
  html[data-v-ready] [data-search-overlay="true"] *,
  html[data-v-ready] [data-search-overlay="true"] *::before,
  html[data-v-ready] [data-search-overlay="true"] *::after{
    animation:none!important;transition:none!important;
  }
}

/* Results, filters and alternative search states use the same visual vocabulary. */
html[data-v-ready] [data-search-overlay="true"] .harbor-search-section > :is(h2,h3){
  color:var(--color-ink-muted)!important;
  font:700 12px/1.4 var(--v-text)!important;
  letter-spacing:.12em!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-section button[aria-pressed]{
  border-radius:9px!important;
  min-height:34px;
  border:1px solid var(--v-ui-hair)!important;
  background:var(--v-ui-tile)!important;
  color:var(--color-ink-muted)!important;
  box-shadow:none!important;
  transition:border-color 140ms ease,background-color 140ms ease!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-section button[aria-pressed]:hover{
  border-color:var(--v-ui-hair-hover)!important;
  background:var(--v-ui-tile-hover)!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-section button[aria-pressed="true"]{
  border-color:rgba(var(--v-a-rgb),.48)!important;
  background:rgba(var(--v-a-rgb),.13)!important;
  color:var(--color-ink)!important;
}



/* ============================================================================
   VOID v23.11 — global typography and contextual accent cohesion
   Applies to native shared controls across every Harbor section and portal.
   Intentionally avoids poster artwork, media-provider logos, app status colors,
   warning/error/success badges, cinematic hero typography, and the hand-lettered
   analogue cassette label. CSS only: no watchers, layout loops or JS handlers.
   ============================================================================ */

/* Single color source: the selected VOID mood defines --v-a-rgb; optional Tab
   Accents switches --v-ac-rgb by current native navigation page. Existing
   Harbor components consume --color-accent, and VOID-native widgets consume
   --v-ac-rgb, so sync the two instead of letting accents drift across sections. */
html[data-v-ready]{
  --v-ui-accent:rgb(var(--v-ac-rgb));
  --v-ui-accent-soft:rgba(var(--v-ac-rgb),.12);
  --v-ui-accent-border:rgba(var(--v-ac-rgb),.45);
  --v-ui-focus:rgba(var(--v-ac-rgb),.82);
  --color-accent:var(--v-ui-accent)!important;
  --color-accent-soft:rgba(var(--v-ac-rgb),.16)!important;
  accent-color:var(--v-ui-accent);
}

/* Harbor declares general-sans at theme metadata level; explicit input and
   popover typography was still different on some screens. Keep inherited sizes
   and weights for native accessibility and component-specific hierarchy. */
html[data-v-ready] body{
  font-family:var(--v-text)!important;
  font-kerning:normal;
  font-synthesis:none;
}
html[data-v-ready] :is(button,input,textarea,select,option,label,
  [role="button"],[role="tab"],[role="menuitem"],[role="menuitemradio"],
  [role="menuitemcheckbox"],[role="option"],[role="combobox"]){
  font-family:var(--v-text)!important;
  font-kerning:normal;
}
html[data-v-ready] :is(main,[role="dialog"],.modal-panel,.harbor-search-body)
  :is(h1,h2,h3){
  font-family:var(--v-display)!important;
  font-kerning:normal;
}
html[data-v-ready] :is(main,[role="dialog"],.modal-panel) h1{
  letter-spacing:-.038em!important;
}
html[data-v-ready] :is(main,[role="dialog"],.modal-panel) h2{
  letter-spacing:-.028em!important;
}
html[data-v-ready] :is(main,[role="dialog"],.modal-panel) h3{
  letter-spacing:-.018em!important;
}
/* The customized Music masthead, hero headings and cassette display text
   retain their authored tracking/weight despite the shared heading system. */
html[data-v-ready] [data-music-view] :is(h1,.music-home-feature-copy h2){
  letter-spacing:-.04em!important;
}
html[data-v-ready] #v-cassette-view .v-tape-title,
html[data-v-ready] #v-cassette-view .v-tape-footer,
html[data-v-ready] .v-book-spine{font-family:inherit;}

/* Input, search and menu accessibility. Use native dimensions, padding,
   validation colors and focus logic; only bring the accent and type together. */
html[data-v-ready] :is(main,[role="dialog"],.modal-panel,#v-panel,#v-shortcuts)
  :is(input,textarea,select):not([type="checkbox"]):not([type="radio"]){
  caret-color:var(--v-ui-accent);
}
html[data-v-ready] :is(main,[role="dialog"],.modal-panel,#v-panel,#v-shortcuts)
  :is(input[type="checkbox"],input[type="radio"],input[type="range"]){
  accent-color:var(--v-ui-accent);
}
html[data-v-ready] :is(main,[role="dialog"],.modal-panel,#v-panel,#v-shortcuts)
  :is(input,textarea):not([type="checkbox"]):not([type="radio"])::placeholder{
  color:var(--color-ink-subtle);
  opacity:.85;
}
html[data-v-ready] :is(main,[role="dialog"],.modal-panel,#v-panel,#v-shortcuts)
  :is(button,a,input,select,textarea,[role="button"],[role="tab"],
  [role="menuitem"],[role="checkbox"],[role="radio"]):focus-visible{
  outline-color:var(--v-ui-focus)!important;
}
html[data-v-ready] :is(.modal-panel,[role="dialog"])
  :is(button,a,input,select,textarea,[role="tab"],[role="menuitem"]):focus-visible{
  outline:2px solid var(--v-ui-focus)!important;
  outline-offset:2px;
}

/* Native tabs and segmented filters in every view. Only selection borders and
   text color are standardized; no pseudo-underline is added (which could double
   Harbor's existing selected underline or collide with focus rings). */
html[data-v-ready] :is(main,[role="dialog"],.modal-panel)
  [role="tab"][aria-selected="true"]{
  border-bottom-color:var(--v-ui-accent)!important;
  color:var(--color-ink)!important;
}
html[data-v-ready] :is(main,[role="dialog"],.modal-panel)
  :is([role="radio"],[role="checkbox"],[role="switch"])[aria-checked="true"]{
  border-color:var(--v-ui-accent-border);
}
html[data-v-ready] main :is(button,[role="button"])[aria-pressed="true"]:not([disabled]){
  --tw-ring-color:var(--v-ui-accent-border);
}

/* Selected VOID navigation and Appearance controls, synchronized with native
   active tab accents, including special Carbon/Night/Bone palettes. */
html[data-v-ready] .v-navbtn[data-active="true"]::before{
  background:var(--v-ui-accent);
}
html[data-v-ready] .v-navbtn[data-active="true"] svg{
  color:var(--v-ui-accent);
}
html[data-v-ready] .v-navbtn:focus-visible{
  outline-color:var(--v-ui-focus)!important;
}
html[data-v-ready] #v-panel .v-choice[aria-pressed="true"]:not([data-v-mood]){
  border-color:var(--v-ui-accent-border);
  background:var(--v-ui-accent-soft);
}
html[data-v-ready] #v-panel .v-switch[aria-pressed="true"] b{
  background:var(--v-ui-accent);
}
html[data-v-ready] #v-panel .v-switch[aria-pressed="true"] b::after{
  background:rgb(var(--v-bg-rgb));
}
html[data-v-ready] #v-panel :is(button,input):focus-visible,
html[data-v-ready] #v-shortcuts :is(button,input):focus-visible{
  outline-color:var(--v-ui-focus)!important;
}
html[data-v-ready] #v-shortcuts .v-shortcuts-search-wrap:focus-within{
  border-color:var(--v-ui-accent-border);
  box-shadow:0 0 0 2px var(--v-ui-accent-soft);
}

/* Visible but quiet accent cues for common native controls. Do not recolor
   semantic error/green success indicators, service logos, badges, artwork or
   genre identity colors. Native buttons already using bg-accent/text-accent
   naturally inherit the unified --color-accent token above. */
html[data-v-ready] :is(main,[role="dialog"],.modal-panel)
  :is(a,button,[role="button"]):not([disabled]):not([aria-disabled="true"]){
  -webkit-tap-highlight-color:transparent;
}
html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container]:focus-within{
  box-shadow:inset 0 -2px 0 var(--v-ui-accent-border);
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade
  > section:last-child > button{
  background:var(--v-ui-accent-soft)!important;
  border-color:rgba(var(--v-ac-rgb),.29)!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade
  > section:last-child > button:hover{
  background:rgba(var(--v-ac-rgb),.18)!important;
  border-color:var(--v-ui-accent-border)!important;
}

/* The interface is always usable in no-motion / Performance modes: no new
   gradients, backdrop blurs, filters, animations or rAF-based color updates. */

/* ============================================================================
   VOID v23.12 · Unified design system / remaining Harbor surfaces
   No injected DOM, event listeners, layout watchers or paint loops.
   Primary reference: native Settings, Catalogs, search, Notifications,
   Watch Together, dialogs/menus, addon & library management.
   ============================================================================ */
html[data-v-ready]{
  --v-12-pane:var(--v-flat,#0c0c0e);
  --v-12-inset:var(--v-flat-2,#141417);
  --v-12-edge:rgba(255,255,255,.092);
  --v-12-edge-hi:rgba(255,255,255,.19);
  --v-12-text:var(--color-ink,#f2f2f4);
  --v-12-dim:var(--color-ink-muted,#a9a9b3);
  --v-12-mute:var(--color-ink-subtle,#7c7c86);
  --v-12-accent:rgb(var(--v-ac-rgb));
  --v-12-wash:rgba(var(--v-ac-rgb),.115);
  --v-12-active-edge:rgba(var(--v-ac-rgb),.37);
  --v-12-radius:12px;
  --v-12-on-accent:var(--color-canvas);
}
html[data-v-ready][data-v-mood="netflix"]{--v-12-on-accent:#fff;}
/* One typographic voice. Elements with branded artwork, titles-as-images,
   analogue tape handwriting, provider marks and monospace code are excluded. */
html[data-v-ready] #root :is(main,aside,nav,header,footer) :is(p,li,dt,dd,small,label,summary,button,input,textarea,select),
html[data-v-ready] :is([role="dialog"],[role="menu"],[role="listbox"],[data-settings-menu],.harbor-together-surface)
  :is(p,li,dt,dd,small,label,summary,button,input,textarea,select){
  font-family:var(--v-text)!important;
}
html[data-v-ready] #root :is(main,aside,nav,header,footer) :is(h1,h2,h3,h4),
html[data-v-ready] :is([role="dialog"],.harbor-together-surface) :is(h1,h2,h3,h4){
  font-family:var(--v-display)!important;
  font-kerning:normal;
  letter-spacing:-.025em;
}
html[data-v-ready] :is([role="dialog"],.harbor-together-surface,.modal-panel) :is(p,li){line-height:1.55;}
html[data-v-ready] :is(.harbor-settings-shell,[data-settings-menu],.harbor-together-surface,[data-search-overlay]) :is(button,a,[role="button"],[role="option"]):not(:disabled){cursor:pointer;}
/* Shared accessible input and focus styling. Let native validation and geometry work. */
html[data-v-ready] :is(.harbor-settings-shell,.harbor-together-surface,[role="dialog"],main)
  :is(input,textarea,select):not([type="checkbox"]):not([type="radio"]):not([type="range"]){
  font-family:var(--v-text)!important;
  caret-color:var(--v-12-accent);
}
html[data-v-ready] :is(.harbor-settings-shell,.harbor-together-surface,[role="dialog"],main)
  :is(input,textarea,select):not([type="checkbox"]):not([type="radio"]):focus-visible{
  outline-color:var(--v-12-active-edge)!important;
}
html[data-v-ready] :is(.harbor-settings-shell,.harbor-together-surface,[role="dialog"],main)
  :is(button,a,[role="button"],[role="menuitem"],[role="option"]):focus-visible{
  outline:2px solid rgba(var(--v-ac-rgb),.75)!important;
  outline-offset:2px;
}
/* Unified action and selection feedback; no transform animations on repeated cards. */
html[data-v-ready] :is(.harbor-settings-shell,[data-settings-menu],.harbor-together-surface,[role="dialog"])
  :is(button,[role="option"],[role="menuitem"]):not(:disabled):not([aria-disabled="true"]){
  -webkit-tap-highlight-color:transparent;
}
html[data-v-ready] :is([role="dialog"],[role="listbox"],[data-settings-menu])
  :is([role="option"],[role="menuitem"],[role="menuitemradio"]):is([aria-selected="true"],[aria-checked="true"],[data-active]){
  background:var(--v-12-wash)!important;
  color:var(--v-12-text)!important;
}



/* --- Dialogs, notifications, Watch Together, popovers, menu/listbox surfaces. --- */
html[data-v-ready] :is(.harbor-together-surface,[role="dialog"].harbor-together-surface){
  background:var(--v-12-pane)!important;
  border:1px solid var(--v-12-edge-hi)!important;
  border-radius:15px!important;
  box-shadow:0 22px 64px -24px rgba(0,0,0,.97),inset 0 1px 0 rgba(255,255,255,.026)!important;
  color:var(--v-12-text)!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
}
html[data-v-ready] .harbor-together-surface :is(header,div.flex.items-center.justify-between):first-child{
  border-bottom:1px solid var(--v-12-edge);
}
html[data-v-ready] .harbor-together-surface :is(h2,[class*="text-ink"][class*="font-semibold"]){
  color:var(--v-12-text);
  font-family:var(--v-display)!important;
  letter-spacing:-.02em!important;
}
html[data-v-ready] .harbor-together-surface :is(input,textarea){
  background:var(--color-canvas)!important;
  color:var(--v-12-text)!important;
  border:1px solid var(--v-12-edge)!important;
  border-radius:9px!important;
}
html[data-v-ready] .harbor-together-surface :is(input,textarea):focus-visible{
  border-color:var(--v-12-active-edge)!important;
}
html[data-v-ready] .harbor-together-surface button[class*="bg-white/"],
html[data-v-ready] .harbor-together-surface button[class*="bg-elevated"]{
  background:var(--v-12-inset)!important;
  border:1px solid var(--v-12-edge)!important;
  border-radius:9px!important;
}
html[data-v-ready] .harbor-together-surface button[class*="bg-white/"]:hover,
html[data-v-ready] .harbor-together-surface button[class*="bg-elevated"]:hover{
  background:rgba(255,255,255,.075)!important;
  border-color:var(--v-12-edge-hi)!important;
}
/* Notifications: retain row/click handlers; make status list feel like one UI. */
html[data-v-ready] .harbor-together-surface :is([class*="rounded-lg"],[class*="rounded-xl"])[class*="bg-elevated"]{
  border-color:var(--v-12-edge)!important;
  background:var(--v-12-inset)!important;
}
html[data-v-ready] :is([data-settings-menu],[role="menu"],[role="listbox"]):not([data-v-ui]){
  font-family:var(--v-text)!important;
  border-color:var(--v-12-edge-hi)!important;
}
html[data-v-ready] [role="menu"]:not(#v-panel):not(#v-shortcuts),
html[data-v-ready] [role="listbox"]{
  background:var(--v-12-pane)!important;
  border:1px solid var(--v-12-edge-hi)!important;
  border-radius:12px!important;
  box-shadow:0 18px 45px -21px #000!important;
}
html[data-v-ready] :is([role="menu"],[role="listbox"],[data-settings-menu])
  :is([role="menuitem"],[role="option"],[role="menuitemradio"]):hover{
  background:rgba(255,255,255,.065)!important;
}
html[data-v-ready] :is([role="menu"],[role="listbox"],[data-settings-menu])
  :is([role="option"],[role="menuitemradio"]):is([aria-selected="true"],[aria-checked="true"]){
  box-shadow:inset 2px 0 var(--v-12-accent);
  background:var(--v-12-wash)!important;
  color:var(--v-12-text)!important;
}
/* General utility panels: quiet neutral geometry, preserve their specialized content. */
html[data-v-ready] .modal-panel:not([data-search-overlay] .modal-panel){
  border-color:var(--v-12-edge)!important;
  border-radius:16px;
}
html[data-v-ready] .harbor-settings-shell [data-settings-menu]{
  background:var(--v-12-pane);
  border-radius:12px;
}



/* C. Catalogs: flatten the large ornamental masthead. No false action labels,
      no new markup, keep all selectors/search/customization working natively. */
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto{
  padding-top:clamp(77px,6.1vw,102px)!important;
  padding-inline:clamp(20px,3.15vw,58px)!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div.flex.flex-col.gap-8{
  gap:19px!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header{
  gap:10px!important;
  padding:9px 4px 16px!important;
  margin:0!important;
  background:transparent!important;
  border:0!important;
  border-bottom:1px solid var(--v-12-edge)!important;
  border-radius:0!important;
  box-shadow:none!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header::before{
  font-size:9px!important;
  line-height:1.1!important;
  margin:0 0 1px!important;
  letter-spacing:.17em!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header > div:first-of-type{
  align-items:center!important;
  min-height:55px;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header h1{
  font-size:clamp(29px,2.3vw,36px)!important;
  line-height:1!important;
  letter-spacing:-.055em!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header p{
  max-width:80ch;font-size:12.5px!important;line-height:1.45!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header :is(h2,p){margin-block:0!important;}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header h2{
  font:700 11px/1.3 var(--v-text)!important;
  color:var(--color-ink-muted)!important;
  letter-spacing:.07em!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header >div.flex.flex-col.gap-3{
  gap:9px!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header button[class*="rounded-full"]:not([class*="absolute"]){
  min-height:34px;height:auto;
  border-radius:9px!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header input[placeholder]{
  height:38px!important;
  min-height:38px;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header :is(button,input):focus-visible{
  outline:2px solid var(--v-ui-focus)!important;outline-offset:2px;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>section,
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>div>section{
  padding-top:18px!important;
}



/* D. Stream selector: the native picker is an absolute full-window main. Scope
      by the actual PlayPicker root and source-list markup, not global buttons.
      Native backToDetail() remains authoritative. */
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas{
  background:var(--color-canvas)!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas > div.relative.z-20{
  max-width:min(1850px,100%)!important;
  width:100%!important;
  box-sizing:border-box;
  padding-inline:clamp(18px,2.9vw,56px)!important;
  padding-top:14px!important;
  gap:15px!important;
}
/* The top drag region can overlap hit testing in native WebView windows.
   Retain native drag functionality elsewhere; elevate the actual nav above it. */
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas > div.relative.z-20 >div.mt-6{
  position:relative!important;
  z-index:60!important;
  margin-top:4px!important;
  pointer-events:auto!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas > div.relative.z-20 >div.mt-6 button{
  position:relative;
  z-index:61!important;
  min-width:120px;
  min-height:50px!important;
  padding:5px 17px 5px 5px!important;
  border:1px solid var(--v-12-edge-hi)!important;
  border-radius:999px!important;
  background:var(--v-12-inset)!important;
  cursor:pointer!important;
  touch-action:manipulation;
  transition:background-color 140ms ease,border-color 140ms ease!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas > div.relative.z-20 >div.mt-6 button:hover{
  background:rgba(255,255,255,.095)!important;
  border-color:var(--v-12-active-edge)!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas > div.relative.z-20 >div.mt-6 button:focus-visible{
  outline:2px solid var(--v-ui-focus)!important;
  outline-offset:3px;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas > div.relative.z-20 >div.mt-6 button >span:first-child{
  width:37px!important;
  height:37px!important;
  background:var(--v-12-pane)!important;
}
/* Stream metadata: align the source logo, descriptive content and actions as
   stable columns. Allow long descriptions to wrap inside their own column;
   never spread across adjacent cells or push Play off screen. */
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
  div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40{
  display:grid!important;
  grid-template-columns:72px minmax(0,1fr) auto;
  align-items:center!important;
  gap:18px!important;
  padding:17px clamp(15px,1.4vw,23px)!important;
  border:1px solid var(--v-12-edge)!important;
  background:var(--v-12-pane)!important;
  border-radius:13px!important;
  box-shadow:none!important;
  min-width:0;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
  div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40 > div:nth-child(2){
  min-width:0!important;
  width:100%;
  justify-content:center;
  gap:5px!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
  div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40 > div:nth-child(2) p{
  margin:0;
  max-width:100%;
  overflow-wrap:break-word!important;
  word-break:normal!important;
  line-height:1.4!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
  div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40 > div:last-child{
  justify-self:end;
  align-self:center!important;
  min-width:max-content;
  gap:12px;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
  div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40 >div:last-child button[aria-label="Play"]{
  width:53px!important;
  height:53px!important;
  cursor:pointer!important;
}
/* Native picker group headings, warning banners, filters keep their semantics. */
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
  >div.relative.z-20 > header{padding-block:9px 15px;border-bottom:1px solid var(--v-12-edge);}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
  >div.relative.z-20 > header h1{
  font:760 clamp(33px,3.35vw,58px)/1.04 var(--v-display)!important;
  letter-spacing:-.05em!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
  >div.relative.z-20 button:focus-visible{outline:2px solid var(--v-ui-focus)!important;}



/* E. Remaining navigation categories: neutral shared typography, focus and
      active filters everywhere *except* the cinematic Films/Series/Anime hero.
      No blanket card, section or hero geometry changes. */
html[data-v-ready][data-v-page]:not([data-v-page="shows"]):not([data-v-page="movies"])
 main:not(.hset-main):not(.absolute) :is(input,select,textarea,button,[role="tab"],[role="menuitem"]){
  font-family:var(--v-text)!important;
}
html[data-v-ready][data-v-page]:not([data-v-page="shows"]):not([data-v-page="movies"])
 main:not(.hset-main):not(.absolute) :is([role="tab"],[aria-current="page"]):focus-visible{
  outline:2px solid var(--v-ui-focus)!important;outline-offset:2px;
}
html[data-v-ready] :is([role="dialog"],[role="menu"],[role="listbox"],[data-settings-menu])
 :is([role="tab"],[aria-selected="true"]):focus-visible{
  outline:2px solid var(--v-ui-focus)!important;outline-offset:2px;
}
/* Avoid massive font changes to hero logos, manga lettering, playback overlays,
   provider marks or physical media. The existing v23.11 type system remains. */
@media(max-width:980px){
  html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas > div.relative.z-20{
    padding-inline:clamp(16px,3vw,28px)!important;
  }
  html[data-v-ready] .harbor-settings-shell{
    --hset-pad-inline:clamp(17px,3vw,28px);
  }
}
@media(max-width:630px){
  html[data-v-ready] .harbor-settings-shell .hset-main .harbor-settings-section{
    padding:17px 14px!important;
  }
  html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header{
    padding:12px 4px 17px!important;gap:11px!important;
  }
  html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
   div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40{
    grid-template-columns:48px minmax(0,1fr);
    gap:10px!important;
    padding:12px!important;
  }
  html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
   div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40 > div:first-child{width:48px;}
  html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
   div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40 > div:last-child{
    grid-column:2;justify-self:start;
  }
  html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
   div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40 >div:last-child button[aria-label="Play"]{
    width:43px!important;height:43px!important;
  }
}
@media(prefers-reduced-motion:reduce){
  html[data-v-ready] #v-rail .v-navbtn,
  html[data-v-ready] .harbor-settings-shell .hset-rail-row,
  html[data-v-ready] .harbor-settings-shell .hset-rail-category{
    transition:none!important;
  }
}


/* Multi-field stream rows from alternate Harbor renderer variants: align extra
   audio/provider columns without assuming every version has the same fields. */
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
  div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40:has(>div:nth-child(4)):not(:has(>div:nth-child(5))){
  grid-template-columns:72px minmax(0,1.3fr) minmax(0,.9fr) auto;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
  div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40:has(>div:nth-child(5)){
  grid-template-columns:72px minmax(0,1.35fr) minmax(0,.9fr) minmax(0,.7fr) auto;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
  div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40 >div:nth-child(n+3):not(:last-child){
  min-width:0;max-width:100%;overflow-wrap:break-word;align-self:center;
}
@media(max-width:900px){
  html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
    div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40:has(>div:nth-child(4)){
      grid-template-columns:60px minmax(0,1fr) auto;
    }
  html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
    div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40:has(>div:nth-child(4)) >div:nth-child(n+3):not(:last-child){
      grid-column:2;align-self:start;
    }
  html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
    div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40:has(>div:nth-child(4)) >div:last-child{
      grid-column:3;grid-row:1;align-self:center;
    }
}
@media(max-width:630px){
  html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
    div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40:has(>div:nth-child(4)){
      grid-template-columns:48px minmax(0,1fr);
    }
  html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
    div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40:has(>div:nth-child(4)) >div:last-child{
      grid-column:2;grid-row:auto;justify-self:start;
    }
}



/* ============================================================================
   VOID v23.14 — Flat premium rollback + targeted cleanup
   Built from the v23.11 visual baseline. Intentionally never restyle the
   custom #v-rail structure, except for removing protruding active strips.
   No JS overrides, event listeners, or layout observers.
   ============================================================================ */
html[data-v-ready]{
  --v-premium-edge:rgba(255,255,255,.105);
  --v-premium-lift:rgba(255,255,255,.043);
  --v-premium-text:var(--color-ink);
}
/* 1 — The actual VOID sidebar: preserve v23.11 typography, backdrop,
   group spacing, navigation icons, motion and preset-specific accent colors.
   Remove the thin "tongue" protruding outside the selected row. */
html[data-v-ready] #v-rail .v-navbtn[data-active="true"]::before{
  content:none!important;display:none!important;
}
html[data-v-ready] #v-rail .v-navbtn[data-active="true"]{
  box-shadow:none!important;
}
html[data-v-ready] #v-rail .v-navbtn[data-active="true"] svg{
  color:var(--v-ui-accent, rgb(var(--v-ac-rgb)))!important;
}
/* 2 — Native Settings: restore its proper open rail, loose groups and
   original category sizes; don't wrap every group in a card. */
html[data-v-ready] .harbor-settings-shell{
  --hset-sidebar-bg:var(--color-surface);
  --hset-nav-w:288px;
  --hset-pad-inline:clamp(26px,3.5vw,64px);
  --hset-content-max:1050px;
}
html[data-v-ready] .harbor-settings-shell :is(.hset-tools,.hset-rail){
  background:var(--color-surface)!important;
}
html[data-v-ready] .harbor-settings-shell .hset-rail{
  border-inline-end:1px solid var(--v-premium-edge);
}
html[data-v-ready] .harbor-settings-shell .hset-rail-nav{
  padding-inline:0!important;
  gap:0!important;
}
html[data-v-ready] .harbor-settings-shell .hset-rail-band{
  border:0!important;
  box-shadow:none!important;
  padding:0!important;
  border-radius:9px!important;
}
html[data-v-ready] .harbor-settings-shell .hset-rail-band[data-open]{
  background:rgba(255,255,255,.031)!important;
}
html[data-v-ready] .harbor-settings-shell .hset-rail-category{
  box-shadow:none!important;
  border:0!important;
  border-radius:8px!important;
  color:var(--color-ink-muted);
  font-size:14.5px!important;
}
html[data-v-ready] .harbor-settings-shell .hset-rail-category:is(:hover,[aria-expanded="true"],.is-on){
  background:rgba(255,255,255,.052)!important;
  color:var(--color-ink)!important;
  box-shadow:none!important;
}
html[data-v-ready] .harbor-settings-shell .hset-category-pages{
  padding-inline:4px!important;
}
html[data-v-ready] .harbor-settings-shell :is(.hset-rail-row,.hset-rail-kid){
  box-sizing:border-box!important;
  min-width:0;
  border-radius:7px!important;
  font-size:13.5px!important;
  box-shadow:none!important;
  transform:none!important;
}
html[data-v-ready] .harbor-settings-shell :is(.hset-rail-row.is-on,.hset-rail-row[aria-current="page"]){
  background:rgba(255,255,255,.106)!important;
  border-color:transparent!important;
  box-shadow:none!important;
  color:var(--color-ink)!important;
}
html[data-v-ready] .harbor-settings-shell :is(.hset-rail-row.is-on,.hset-rail-row[aria-current="page"],.hset-rail-category.is-on)::before{
  content:none!important;display:none!important;
}
html[data-v-ready] .harbor-settings-shell .hset-rail-row.is-on .hset-rail-chip,
html[data-v-ready] .harbor-settings-shell .hset-rail-category[aria-expanded="true"] .hset-category-icon{
  color:var(--v-ui-accent,rgb(var(--v-ac-rgb)))!important;
}
html[data-v-ready] .harbor-settings-shell .hset-rail-me{
  box-shadow:none!important;
  border:1px solid rgba(255,255,255,.065)!important;
  background:transparent!important;
  border-radius:10px!important;
}
/* Center the *whole* search box in the sidebar. Preserve left-aligned text
   and search icon; Back keeps its own accessible native hit target. */
html[data-v-ready] .harbor-settings-shell .hset-tools{
  display:flex!important;
  flex-direction:column!important;
  justify-content:center!important;
  align-items:center!important;
  gap:5px!important;
  padding-inline:15px!important;
}
html[data-v-ready] .harbor-settings-shell .hset-tools > :has([data-settings-search-field]){
  width:100%!important;
  max-width:calc(var(--hset-nav-w) - 30px)!important;
  margin-inline:auto!important;
  align-self:center!important;
  flex:0 1 auto!important;
}
html[data-v-ready] .harbor-settings-shell .hset-tools [data-settings-search-field]{
  width:100%!important;
  margin-inline:auto!important;
  box-sizing:border-box;
  background:rgba(255,255,255,.037)!important;
  border:1px solid rgba(255,255,255,.065)!important;
  border-radius:8px!important;
}
html[data-v-ready] .harbor-settings-shell .hset-tools [data-settings-search-field] input{
  background:transparent!important;
  border:0!important;
  border-radius:0!important;
  width:100%;
  text-align:start!important;
  font-family:var(--v-text)!important;
}
html[data-v-ready] .harbor-settings-shell .hset-tools > button{
  align-self:flex-start!important;
  min-height:23px;
}
/* 3 — Settings body: studio layout with discreet horizontal rhythm rather
   than a screenful of floating AI-style cards. Keep native form structure. */
html[data-v-ready] .harbor-settings-shell .hset-heading{
  background:var(--color-canvas)!important;
  border-bottom:1px solid rgba(255,255,255,.06)!important;
}
html[data-v-ready] .harbor-settings-shell .hset-title{
  font-family:var(--v-display)!important;
  font-weight:730!important;
  font-size:clamp(27px,2.15vw,34px)!important;
  letter-spacing:-.045em!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main>.hset-content,
html[data-v-ready] .harbor-settings-shell .hset-heading>.hset-content{
  max-width:1000px!important;
  margin-inline:0!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main .harbor-settings-section{
  border:0!important;
  border-radius:0!important;
  box-shadow:none!important;
  background:transparent!important;
  padding:14px 0 25px!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main .harbor-settings-section + .harbor-settings-section{
  border-top:1px solid rgba(255,255,255,.085)!important;
  padding-top:24px!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main .hset-section-title{
  font-family:var(--v-display)!important;
  font-size:19px!important;
  font-weight:720!important;
  letter-spacing:-.025em!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main :is(.hset-field,.hset-source-options){
  border-radius:7px!important;
  background:rgba(255,255,255,.028)!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main :is(.hset-row-desc,.hset-row-note){
  color:var(--color-ink-muted)!important;
}
/* Leave the native selected geometry alone. An earlier generic aria-pressed
   rule created a duplicate/stretched selection tongue in the theme library.
   Only its *text* is normalized, not its background, dimensions, or position. */
html[data-v-ready] .harbor-settings-shell :is(button[aria-pressed="true"],button[aria-selected="true"]) {
  text-shadow:none!important;
}
/* Segmented Profile Songs: Harbor's white animated thumb uses dark text.
   This rule fixes the actual selected label without drawing another pill. */
html[data-v-ready] .harbor-settings-shell .hset-main div:has(>span.pointer-events-none.absolute.bg-ink):has(>button[aria-pressed]) > button[aria-pressed="true"]{
  color:var(--color-canvas)!important;
}
/* 4 — Social, generic utility and Catalogs: no gratuitous glossy cards.
   Native picker/layout is preserved, only geometry/tones unified. */
html[data-v-ready] :is(.harbor-together-surface,[role="menu"],[role="listbox"],[data-settings-menu]){
  border-radius:9px!important;
  box-shadow:0 18px 50px -28px rgba(0,0,0,.88)!important;
}
html[data-v-ready] .harbor-together-surface :is(button,input,textarea){
  border-radius:7px!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header{
  background:transparent!important;
  border-radius:0!important;
  box-shadow:none!important;
  border-inline:0!important;
  border-top:0!important;
  border-bottom:1px solid rgba(255,255,255,.085)!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header::before{
  content:none!important;
}
/* Uncluttered flat filters, follow the existing VOID color selections. */
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto>div>header :is(button,input){
  border-radius:7px!important;
}
/* Stream picker: keep the v23.13 native Back hitbox and stable metadata
   grid but remove excess decorative container rounding. */
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40{
  border-radius:8px!important;
}
@media(max-width:899px){
  /* Harbor stacks native browse rail on compact screens; do not make the
     Settings heading or fields overflow that layout. */
  html[data-v-ready] .harbor-settings-shell{--hset-nav-w:min(100vw,288px);}
  html[data-v-ready] .harbor-settings-shell .hset-tools{align-items:stretch!important;}
}
@media(prefers-reduced-motion:reduce){
  html[data-v-ready] .harbor-settings-shell :is(.hset-rail-row,.hset-rail-category){transition:none!important;}
}


/* 5 — Theme & appearance / My Library: replace native bright-white
   capsule tabs with a flat tab strip. Scoped to MarketSegmented's DOM.
   No extra pseudo-elements or selection layers are introduced. */
html[data-v-ready] .harbor-settings-shell .hset-main
 div.flex.w-fit.flex-wrap.items-center.gap-1.rounded-md.bg-elevated.p-1:has(>button.bg-ink.text-canvas){
   background:transparent!important;
   box-shadow:none!important;
   border:0!important;
   border-bottom:1px solid rgba(255,255,255,.10)!important;
   border-radius:0!important;
   padding:0!important;
   gap:13px!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main
 div.flex.w-fit.flex-wrap.items-center.gap-1.rounded-md.bg-elevated.p-1:has(>button.bg-ink.text-canvas)>button{
   background:transparent!important;
   border:0!important;
   border-bottom:2px solid transparent!important;
   border-radius:0!important;
   height:42px!important;
   padding:0 10px!important;
   margin-bottom:-1px;
   box-shadow:none!important;
   color:var(--color-ink-muted)!important;
   transition:color 120ms ease,border-color 120ms ease!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main
 div.flex.w-fit.flex-wrap.items-center.gap-1.rounded-md.bg-elevated.p-1:has(>button.bg-ink.text-canvas)>button.bg-ink.text-canvas{
   color:var(--color-ink)!important;
   border-bottom-color:rgba(255,255,255,.74)!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main
 div.flex.w-fit.flex-wrap.items-center.gap-1.rounded-md.bg-elevated.p-1:has(>button.bg-ink.text-canvas)>button:hover{
   color:var(--color-ink)!important;
}
/* Compact native MyLibraryFilters: muted selected filter, no white capsule.
   The text counter stays legible in the active state. */
html[data-v-ready] .harbor-settings-shell .hset-main
 div.flex.flex-wrap.items-center.gap-2:has(>div>input[aria-label="Search your library"])>button{
  border-radius:6px!important;
  background:rgba(255,255,255,.035)!important;
  color:var(--color-ink-muted)!important;
  border:1px solid transparent!important;
  box-shadow:none!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main
 div.flex.flex-wrap.items-center.gap-2:has(>div>input[aria-label="Search your library"])>button.bg-ink{
  background:rgba(255,255,255,.115)!important;
  color:var(--color-ink)!important;
  border-color:rgba(255,255,255,.14)!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main
 div.flex.flex-wrap.items-center.gap-2:has(>div>input[aria-label="Search your library"])>button.bg-ink>span{
  color:var(--color-ink-muted)!important;
}

/* ===========================================================================
   VOID v23.16 — SEAMLESS FROST / component-grounded restoration
   CSS-only refinement of v23.15. Retains VOID's working JS/HTML and native
   Harbor event handlers, themes, readers, player, posters, and original rail.
   Design contract: macro surfaces, no nested tile grids or harsh seams;
   restrained page-colored focus and hover. Keep meaningful status colors.
   =========================================================================== */
html[data-v-ready]{
  --v-seamless-ambient:rgba(var(--v-ac-rgb),.065);
  --v-seamless-veil:rgba(var(--v-bg-rgb),.94);
  --v-seamless-hover:rgba(255,255,255,.065);
  --v-seamless-border:rgba(255,255,255,.063);
  --v-seamless-hair:rgba(255,255,255,.038);
  --v-seamless-glass:linear-gradient(140deg,rgba(255,255,255,.039),rgba(255,255,255,.012) 37%,rgba(var(--v-bg-rgb),.88) 96%);
  --v-seamless-focus:rgba(var(--v-ac-rgb),.69);
}

/* 01 — Search: a single coherent frosted workspace, not three banded boxes.
   Directly targets Harbor SearchOverlay + EmptyState; preserves all actions. */
html[data-v-ready] [data-search-overlay="true"] .harbor-search-backdrop{
  background:rgba(0,0,0,.78)!important;
  backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
}
html[data-v-ready] [data-search-overlay="true"] > div.relative{
  max-width:1020px!important;
  padding:clamp(16px,4vh,42px) clamp(12px,3vw,28px)!important;
}
html[data-v-ready] [data-search-overlay="true"] > div.relative > .modal-panel{
  background:var(--v-seamless-glass),rgba(var(--v-bg-rgb),.965)!important;
  border:1px solid var(--v-seamless-border)!important;
  border-radius:12px!important;
  box-shadow:0 30px 96px -33px rgba(0,0,0,.97),inset 0 1px 0 rgba(255,255,255,.045)!important;
  overflow:hidden!important;
}
html[data-v-ready] [data-search-overlay="true"] > div.relative > .modal-panel::before{
  content:"VOID / SEARCH"!important;
  color:rgba(var(--v-ac-rgb),.71)!important;
  padding:23px 28px 0!important;
  font:650 10px/1.4 var(--v-text)!important;
  letter-spacing:.18em!important;
  background:none!important;
  border:0!important;
}
html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container]{
  min-height:76px!important;
  padding:4px 28px 10px!important;
  background:transparent!important;
  border:0!important;
  box-shadow:none!important;
}
html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container] input[type="text"]{
  height:57px!important;min-height:57px!important;
  color:var(--color-ink)!important;
  font:600 clamp(18px,2.1vw,23px)/1.25 var(--v-display)!important;
  letter-spacing:-.025em!important;
  background:transparent!important;border:0!important;box-shadow:none!important;
}
html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container] input[type="text"]:focus-visible{outline:none!important;}
html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container] > svg{color:rgb(var(--v-ac-rgb))!important;opacity:.7;}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-body{
  padding:0 28px 22px!important;
  background:transparent!important;
  box-shadow:none!important;
  overscroll-behavior:contain;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade{
  display:flex!important;flex-direction:column!important;
  gap:0!important;padding:0!important;
  background:transparent!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section{
  position:relative;
  padding:13px 0!important;
  margin:0!important;
  border:0!important;border-radius:0!important;
  background:none!important;box-shadow:none!important;
}
/* Kill *every* inherited pseudo-seam between native Search groups. */
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section::before,
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section::after{
  content:none!important;display:none!important;
  background:none!important;border:0!important;box-shadow:none!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section + section{
  border-top:0!important;border-bottom:0!important;
  box-shadow:none!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section h3{
  margin:0 0 8px!important;
  color:rgba(237,237,242,.54)!important;
  font:650 10px/1.4 var(--v-text)!important;
  letter-spacing:.17em!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(4){padding-bottom:8px!important;}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(4) > div:nth-child(2) > span{
  background:rgba(255,255,255,.032)!important;
  border:0!important;border-radius:4px!important;box-shadow:none!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div{
  display:grid!important;
  grid-template-columns:repeat(4,minmax(0,1fr))!important;
  gap:2px 8px!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div > button{
  width:100%;min-width:0;min-height:42px!important;height:auto!important;
  padding:7px 10px!important;gap:10px!important;
  display:flex!important;align-items:center!important;justify-content:flex-start!important;
  background:transparent!important;border:0!important;border-radius:4px!important;
  box-shadow:none!important;transform:none!important;
  font:580 13px/1.35 var(--v-text)!important;
  color:var(--color-ink-muted)!important;
  transition:color .14s ease,background-color .14s ease!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div > button:hover,
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div > button:focus-visible{
  background:var(--v-seamless-hover)!important;
  color:var(--color-ink)!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div > button > span{
  width:22px!important;min-width:22px;height:22px!important;
  background:transparent!important;color:rgba(var(--v-ac-rgb),.9)!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(3) > div > button > span svg{
  width:19px!important;height:19px!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(2) > div{gap:2px 5px!important;}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(2) > div > button{
  height:30px!important;min-height:30px!important;
  background:transparent!important;border:0!important;
  border-radius:3px!important;padding:0 9px!important;
  color:var(--color-ink-muted)!important;
  font:520 12px/1.3 var(--v-text)!important;
  box-shadow:none!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:nth-last-child(2) > div > button:hover{
  background:var(--v-seamless-hover)!important;color:var(--color-ink)!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:last-child{padding-top:9px!important;padding-bottom:4px!important;}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:last-child > button{
  min-height:40px!important;height:40px!important;
  background:rgba(var(--v-ac-rgb),.075)!important;
  border:0!important;border-radius:4px!important;box-shadow:none!important;
  color:var(--color-ink)!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade > section:last-child > button:hover{
  background:rgba(var(--v-ac-rgb),.14)!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-section{
  border:0!important;background:transparent!important;box-shadow:none!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-section button[aria-pressed]{
  border:0!important;border-radius:4px!important;background:transparent!important;
}
html[data-v-ready] [data-search-overlay="true"] .harbor-search-section button[aria-pressed="true"]{
  background:rgba(var(--v-ac-rgb),.11)!important;color:var(--color-ink)!important;
}

/* 02 — Settings is ONE continuous sheet. Remove apparent 'underlay' and
   low-opacity title, native rail divider and solid region mismatches. */
html[data-v-ready] .harbor-settings-shell{
  --hset-sidebar-bg:transparent!important;
  position:relative;
  background:linear-gradient(110deg,rgba(var(--v-ac-rgb),.011),transparent 47%),var(--color-canvas)!important;
  isolation:isolate;
}
html[data-v-ready] .harbor-settings-shell :is(.hset-grid,.hset-top-space,.hset-tools,.hset-heading,.hset-main,.hset-rail,#hset-page-navigation){
  background:transparent!important;
  background-image:none!important;
  border:0!important;
  border-inline-end:0!important;
  border-bottom:0!important;
  box-shadow:none!important;
}
html[data-v-ready] .harbor-settings-shell .hset-heading,
html[data-v-ready] .harbor-settings-shell .hset-main,
html[data-v-ready] .harbor-settings-shell .hset-rail{
  position:relative;
  z-index:1;
}
html[data-v-ready] .harbor-settings-shell .hset-tools{position:relative;z-index:2;}
html[data-v-ready] .harbor-settings-shell .hset-title{
  opacity:1!important;
  visibility:visible!important;
  filter:none!important;
  transform:none!important;
  color:var(--color-ink)!important;
  font:730 clamp(26px,2.2vw,34px)/1.2 var(--v-display)!important;
  letter-spacing:-.045em!important;
  text-shadow:none!important;
}
html[data-v-ready] .harbor-settings-shell .hset-heading::after,
html[data-v-ready] .harbor-settings-shell .hset-heading::before,
html[data-v-ready] .harbor-settings-shell .hset-main::before,
html[data-v-ready] .harbor-settings-shell .hset-main::after{
  content:none!important;display:none!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main > .hset-content{
  max-width:1050px!important;
  padding-bottom:54px;
}
html[data-v-ready] .harbor-settings-shell .hset-main .harbor-settings-section,
html[data-v-ready] .harbor-settings-shell .hset-main .harbor-settings-section + .harbor-settings-section{
  background:transparent!important;
  box-shadow:none!important;
  border:0!important;
  border-top:0!important;border-bottom:0!important;
  padding:12px 0 25px!important;
  margin:0!important;
  border-radius:0!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main .harbor-settings-section + .harbor-settings-section{padding-top:31px!important;}
html[data-v-ready] .harbor-settings-shell .hset-main .harbor-settings-section::before,
html[data-v-ready] .harbor-settings-shell .hset-main .harbor-settings-section::after{
  content:none!important;display:none!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main .hset-section-title{
  font:670 19px/1.23 var(--v-display)!important;
  letter-spacing:-.025em!important;
}
html[data-v-ready] .harbor-settings-shell .hset-main :is(input,textarea,select)[class*="bg-elevated"],
html[data-v-ready] .harbor-settings-shell .hset-main :is(.hset-field,.hset-source-options){
  background:rgba(255,255,255,.022)!important;
  border-color:rgba(255,255,255,.055)!important;
  border-radius:5px!important;
  box-shadow:none!important;
}
/* Keep identity swatches, provider marks, and animated native segmented thumb. */
html[data-v-ready] .harbor-settings-shell .hset-main div:has(>span.pointer-events-none.absolute.bg-ink):has(>button[aria-pressed]) > button[aria-pressed="true"]{
  color:var(--color-canvas)!important;
}
/* Preserve original VOID rail geometry and color-marked icons, only remove seam. */
html[data-v-ready] .harbor-settings-shell .hset-rail-band[data-open]{background:rgba(255,255,255,.023)!important;}
html[data-v-ready] .harbor-settings-shell :is(.hset-rail-category,.hset-rail-row,.hset-rail-kid):hover{
  background:rgba(255,255,255,.056)!important;
}
html[data-v-ready] .harbor-settings-shell :is(.hset-rail-row.is-on,.hset-rail-row[aria-current="page"]){
  background:rgba(255,255,255,.092)!important;
}
html[data-v-ready] .harbor-settings-shell :is(.hset-rail-row.is-on,.hset-rail-row[aria-current="page"],.hset-rail-category.is-on)::before{
  content:none!important;display:none!important;
}
/* Do not cover the rail with a backdrop or blur filter: its input and links
   must remain fully clickable, and share the same material as the content. */
html[data-v-ready] .harbor-settings-shell :is(.hset-tools,.hset-rail,.hset-heading){
  backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
}

/* 03 — Content lists: preserve media geometry, remove nested UI boxes.
   Prefer quiet hover field and page accents over cards within cards. */
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto >div>header{
  background:transparent!important;
  background-image:none!important;
  border:0!important;border-bottom:0!important;
  box-shadow:none!important;
  border-radius:0!important;
  padding:4px 0 15px!important;
  gap:12px!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto >div>header::before,
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto >div>header::after{
  content:none!important;display:none!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto >div>header :is(input,button){
  box-shadow:none!important;border-radius:5px!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto >div>header button:not(.bg-ink){
  background:rgba(255,255,255,.026)!important;
  border-color:rgba(255,255,255,.051)!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto >div>header button:not(.bg-ink):hover{
  background:var(--v-seamless-hover)!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto >div>header h1{
  color:var(--color-ink)!important;opacity:1!important;
}
/* Stream picker: keep wide 23.13 metadata grid and native back hit target;
   only its utility material is made consistent here. */
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas >div.relative.z-20 >header{
  border:0!important;background:transparent!important;border-radius:0!important;
  box-shadow:none!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40{
  background:rgba(255,255,255,.023)!important;
  border:1px solid rgba(255,255,255,.047)!important;
  border-radius:6px!important;
  box-shadow:none!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas div.flex.items-stretch.gap-5.rounded-2xl.bg-elevated\/40:hover{
  background:rgba(255,255,255,.055)!important;
  border-color:rgba(var(--v-ac-rgb),.18)!important;
}
/* Utility accent hover/selection: NO new pills, no item accent 'tongues'.
   Limit to native small UI tabs/filters, never posters, hero Play, or reader. */
html[data-v-ready][data-v-page] main:not(.harbor-detail-enter):not(.absolute):not(.hset-main) [role="tablist"] >[role="tab"]:is([aria-selected="true"],[data-state="active"]){
  color:rgb(var(--v-ac-rgb))!important;
}
html[data-v-ready][data-v-page] main:not(.harbor-detail-enter):not(.absolute):not(.hset-main) :is(input[type="search"],input[placeholder*="Search"],input[placeholder*="search"]):focus-visible{
  outline:1px solid var(--v-seamless-focus)!important;
  outline-offset:1px!important;
  border-color:rgba(var(--v-ac-rgb),.27)!important;
}
html[data-v-ready] :is(.harbor-search-body,.harbor-settings-shell .hset-main,.harbor-together-surface,[role="menu"],[role="listbox"])
 :is(button,input,textarea,select):focus-visible{
  outline:2px solid var(--v-seamless-focus)!important;
  outline-offset:2px!important;
}
/* Reuse VOID page accent in small selected controls; do not steal
   semantic warning/error/success or service-brand colors. */
html[data-v-ready]:is([data-v-page="catalogs"],[data-v-page="calendar"],[data-v-page="downloads"],
 [data-v-page="library"],[data-v-page="collections"],[data-v-page="addons"],[data-v-page="music"],
 [data-v-page="games"],[data-v-page="manga"],[data-v-page="ebook"],[data-v-page="live"],
 [data-v-page="sports"],[data-v-page="discover"])
 main:not(.harbor-detail-enter):not(.absolute):not(.hset-main)
 :is(button[aria-selected="true"],button[aria-current="page"]):not(.bg-ink):not([class*="bg-danger"]){
  color:rgb(var(--v-ac-rgb))!important;
}
/* Apply consistent feedback to native utility buttons in every category,
   without changing layout or creating an expensive hover compositor. */
html[data-v-ready][data-v-page] main:not(.harbor-detail-enter):not(.absolute):not(.hset-main)
 :is(button[class*="border-edge-soft"][class*="bg-elevated"],button[class*="border-edge-soft"][class*="bg-canvas"]){
  border-color:var(--v-seamless-border)!important;
  box-shadow:none!important;
  transition:background-color .15s ease,color .15s ease,border-color .15s ease!important;
}
html[data-v-ready][data-v-page] main:not(.harbor-detail-enter):not(.absolute):not(.hset-main)
 :is(button[class*="border-edge-soft"][class*="bg-elevated"],button[class*="border-edge-soft"][class*="bg-canvas"]):hover{
  background:var(--v-seamless-hover)!important;
  border-color:rgba(var(--v-ac-rgb),.19)!important;
}
/* Shared panel material: one macro pane per real overlay, not a nested stack. */
html[data-v-ready] :is(.harbor-together-surface,.harbor-profile-dropdown,[role="menu"],[role="listbox"],[data-settings-menu]){
  background:var(--v-seamless-glass),rgba(var(--v-bg-rgb),.955)!important;
  border:1px solid var(--v-seamless-border)!important;
  border-radius:9px!important;
  box-shadow:0 20px 65px -27px rgba(0,0,0,.95),inset 0 1px 0 rgba(255,255,255,.035)!important;
}
html[data-v-ready] :is(.harbor-together-surface,[role="menu"],[role="listbox"],[data-settings-menu])
 :is(button,input,textarea){border-radius:5px!important;}
/* Calendar is often the clearest leftover horizontal divider. */
html[data-v-ready][data-v-page="calendar"] main.flex.h-full.flex-col.overflow-hidden >header.shrink-0{
  border:0!important;box-shadow:none!important;
  background:linear-gradient(180deg,rgba(255,255,255,.012),transparent)!important;
}
html[data-v-ready][data-v-page="addons"] main[data-tv-chrome-offset]>header{
  border:0!important;box-shadow:none!important;background:transparent!important;
}
html[data-v-ready][data-v-page="downloads"] main >div.mx-auto>header.mb-6{
  border:0!important;box-shadow:none!important;background:transparent!important;
}
/* Preserve the intentionally cinematic Series and film heroes; never apply
   generic card corner or heading pseudo rules to the hero containers. */

/* Category-specific finishing: source-verified native controls, not
   broad poster/media selectors. These unify accents without adding tiles. */
html[data-v-ready][data-v-page="addons"] main[data-tv-chrome-offset] >header nav button.bg-ink{
  background:rgba(var(--v-ac-rgb),.12)!important;
  color:var(--color-ink)!important;
  box-shadow:none!important;
}
html[data-v-ready][data-v-page="downloads"] .harbor-download-selection-panel{
  border-color:var(--v-seamless-border)!important;
  box-shadow:none!important;
}
html[data-v-ready][data-v-page="collections"] main.absolute.inset-0.z-30.overflow-y-auto.bg-canvas
 [data-tv-chrome-offset]>button{
  background:rgba(255,255,255,.027)!important;
  border:0!important;border-radius:6px!important;
  box-shadow:none!important;
}
html[data-v-ready]:is([data-v-page="manga"],[data-v-page="ebook"])
 main:not(.absolute):not(.hset-main)
 :is(input[type="search"],input[placeholder*="Search"],input[placeholder*="search"]){
  background:rgba(255,255,255,.025)!important;
  border-color:var(--v-seamless-border)!important;
  border-radius:5px!important;
}
html[data-v-ready][data-v-page="music"] main:not(.absolute) [role="tablist"]>button{
  border-radius:4px!important;box-shadow:none!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
 [role="group"][aria-label="Source mode"]{
  background:rgba(255,255,255,.024)!important;
  border:1px solid var(--v-seamless-border)!important;
  border-radius:5px!important;
  box-shadow:none!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
 [role="group"][aria-label="Source mode"]>button{
  border-radius:3px!important;border:0!important;box-shadow:none!important;
}
html[data-v-ready] main.absolute.inset-0.z-60.overflow-y-auto.bg-canvas
 [role="group"][aria-label="Source mode"]>button[aria-pressed="true"]{
  background:rgba(var(--v-ac-rgb),.12)!important;
  color:var(--color-ink)!important;
}

/* 04 — Native detail-page Play + Watchlist: bring the established dual-action
   design outside Home. Actual component: PlayModeHint span + HoverTooltip div.
   No new buttons, no copied handlers, no DOM rearranging. The other CTAs,
   when present (AniList, MAL, etc.), keep their own native spacing. */
html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
 div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex > button.bg-ink):has(>div.relative.inline-flex >button){
  gap:0!important;
  flex-wrap:wrap;
  width:max-content;
  max-width:100%;
}
html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
 div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
 >span.relative.inline-flex:first-child{
  min-height:62px!important;
  padding:5px 0 5px 5px;
  border:1px solid rgba(255,255,255,.13);
  border-right:0;
  border-radius:999px 0 0 999px;
  background:var(--v-glass),rgba(var(--v-bg-rgb),.65);
  box-shadow:0 14px 36px -22px rgba(0,0,0,.9),inset 0 1px rgba(255,255,255,.075);
}
html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
 div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
 >div.relative.inline-flex:nth-child(2){
  min-height:62px!important;
  padding:5px 5px 5px 0;
  border:1px solid rgba(255,255,255,.13);
  border-left:0;
  border-radius:0 999px 999px 0;
  background:var(--v-glass),rgba(var(--v-bg-rgb),.65);
  box-shadow:0 14px 36px -22px rgba(0,0,0,.9),inset 0 1px rgba(255,255,255,.075);
}
html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
 div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
 >span.relative.inline-flex:first-child >button{
  min-width:176px!important;
  height:50px!important;
  padding:0 22px!important;
  border-radius:999px!important;
  background:linear-gradient(180deg,#f9f9fb,#e0e0e5)!important;
  color:#060607!important;
  transform:none!important;
  box-shadow:inset 0 -1px rgba(0,0,0,.08)!important;
  white-space:nowrap;
}
html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
 div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
 >div.relative.inline-flex:nth-child(2)>button{
  min-width:176px!important;
  height:50px!important;
  padding:0 19px!important;
  border-radius:999px!important;
  background:transparent!important;
  color:var(--color-ink)!important;
  box-shadow:none!important;
  transform:none!important;
  white-space:nowrap;
}
html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
 div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
 >div.relative.inline-flex:nth-child(2)>button:hover{
  background:rgba(var(--v-ac-rgb),.11)!important;
}
html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
 div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)>:nth-child(n+3){
  margin-inline-start:12px;
}
/* Detail pages can have extra source-specific CTAs. Preserve their order
   and horizontal rhythm rather than stretching a parent-wide capsule. */

/* Anime landing hero: its two native actions are "Start Watching" and
   "Save for later". Visually connect them to the same premium action family.
   The Series PeekHero remains unchanged, by design. */
html[data-v-ready][data-v-cta="on"] .harbor-anime-hero
 div.mt-1.flex.items-center.gap-3:has(>button.bg-ink):has(>button[aria-pressed]){
  gap:0!important;
}
html[data-v-ready][data-v-cta="on"] .harbor-anime-hero
 div.mt-1.flex.items-center.gap-3:has(>button.bg-ink)>button:first-child{
  min-height:52px!important;
  border:1px solid rgba(255,255,255,.13)!important;
  border-radius:999px 0 0 999px!important;
  background:linear-gradient(180deg,#f7f7fa,#e0e0e6)!important;
  color:#080809!important;
  padding-inline:23px!important;
  box-shadow:none!important;
  transform:none!important;
}
html[data-v-ready][data-v-cta="on"] .harbor-anime-hero
 div.mt-1.flex.items-center.gap-3:has(>button.bg-ink)>button:nth-child(2)[aria-pressed]{
  min-height:52px!important;height:52px!important;
  min-width:62px!important;width:62px!important;
  border:1px solid rgba(255,255,255,.13)!important;
  border-left:0!important;
  border-radius:0 999px 999px 0!important;
  background:rgba(var(--v-bg-rgb),.72)!important;
  color:rgba(255,255,255,.9)!important;
  box-shadow:none!important;
  transform:none!important;
}
html[data-v-ready][data-v-cta="on"] .harbor-anime-hero
 div.mt-1.flex.items-center.gap-3:has(>button.bg-ink)>button:nth-child(2)[aria-pressed="true"]{
  color:rgb(var(--v-ac-rgb))!important;
  background:rgba(var(--v-ac-rgb),.12)!important;
}
html[data-v-ready][data-v-cta="on"] .harbor-anime-hero
 div.mt-1.flex.items-center.gap-3:has(>button.bg-ink)>span:nth-child(n+3){
  margin-inline-start:15px;
}

/* 05 — Density and responsiveness. No eager blur on entire pages; no
   observers, timers, animations or per-card CSS filters. */
@media(max-width:900px){
  html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade >section:nth-last-child(3)>div{
    grid-template-columns:repeat(3,minmax(0,1fr))!important;
  }
}
@media(max-width:620px){
  html[data-v-ready] [data-search-overlay="true"] >div.relative{padding:9px!important;}
  html[data-v-ready] [data-search-overlay="true"] >div.relative>.modal-panel{max-height:calc(100dvh - 18px);}
  html[data-v-ready] [data-search-overlay="true"] >div.relative>.modal-panel::before{padding:15px 16px 0!important;}
  html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container]{padding:0 16px 6px!important;min-height:64px!important;}
  html[data-v-ready] [data-search-overlay="true"] [data-tv-focus-container] input[type="text"]{height:50px!important;min-height:50px!important;font-size:17px!important;}
  html[data-v-ready] [data-search-overlay="true"] .harbor-search-body{padding:0 16px 17px!important;}
  html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade >section:nth-last-child(3)>div{
    grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:1px 6px!important;
  }
  html[data-v-ready] [data-search-overlay="true"] .harbor-search-cascade >section:nth-last-child(3)>div>button{
    min-height:40px!important;padding:7px!important;font-size:12px!important;
  }
  html[data-v-ready] .harbor-settings-shell .hset-main .harbor-settings-section{
    padding:11px 0 21px!important;
  }
  html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
   div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink){
    flex-wrap:wrap;gap:6px!important;
  }
  html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
   div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
   >span.relative.inline-flex:first-child,
  html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
   div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
   >div.relative.inline-flex:nth-child(2){
    padding:0;border:0;background:transparent;border-radius:0;box-shadow:none;
  }
  html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
   div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
   >span.relative.inline-flex:first-child >button,
  html[data-v-ready][data-v-cta="on"] main.harbor-detail-enter
   div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
   >div.relative.inline-flex:nth-child(2) >button{
    min-width:128px!important;height:46px!important;padding:0 12px!important;
  }
}
@supports(backdrop-filter:blur(10px)){
  html[data-v-ready][data-v-performance="off"] [data-search-overlay="true"] >div.relative>.modal-panel,
  html[data-v-ready][data-v-performance="off"] .harbor-together-surface{
    backdrop-filter:blur(10px)!important;
    -webkit-backdrop-filter:blur(10px)!important;
  }
}
html[data-v-performance="on"] :is([data-search-overlay="true"] >div.relative>.modal-panel,.harbor-together-surface){
  backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
}
@media(prefers-reduced-motion:reduce){
  html[data-v-ready] [data-search-overlay="true"] >div.relative>.modal-panel,
  html[data-v-ready] .harbor-together-surface{
    backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
  }
}



/* ==========================================================================
   VOID v23.17 | Signature Frost
   Graphic rule: continuous black pane, legible signature display, softly
   accented functions, deliberate Apple-like UTILITY pills (not poster cards).
   Follows Harbor component structure. No new script, timers or observers.
   ========================================================================== */

/* 01 / Identity. Syne gives VOID an editorial, geometric headline voice.
   Regular interface text stays Inter; cassette writing and brand marks stay
   isolated. Keep Windows-friendly, readable local fallback. */
html[data-v-ready]{
  --v-display:'Syne','Inter Tight','Bahnschrift','Segoe UI',sans-serif;
  --font-display:var(--v-display);
  --v17-pill-glass:linear-gradient(165deg,rgba(255,255,255,.066),rgba(255,255,255,.019) 84%);
  --v17-pill-border:rgba(255,255,255,.125);
  --v17-pill-hover:linear-gradient(165deg,rgba(255,255,255,.105),rgba(255,255,255,.044));
  --v17-pill-shadow:inset 0 1px 0 rgba(255,255,255,.044),0 4px 14px -11px #000;
}
/* Harbor's main page headings are not all located in a direct <header>. */
html[data-v-ready] :is(
  main:not(.harbor-detail-enter):not(.absolute) h1.font-display,
  main:not(.harbor-detail-enter):not(.absolute) > div > header h1,
  .harbor-settings-shell .hset-title,
  html[data-v-page="catalogs"] main.flex-1.overflow-y-auto > div > header h1,
  html[data-v-page="downloads"] main > div > header h1,
  html[data-v-page="calendar"] main > header h1,
  html[data-v-page="library"] main header h1,
  html[data-v-page="collections"] main h1,
  html[data-v-page="manga"] main h1,
  html[data-v-page="ebook"] main h1,
  html[data-v-page="addons"] main h1,
  .v-hub-title
){
  font-family:var(--v-display)!important;
  font-weight:700!important;
  font-synthesis:none;
  letter-spacing:-.052em!important;
  line-height:1.06;
}
/* Catalogs is the most visible native heading previously stuck on Inter.
   Don't accidentally restyle the hero wordmarks in Movies / Series. */
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto > div > header h1{
  font-size:clamp(34px,2.8vw,45px)!important;
  letter-spacing:-.06em!important;
}
/* Native section headings get the same type family at a smaller scale.
   Existing poster titles, book titles, artist names, and movie logos are exempt. */
html[data-v-ready]:is([data-v-page="catalogs"],[data-v-page="library"],[data-v-page="collections"],
  [data-v-page="downloads"],[data-v-page="calendar"],[data-v-page="addons"],
  [data-v-page="discover"],[data-v-page="games"],[data-v-page="ebook"],
  [data-v-page="manga"],[data-v-page="music"])
  main:not(.absolute):not(.harbor-detail-enter) section > div:first-child > h2,
html[data-v-ready] .harbor-settings-shell .hset-main .hset-section-title{
  font-family:var(--v-display)!important;
  font-weight:650!important;
  letter-spacing:-.032em!important;
}
/* These are intentionally restrained, not bright stripes or left-edge tongues.
   VOID keeps the user's seven moods and existing per-page accent switch. */
html[data-v-accent="on"][data-v-page="discover"]{--v-ac-rgb:157,189,207;}
html[data-v-accent="on"][data-v-page="catalogs"]{--v-ac-rgb:146,193,210;}
html[data-v-accent="on"][data-v-page="addons"]{--v-ac-rgb:178,156,208;}
html[data-v-accent="on"][data-v-page="ebook"]{--v-ac-rgb:189,174,218;}
html[data-v-accent="on"][data-v-page="settings"]{--v-ac-rgb:145,188,179;}
html[data-v-accent="on"][data-v-page="home"]{--v-ac-rgb:180,184,200;}
html[data-v-ready][data-v-accent="on"]:is([data-v-page="catalogs"],[data-v-page="addons"],
 [data-v-page="calendar"],[data-v-page="downloads"],[data-v-page="library"],[data-v-page="collections"],
 [data-v-page="ebook"],[data-v-page="manga"],[data-v-page="music"],[data-v-page="games"],
 [data-v-page="live"],[data-v-page="sports"],[data-v-page="discover"],[data-v-page="settings"])
 :is(main:not(.absolute):not(.harbor-detail-enter),.hset-main)
 :is(button[aria-pressed="true"],button[aria-selected="true"],button[aria-current="page"])
 :not([class*="bg-ink"]):not([class*="danger"]):not([class*="amber"]):not([class*="emerald"]){
  border-color:rgba(var(--v-ac-rgb),.22)!important;
}
html[data-v-ready][data-v-accent="on"]:is([data-v-page="catalogs"],[data-v-page="addons"],
 [data-v-page="calendar"],[data-v-page="downloads"],[data-v-page="library"],[data-v-page="collections"],
 [data-v-page="ebook"],[data-v-page="manga"],[data-v-page="music"],[data-v-page="games"],
 [data-v-page="live"],[data-v-page="sports"],[data-v-page="discover"])
 main:not(.absolute):not(.harbor-detail-enter)
 :is(header,nav) button:not([disabled]):hover :is(svg,[class*="text-accent"]){
  color:rgb(var(--v-ac-rgb));
}

/* 02 / Manga: VOID's own gloss was already disabled, but Harbor has another
   independent poster-card hover shine. Remove BOTH on Manga only. The cover,
   spine, bookmark, and side-page riffle must remain working and fully visible. */
html[data-v-ready][data-v-page="manga"] .v-book-gloss,
html[data-v-ready][data-v-page="manga"] [style*="linear-gradient(105deg"],
html[data-v-ready][data-v-page="manga"] [style*="linear-gradient(105deg,"]{
  display:none!important;
  visibility:hidden!important;
  animation:none!important;
  transition:none!important;
}
html[data-v-ready][data-v-page="manga"] .harbor-card-ring::after{
  content:none!important;display:none!important;
  animation:none!important;
  box-shadow:none!important;
}
/* Native PosterBody also mounts a shimmer span while artwork decodes;
   remove that Manga-only flash, without hiding the loaded image. */
html[data-v-ready][data-v-page="manga"] .harbor-shimmer{
  display:none!important;animation:none!important;
}
/* Avoid hover-triggered brightness flash without disabling the actual book. */
html[data-v-ready][data-v-page="manga"] :is([data-v-book-cover],.harbor-poster-img){
  filter:none!important;
  -webkit-filter:none!important;
}
html[data-v-ready][data-v-page="manga"] [data-v-book-cover] .harbor-poster-img{
  backface-visibility:visible!important;
  -webkit-backface-visibility:visible!important;
}

/* 03 / Shared premium UTILITY pills. Only controls already designed as pills,
   within top navigation, filter strips, or toolbar zones. Never replace the
   sidebar, posters, manga chapters, native Play buttons or visualizer. */
html[data-v-ready][data-v-page] main:not(.absolute):not(.harbor-detail-enter):not(.hset-main)
 :is(header,nav) button[class*="rounded-full"][class*="border"]:not(.bg-ink):not([class*="absolute"]):not([class*="w-10"]):not([class*="w-11"]):not([class*="w-12"]),
html[data-v-ready][data-v-page] main:not(.absolute):not(.harbor-detail-enter):not(.hset-main)
 [role="tablist"] > button[class*="rounded-full"]:not([class*="w-10"]){
  border-radius:999px!important;
  border:1px solid var(--v17-pill-border)!important;
  background:var(--v17-pill-glass)!important;
  box-shadow:var(--v17-pill-shadow)!important;
  min-height:36px;
  padding-inline:clamp(13px,1.1vw,18px)!important;
  white-space:nowrap;
  transition:background-color .16s ease,border-color .16s ease,color .16s ease!important;
}
html[data-v-ready][data-v-page] main:not(.absolute):not(.harbor-detail-enter):not(.hset-main)
 :is(header,nav) button[class*="rounded-full"][class*="border"]:not([class*="absolute"]):hover,
html[data-v-ready][data-v-page] main:not(.absolute):not(.harbor-detail-enter):not(.hset-main)
 [role="tablist"] > button[class*="rounded-full"]:hover{
  border-color:rgba(var(--v-ac-rgb),.25)!important;
  background:var(--v17-pill-hover)!important;
}
/* Native pill-based filter panels used outside headers. Leave layout alone. */
html[data-v-ready]:is([data-v-page="catalogs"],[data-v-page="downloads"],[data-v-page="addons"],
 [data-v-page="library"],[data-v-page="calendar"],[data-v-page="games"],[data-v-page="collections"])
 main:not(.absolute):not(.harbor-detail-enter)
 button[class*="rounded-full"][class*="border-edge-soft"]:not(.bg-ink):not([class*="w-10"]):not([class*="w-11"]):not([class*="h-7"]){
  border-radius:999px!important;
  background:var(--v17-pill-glass)!important;
  border:1px solid var(--v17-pill-border)!important;
  box-shadow:var(--v17-pill-shadow)!important;
}
/* Prevent accidental white-on-white when Harbor marks the selected tab with
   bg-ink (e.g. Catalogs All). White-selected buttons remain clearly legible. */
html[data-v-ready] main button.bg-ink.text-canvas,
html[data-v-ready] main button.bg-ink[class*="text-canvas"]{
  color:var(--color-canvas)!important;
}
/* Soft category accents for active utility pills, not poster or hero CTAs. */
html[data-v-ready][data-v-accent="on"][data-v-page]
 main:not(.absolute):not(.harbor-detail-enter):not(.hset-main)
 :is(header,nav) button[aria-pressed="true"]:not([class*="bg-ink"]),
html[data-v-ready][data-v-accent="on"][data-v-page]
 main:not(.absolute):not(.harbor-detail-enter):not(.hset-main)
 [role="tablist"] > button[aria-selected="true"]:not([class*="bg-ink"]){
  background:linear-gradient(160deg,rgba(var(--v-ac-rgb),.14),rgba(var(--v-ac-rgb),.035))!important;
  border-color:rgba(var(--v-ac-rgb),.28)!important;
  color:var(--color-ink)!important;
}

/* 04 / Catalog Browser: native component has an outer rounded-2xl shell with
   8px gap and padding that previous rounds compressed. Make the shell vanish,
   preserve focusable Type/Catalog/Genre controls, and give Browse room. */
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto > div > header
  div.flex.w-fit.max-w-full.flex-wrap.items-center.gap-2.rounded-2xl{
  display:flex!important;
  gap:clamp(10px,1vw,16px)!important;
  row-gap:12px!important;
  padding:5px 0!important;
  border:0!important;
  border-radius:0!important;
  background:transparent!important;
  box-shadow:none!important;
  --tw-ring-shadow:0 0 transparent!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto > div > header
  div.flex.w-fit.max-w-full.flex-wrap.items-center.gap-2.rounded-2xl > div.relative > button,
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto > div > header
  div.flex.w-fit.max-w-full.flex-wrap.items-center.gap-2.rounded-2xl > button{
  height:40px!important;
  min-height:40px!important;
  border-radius:999px!important;
  box-shadow:var(--v17-pill-shadow)!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto > div > header
  div.flex.w-fit.max-w-full.flex-wrap.items-center.gap-2.rounded-2xl > div.relative > button{
  padding-inline:17px!important;
  border:1px solid var(--v17-pill-border)!important;
  background:var(--v17-pill-glass)!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto > div > header
  div.flex.w-fit.max-w-full.flex-wrap.items-center.gap-2.rounded-2xl > button:last-child{
  margin-inline-start:4px!important;
  padding-inline:22px!important;
}
/* Search filters and custom nav groups use gap-1.5: make the buttons breathe. */
html[data-v-ready]:is([data-v-page="catalogs"],[data-v-page="downloads"],[data-v-page="addons"],
 [data-v-page="library"],[data-v-page="calendar"],[data-v-page="games"],[data-v-page="collections"])
 main:not(.absolute) :is(header,nav) .flex.flex-wrap:has(> button){
  column-gap:10px!important;
  row-gap:9px!important;
}
html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto > div > header > div.flex.flex-col.gap-3{
  gap:14px!important;
}
/* Search field and browse filter should not collide at intermediate widths. */
@media(max-width:980px){
  html[data-v-ready][data-v-page="catalogs"] main.flex-1.overflow-y-auto > div > header
  div.flex.w-fit.max-w-full.flex-wrap.items-center.gap-2.rounded-2xl{
    gap:11px!important;
  }
}

/* 05 / Native route-specific controls: unify tactile pill style across the
   tabs that exist in Harbor, without the AI-style pane-within-pane pattern. */
html[data-v-ready][data-v-page="addons"] main[data-tv-chrome-offset] > header nav > button,
html[data-v-ready][data-v-page="downloads"] main > div.mx-auto > div.mb-5 button[class*="rounded-full"],
html[data-v-ready][data-v-page="calendar"] main > header button[class*="rounded-full"],
html[data-v-ready][data-v-page="collections"] main [data-tv-chrome-offset] > button[class*="rounded-full"]{
  border-radius:999px!important;
  border:1px solid var(--v17-pill-border)!important;
  background:var(--v17-pill-glass)!important;
  box-shadow:var(--v17-pill-shadow)!important;
}
/* Keep selected / primary actions prominent rather than forcing every pill
   to the same background. This also stops unintentional emphasis inversion. */
html[data-v-ready][data-v-page="addons"] main[data-tv-chrome-offset] > header nav > button.bg-ink,
html[data-v-ready][data-v-page="downloads"] main > div.mx-auto button.bg-ink{
  background:var(--color-ink)!important;
  color:var(--color-canvas)!important;
}
/* Settings & modal selection stays flat and text-led, never an accent tongue. */
html[data-v-ready] .harbor-settings-shell :is(.hset-rail-row,.hset-category-pages button){
  box-shadow:none!important;
}

/* 06 / Make reduced-motion/Performance mode a first-class case. */
@media(prefers-reduced-motion:reduce){
  html[data-v-ready] main :is(header,nav) button{transition:none!important;}
}
html[data-v-performance="on"] main :is(header,nav) button{box-shadow:none!important;}

/* ========================================================================
   VOID v23.18 — SIGNATURE CONSISTENCY / FINAL COMPONENT PASS
   Grounded in native CinemaHero, PeekHero, AnimeHero, PlayPicker, and actual
   category headers. Cosmetic only: no DOM mutation, fetch, event or animation.
   ======================================================================== */

/* 01. The VOID signature is editorial Syne + readable Inter. Harbor page
   implementations differ: some use .font-display, others ordinary h1/h2.
   Scope carefully to headings, NOT poster captions, movie-logo images,
   cassette typography, marketing graphics, or media branding. */
html[data-v-ready]{
  --v-display:'Syne','Inter Tight','Bahnschrift','Segoe UI',sans-serif;
  --v-text:'Inter','Segoe UI',system-ui,sans-serif;
  --font-display:var(--v-display);
  --font-sans:var(--v-text);
  --v18-glass:linear-gradient(160deg,rgba(255,255,255,.076),rgba(255,255,255,.024) 74%);
  --v18-rim:rgba(255,255,255,.15);
  --v18-rim-hover:rgba(255,255,255,.23);
}
/* Main native page mastheads and native/settings page titles. */
html[data-v-ready][data-v-page]
 main:not(.harbor-detail-enter):not([data-harbor-player])
 :is(h1,h2).font-display,
html[data-v-ready][data-v-page]
 main:not(.harbor-detail-enter):not([data-harbor-player]) > div > header h1,
html[data-v-ready][data-v-page]
 main:not(.harbor-detail-enter):not([data-harbor-player]) > header h1,
html[data-v-ready][data-v-page]
 main:not(.harbor-detail-enter):not([data-harbor-player]) > div > div > header h1,
html[data-v-ready] .harbor-settings-shell .hset-title,
html[data-v-ready] .v-hub-title{
  font-family:var(--v-display)!important;
  font-weight:700!important;
  font-synthesis:none;
  letter-spacing:-.047em!important;
}
/* Film and Series page shelf headings, without touching the artwork-based
   hero logo or smaller poster/episode titles. */
html[data-v-ready]:is([data-v-page="movies"],[data-v-page="shows"],[data-v-page="anime"],
 [data-v-page="home"],[data-v-page="discover"],[data-v-page="catalogs"],
 [data-v-page="library"],[data-v-page="collections"],[data-v-page="downloads"],
 [data-v-page="calendar"],[data-v-page="addons"],[data-v-page="ebook"],
 [data-v-page="manga"],[data-v-page="music"],[data-v-page="games"],
 [data-v-page="live"],[data-v-page="sports"])
 main:not(.harbor-detail-enter) :is(.harbor-row-shell > h3,.harbor-row-shell header h3,
   section > h2,section > div:first-child > h2,
   header > h2):not([class*="sr-only"]){
  font-family:var(--v-display)!important;
  font-weight:700!important;
  letter-spacing:-.032em!important;
  font-synthesis:none;
}
/* Typography hierarchy for native tab/toolbar/nav controls, not the cassette
   label, Code editor, provider logos, or theme decorative signatures. */
html[data-v-ready] :is(button,input,select,textarea,[role="tab"],[role="menuitem"])
 :not(svg):not(path){font-family:inherit;}
html[data-v-ready] :is(main,.hset-main) :is(button,input,select,textarea,[role="tab"]):not([class*="font-mono"]):not([class*="v-cassette"]){
  font-family:var(--v-text)!important;
}

/* 02. Connected native actions on Films and Series. These are separate
   source components with Play + More info / Play + Episodes. We keep their
   own click handlers, focus, state, native names and exact placement. */
html[data-v-ready][data-v-page="movies"] section.harbor-bleed-stremio
 div.mt-2.flex.items-center.gap-3:has(>button.bg-ink):has(>button.bg-canvas\/80),
html[data-v-ready][data-v-page="shows"] main
 div.flex.items-center.gap-2\.5.pt-1:has(>button.bg-ink):has(>button.bg-canvas\/80){
  display:inline-flex!important;
  align-items:center!important;
  width:max-content;
  max-width:100%;
  min-height:58px;
  gap:4px!important;
  padding:5px!important;
  border:1px solid var(--v18-rim)!important;
  border-radius:999px!important;
  background:var(--v18-glass),rgba(var(--v-bg-rgb),.79)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 12px 35px -25px #000!important;
  backdrop-filter:none;
  -webkit-backdrop-filter:none;
}
html[data-v-ready][data-v-page="movies"] section.harbor-bleed-stremio
 div.mt-2.flex.items-center.gap-3:has(>button.bg-ink)>button,
html[data-v-ready][data-v-page="shows"] main
 div.flex.items-center.gap-2\.5.pt-1:has(>button.bg-ink)>button{
  height:48px!important;min-height:48px!important;
  border-radius:999px!important;
  transform:none!important;
  transition:background-color .18s ease,color .18s ease,box-shadow .18s ease!important;
  white-space:nowrap;
  font-family:var(--v-text)!important;
  font-weight:600!important;
}
html[data-v-ready][data-v-page="movies"] section.harbor-bleed-stremio
 div.mt-2.flex.items-center.gap-3:has(>button.bg-ink)>button:first-child,
html[data-v-ready][data-v-page="shows"] main
 div.flex.items-center.gap-2\.5.pt-1:has(>button.bg-ink)>button:first-child{
  background:linear-gradient(175deg,#fff,#e4e4e9)!important;
  color:#08090a!important;
  box-shadow:inset 0 -1px 0 rgba(0,0,0,.09)!important;
  padding-inline:clamp(19px,2.1vw,27px)!important;
}
html[data-v-ready][data-v-page="movies"] section.harbor-bleed-stremio
 div.mt-2.flex.items-center.gap-3:has(>button.bg-ink)>button:nth-child(2),
html[data-v-ready][data-v-page="shows"] main
 div.flex.items-center.gap-2\.5.pt-1:has(>button.bg-ink)>button:nth-child(2){
  background:transparent!important;
  color:var(--color-ink)!important;
  padding-inline:clamp(16px,1.8vw,23px)!important;
  box-shadow:none!important;
}
html[data-v-ready][data-v-page="movies"] section.harbor-bleed-stremio
 div.mt-2.flex.items-center.gap-3:has(>button.bg-ink)>button:nth-child(2):hover,
html[data-v-ready][data-v-page="shows"] main
 div.flex.items-center.gap-2\.5.pt-1:has(>button.bg-ink)>button:nth-child(2):hover{
  background:rgba(var(--v-ac-rgb),.105)!important;
}
html[data-v-ready][data-v-page="movies"] section.harbor-bleed-stremio
 div.mt-2.flex.items-center.gap-3:has(>button.bg-ink)>button:focus-visible,
html[data-v-ready][data-v-page="shows"] main
 div.flex.items-center.gap-2\.5.pt-1:has(>button.bg-ink)>button:focus-visible{
  outline:2px solid rgb(var(--v-ac-rgb))!important;
  outline-offset:2px!important;
}
/* The Series PeekHero is otherwise untouched. Compact controls stay compact
   rather than forcing the film hero width onto this inset carousel. */
html[data-v-ready][data-v-page="shows"] main
 div.flex.items-center.gap-2\.5.pt-1:has(>button.bg-ink){min-height:51px;}
html[data-v-ready][data-v-page="shows"] main
 div.flex.items-center.gap-2\.5.pt-1:has(>button.bg-ink)>button{height:41px!important;min-height:41px!important;}
@media(max-width:560px){
  html[data-v-ready][data-v-page="movies"] section.harbor-bleed-stremio div.mt-2.flex.items-center.gap-3:has(>button.bg-ink){gap:2px!important;padding:3px!important;min-height:49px;}
  html[data-v-ready][data-v-page="movies"] section.harbor-bleed-stremio div.mt-2.flex.items-center.gap-3:has(>button.bg-ink)>button{height:41px!important;min-height:41px!important;padding-inline:14px!important;font-size:12.5px!important;}
}

/* 03. A restrained accent source across routes: each main page already
   defines --v-ac-rgb. Actives should have an accent *hint*, not the old
   bright tongue, colored slab, or border on every card. */
html[data-v-ready][data-v-accent="on"][data-v-page]
 :is(main:not(.harbor-detail-enter),.hset-main)
 :is(header,nav,[role="tablist"])
 :is(button[aria-selected="true"],button[aria-pressed="true"],button[aria-current="page"])
 :not([class*="bg-ink"]):not([class*="text-danger"]){
  border-color:rgba(var(--v-ac-rgb),.22)!important;
}
/* Small consistent focus/hover feedback on native toolbar and tab controls.
   Intentionally no :hover effects on poster cards or media logos. */
html[data-v-ready][data-v-accent="on"][data-v-page]
 :is(main:not(.harbor-detail-enter),.hset-main)
 :is(header,nav,[role="tablist"]) button:not([disabled]):hover > svg:not([class*="text-danger"]){
  color:rgb(var(--v-ac-rgb));
  transition:color .15s ease;
}
html[data-v-ready][data-v-accent="on"][data-v-page]
 :is(main:not(.harbor-detail-enter),.hset-main)
 :is(header,nav,[role="tablist"]) button:focus-visible{
  outline:2px solid rgba(var(--v-ac-rgb),.68)!important;
  outline-offset:2px!important;
}
/* The native source mode selector is a compact control too, but keep its
   semantic selected state and don't replace it with a colored tongue. */
html[data-v-ready][data-v-accent="on"] main
 [role="group"][aria-label="Source mode"] > button[aria-pressed="true"]{
  color:var(--color-ink)!important;
  background:rgba(var(--v-ac-rgb),.11)!important;
}
/* Protect art, the established sidebar, cassette, custom reader and books. */
@media(prefers-reduced-motion:reduce){
  html[data-v-ready][data-v-page="movies"] section.harbor-bleed-stremio div.mt-2.flex.items-center.gap-3 > button,
  html[data-v-ready][data-v-page="shows"] main div.flex.items-center.gap-2\.5.pt-1 > button{
    transition:none!important;
  }
}


/* ========================================================================
   VOID v23.19 / final release QA. No changes to Harbor's native actions,
   cassette, manga book layers, hero art, mood values or user presets.
   ======================================================================== */
#v-edge{appearance:none;padding:0;margin:0;border:0;background:transparent;color:inherit;cursor:pointer;touch-action:manipulation;}
#v-jump .v-jump-empty{margin:0;padding:13px 16px 15px;color:var(--color-ink-muted);font:500 13px var(--v-text);text-align:center;}
#v-edge:focus-visible{outline:2px solid rgb(var(--v-ac-rgb));outline-offset:-3px;border-radius:0 8px 8px 0;}
#v-edge[data-open="true"],html[data-v-pin="on"] #v-edge{visibility:hidden;}
@media(hover:none),(pointer:coarse){
  /* On phones, keep the handle discoverable without blocking a whole edge. */
  #v-edge{top:calc(50% - 47px);bottom:auto;height:94px;width:38px;border-radius:0 12px 12px 0;
    background:rgba(var(--v-bg-rgb),.82);border:1px solid var(--v-rim);border-left:0;}
  #v-edge::after{top:50%;left:11px;width:3px;height:43px;margin-top:-21px;background:rgba(255,255,255,.6);}
  #v-edge:active{background:rgba(255,255,255,.13);}
}
@media(max-width:420px){
  #v-panel{right:8px;top:60px;width:calc(100vw - 16px);max-height:calc(100dvh - 72px - var(--v-dock-h,0px));padding:17px;border-radius:16px;}
  #v-panel .v-choices{gap:6px;}
  #v-panel .v-choice{min-width:0;padding:10px 9px;font-size:12.5px;}
  #v-panel .v-choices[data-n="3"] .v-choice{justify-content:center;padding-inline:6px;font-size:12px;}
  html[data-v-ready][data-v-page="movies"] section.harbor-bleed-stremio div.mt-2.flex.items-center.gap-3:has(>button.bg-ink)>button,
  html[data-v-ready][data-v-page="shows"] main div.flex.items-center.gap-2\.5.pt-1:has(>button.bg-ink)>button{
    min-width:0;max-width:100%;overflow:hidden;text-overflow:ellipsis;
    padding-inline:clamp(9px,3vw,15px)!important;font-size:12.5px!important;}
}
html[data-v-motion="off"] #v-panel,html[data-v-performance="on"] #v-panel{animation:none!important;}
@media(prefers-reduced-motion:reduce){
  #v-panel,#v-edge,#v-edge::after{animation:none!important;transition:none!important;}
  html[data-v-entering] main{animation:none!important;}
  #v-progress i{transition:none!important;}
}
/* Small screens and software keyboards: keep the bottom of Appearance usable. */
@media(max-height:600px){
  #v-panel{top:8px;max-height:calc(100dvh - 16px - var(--v-dock-h,0px));}
  #v-jump{padding-top:clamp(18px,8vh,60px);}
}


/* ========================================================================
   VOID / Arabic and right-to-left compatibility. Applies only when Harbor
   exposes RTL/Arabic via lang, dir or its native localized navigation.
   Do not flip poster artwork, media progress, chapter numbers or timecodes.
   ======================================================================== */
html[data-v-arabic="on"],html:lang(ar){
  --v-text:'Inter','Noto Sans Arabic',Tahoma,Arial,sans-serif;
  --v-display:'Syne','Noto Sans Arabic',Tahoma,Arial,sans-serif;
}
html[data-v-arabic="on"] :is(h1,h2,h3,h4),html:lang(ar) :is(h1,h2,h3,h4){
  letter-spacing:normal!important;overflow-wrap:break-word;
}
html[data-v-arabic="on"] :is(button,input,textarea,select,[role="tab"],[role="option"]),
html:lang(ar) :is(button,input,textarea,select,[role="tab"],[role="option"]){
  font-family:var(--v-text)!important;
}
/* Arabic labels need natural word-shaping: avoid uppercase/tracking effects. */
html[data-v-arabic="on"] :is(.v-nav-label,.v-field,.v-studio-label,.v-shortcuts-group h4,
 .v-shortcuts-overline,.v-hub-title small),html:lang(ar) :is(.v-nav-label,.v-field,.v-studio-label){
  letter-spacing:normal!important;text-transform:none!important;line-height:1.6!important;
}
html[data-v-rtl="on"] :is(#v-rail,#v-panel,#v-jump,#v-shortcuts){direction:rtl;text-align:start;}
html[data-v-rtl="on"] #v-rail{left:auto!important;right:14px!important;}
html[data-v-rtl="on"] #v-rail[data-open="false"]{transform:translate3d(calc(100% + 40px),0,0)!important;}
html[data-v-rtl="on"] #v-edge{left:auto!important;right:0!important;}
html[data-v-rtl="on"] #v-edge::after{left:auto!important;right:5px;}
html[data-v-rtl="on"] #v-edge:focus-visible{border-radius:8px 0 0 8px;}
html[data-v-rtl="on"] .v-navbtn{direction:rtl;text-align:start;min-height:44px;height:auto;padding:9px 14px 9px 12px;line-height:1.55;}
html[data-v-rtl="on"] .v-navbtn>span{white-space:normal;overflow-wrap:break-word;line-height:1.55;}
html[data-v-rtl="on"] .v-navbtn[data-active="true"]::before{
  left:auto;right:-14px;border-radius:3px 0 0 3px;
}
html[data-v-rtl="on"] .v-navbtn:hover{transform:translateX(-2px);}
html[data-v-rtl="on"] .v-navbtn kbd{margin-left:0;margin-inline-start:auto;direction:ltr;unicode-bidi:isolate;}
html[data-v-rtl="on"] .v-nav-label{margin-inline:14px;text-align:start;}
html[data-v-rtl="on"] .v-logo{direction:ltr;unicode-bidi:isolate;}
html[data-v-rtl="on"] #v-panel{right:auto!important;left:22px!important;}
html[data-v-rtl="on"] :is(#v-panel,#v-jump,#v-shortcuts) :is(input,textarea){text-align:start;}
html[data-v-rtl="on"] #v-panel .v-studio-json{direction:ltr;text-align:left;unicode-bidi:plaintext;}
html[data-v-rtl="on"] #v-panel .v-choices .v-choice{text-align:start;min-width:0;}
html[data-v-rtl="on"] #v-panel :is(.v-switch,.v-choice,.v-studio-btn){line-height:1.65;}
html[data-v-rtl="on"] #v-panel .v-switch{height:auto;min-height:48px;}
html[data-v-rtl="on"] #v-panel .v-switch b{direction:ltr;}
html[data-v-rtl="on"] #v-panel :is(.v-field,.v-sub,.v-foot,.v-studio-help){line-height:1.65;}
html[data-v-rtl="on"] #v-jump .v-jump-box li{height:auto;min-height:44px;line-height:1.6;}
html[data-v-rtl="on"] #v-jump .v-jump-hint kbd,
html[data-v-rtl="on"] #v-shortcuts :is(kbd,.v-shortcuts-keys){direction:ltr;unicode-bidi:isolate;}
html[data-v-rtl="on"] .v-top{right:auto;left:22px;}
html[data-v-rtl="on"] .v-hub-end{margin-left:0;margin-inline-start:auto;}
html[data-v-rtl="on"] .v-hey[data-float="true"]{right:auto;left:210px;}
html[data-v-rtl="on"] .v-hey{margin-right:0;margin-inline-end:6px;direction:rtl;}
html[data-v-rtl="on"] .v-hey b{unicode-bidi:plaintext;}
html[data-v-rtl="on"] .v-clock{direction:ltr;unicode-bidi:isolate;}
html[data-v-rtl="on"] main.flex-1.overflow-y-auto{transition:padding-right .3s var(--v-ease);}
@media(min-width:1001px){
 html[data-v-rtl="on"][data-v-pin="on"] main.flex-1.overflow-y-auto{
   padding-left:clamp(24px,3vw,48px)!important;
   padding-right:calc(var(--v-side) + 22px)!important;
 }
 html[data-v-rtl="on"][data-v-pin="on"][data-v-page="manga"] main.flex-1.overflow-y-auto{
   padding-left:clamp(28px,3.2vw,64px)!important;
 }
}
@media(max-width:760px){
 html[data-v-rtl="on"] #v-rail{right:8px!important;left:auto!important;}
}
@media(hover:none),(pointer:coarse){
 html[data-v-rtl="on"] #v-edge{border-radius:12px 0 0 12px;border-left:1px solid var(--v-rim);border-right:0;}
 html[data-v-rtl="on"] #v-edge::after{left:auto!important;right:11px;}
}
@media(max-width:420px){
 html[data-v-rtl="on"] #v-panel{right:8px!important;left:8px!important;width:auto!important;}
 html[data-v-rtl="on"] #v-panel .v-choice{font-size:12px;line-height:1.7;}
}
/* Connected action buttons are ordered by Harbor; mirror only the visual join. */
html[data-v-rtl="on"][data-v-ready][data-v-cta="on"] main.harbor-detail-enter
 div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
 >span.relative.inline-flex:first-child{
   border-radius:0 999px 999px 0;border-left:0;border-right:1px solid rgba(255,255,255,.13);
   padding:5px 5px 5px 0;
}
html[data-v-rtl="on"][data-v-ready][data-v-cta="on"] main.harbor-detail-enter
 div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
 >div.relative.inline-flex:nth-child(2){
   border-radius:999px 0 0 999px;border-right:0;border-left:1px solid rgba(255,255,255,.13);
   padding:5px 0 5px 5px;
}
html[data-v-rtl="on"][data-v-ready][data-v-cta="on"] .harbor-anime-hero
 div.mt-1.flex.items-center.gap-3:has(>button.bg-ink)>button:first-child{
   border-radius:0 999px 999px 0!important;
}
html[data-v-rtl="on"][data-v-ready][data-v-cta="on"] .harbor-anime-hero
 div.mt-1.flex.items-center.gap-3:has(>button.bg-ink)>button:nth-child(2)[aria-pressed]{
   border-radius:999px 0 0 999px!important;border-left:1px solid rgba(255,255,255,.13)!important;border-right:0!important;
}
html[data-v-arabic="on"] main.harbor-detail-enter
 div.mt-9.flex.items-center.gap-3:has(>span.relative.inline-flex >button.bg-ink)
 >:is(span.relative.inline-flex,div.relative.inline-flex)>button{
  min-width:0!important;max-width:100%;height:auto!important;min-height:50px;white-space:normal!important;
  line-height:1.5;padding-block:8px!important;
}
/* Keep timecodes, technical metadata and artwork-specific geometry LTR. */
html[data-v-rtl="on"] :is(.v-m-record,.v-tape-mechanics,.v-tape-time,.v-deck-time,
 .v-deck-progress,#v-progress,.v-logo){direction:ltr;unicode-bidi:isolate;}


/* Arabic labels are usually wider than Latin: remove decorative tracking only
   in VOID's own UI. Native Harbor controls retain their layout and state. */
html[data-v-arabic="on"] :is(#v-rail,#v-panel,#v-shortcuts,#v-jump,.v-hub,.v-music-desk,#v-cassette-view)
 :is(.v-nav-label,.v-field,.v-music-eyebrow,.v-music-now-state,.v-hub-title,.v-hub-end,.v-cassette-tag,
     .v-cassette-state,.v-cassette-format,.v-shortcuts-overline,.v-shortcuts-label,.v-tape-readout span){
  letter-spacing:normal!important;text-transform:none!important;line-height:1.65;
}
html[data-v-rtl="on"] :is(.v-music-desk,.v-hub,#v-cassette-view .v-cassette-copy){direction:rtl;text-align:start;}
html[data-v-rtl="on"] #v-cassette-view :is(.v-cassette-times,.v-cassette-controls,.v-cassette-progress,.v-tape-readout,
 .v-cassette-volume-row input,.v-tape-band,.v-deck-readout){direction:ltr;unicode-bidi:isolate;}
html[data-v-rtl="on"] .v-music-desk :is(.v-music-now-progress,.v-music-now-art){direction:ltr;unicode-bidi:isolate;}
html[data-v-rtl="on"] #v-jump .v-jump-box{max-width:min(560px,calc(100vw - 24px));}
html[data-v-rtl="on"] :is(#v-jump,#v-shortcuts) :is(input[type="text"],input[type="search"]){direction:rtl;}
html[data-v-rtl="on"] #v-panel input[data-v-studio-name]{direction:auto;text-align:start;}


/* ========================================================================
   VOID — optional heading typography, independent of colour/animation.
   Signature remains the default; body text, media artwork and cassette
   typography stay untouched. Noto Sans Arabic remains the Arabic fallback.
   ======================================================================== */
html[data-v-ready][data-v-typography="modern"]{
  --v-display:'Inter','Inter Tight',system-ui,-apple-system,'Segoe UI',sans-serif;
}
html[data-v-ready][data-v-typography="modern"]:is([data-v-arabic="on"],:lang(ar)){
  --v-display:'Inter','Noto Sans Arabic',Tahoma,Arial,sans-serif;
}
/* Brand wordmark retains its original appearance in either setting. */
html[data-v-ready] .v-logo{font-family:'Syne','Inter Tight','Segoe UI',sans-serif;}
/* Use ExtraBold weight for the modern option on native mastheads and shelves,
   without changing poster labels, movie logos or the player UI. */
html[data-v-ready][data-v-typography="modern"] :is(
  main h1.font-display,
  main > div > header h1,
  main > header h1,
  main > div > div > header h1,
  main .harbor-row-shell > h3,
  main .harbor-row-shell header h3,
  main section > h2,
  main section > div:first-child > h2,
  main section > div:first-child > h3,
  main header > h2,
  .harbor-settings-shell .hset-title,
  .harbor-settings-shell .hset-section-title,
  .v-hub-title
){font-weight:800!important;letter-spacing:-.035em!important;}
/* Native shelf headings have a more specific v23.18 signature rule.
   Match their scope so Inter ExtraBold wins instead of the old 700 weight. */
html[data-v-ready][data-v-typography="modern"][data-v-page]
 main:not(.harbor-detail-enter) :is(
   .harbor-row-shell > h3,.harbor-row-shell header h3,
   section > h2,section > div:first-child > h2,header > h2
 ):not([class*="sr-only"]){font-weight:800!important;letter-spacing:-.035em!important;}
html[data-v-ready][data-v-typography="modern"][data-v-page]
 main:not(.harbor-detail-enter):not([data-harbor-player])
 :is(h1,h2).font-display{font-weight:800!important;letter-spacing:-.035em!important;}
/* Preserve correct Arabic glyph shaping (never apply negative tracking). */
html[data-v-ready][data-v-typography="modern"]:is([data-v-arabic="on"],:lang(ar))
 :is(h1,h2,h3,h4,.v-hub-title){letter-spacing:normal!important;}
/* Higher-specificity Arabic headings win over native shelf tracking rules. */
html[data-v-ready][data-v-typography="modern"][data-v-arabic="on"][data-v-page]
 main:not(.harbor-detail-enter) :is(
   .harbor-row-shell > h3,.harbor-row-shell header h3,
   section > h2,section > div:first-child > h2,header > h2
 ):not([class*="sr-only"]),
html[data-v-ready][data-v-typography="modern"]:lang(ar)[data-v-page]
 main:not(.harbor-detail-enter) :is(
   .harbor-row-shell > h3,.harbor-row-shell header h3,
   section > h2,section > div:first-child > h2,header > h2
 ):not([class*="sr-only"]){letter-spacing:normal!important;}
/* Compact in-panel live preview. */
#v-panel .v-type-choice{min-height:56px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:3px;min-width:0;}
#v-panel .v-type-choice strong{font-size:13px;line-height:1.3;color:var(--color-ink);}
#v-panel .v-type-choice small{font:500 11px/1.3 var(--v-text);opacity:.72;}
#v-panel .v-type-choice[data-v-typography="signature"] strong{font-family:'Syne','Inter Tight',sans-serif;}
#v-panel .v-type-choice[data-v-typography="modern"] strong{font-family:'Inter','Inter Tight',sans-serif;font-weight:800;}
#v-panel .v-type-preview{margin-top:9px;padding:12px 14px;border:1px solid var(--v-hair);border-radius:13px;background:rgba(255,255,255,.022);overflow-wrap:anywhere;}
#v-panel .v-type-preview-label{display:block;font:500 10px/1.4 var(--v-text);color:var(--color-ink-subtle);margin-bottom:5px;}
#v-panel .v-type-preview-title{display:block;font:700 clamp(18px,5vw,23px)/1.2 var(--v-display);letter-spacing:-.035em;}
html[data-v-ready][data-v-typography="modern"] #v-panel .v-type-preview-title{font-weight:800;}
html[data-v-ready]:is([data-v-arabic="on"],:lang(ar)) #v-panel .v-type-preview-title{letter-spacing:normal;}
html[data-v-rtl="on"] #v-panel .v-type-choice{align-items:flex-start;text-align:start;}


/* VOID custom heading fonts. Keeps media artwork, body copy, and VOID wordmark unchanged. */
html[data-v-ready][data-v-typography="custom"][data-v-custom-font="ready"]{
  --v-display:'VOID User Typeface','Noto Sans Arabic','Inter Tight','Inter',Tahoma,sans-serif;
}
#v-panel .v-type-custom{grid-column:1/-1;min-height:44px;flex-direction:row;align-items:center;justify-content:space-between;gap:10px;}
#v-panel .v-type-custom strong{font-family:var(--v-text);font-weight:700;}
#v-panel .v-type-custom small{max-width:58%;text-align:end;}
html[data-v-ready][data-v-custom-font="ready"] #v-panel .v-type-custom strong{font-family:'VOID User Typeface',var(--v-text);}
#v-panel .v-font-controls{border:1px solid var(--v-hair);border-radius:12px;padding:11px 12px;margin-top:8px;background:rgba(255,255,255,.017);min-width:0;}
#v-panel .v-font-current{font:600 12px/1.5 var(--v-text);color:var(--color-ink);overflow-wrap:anywhere;}
#v-panel .v-font-actions{display:flex;flex-wrap:wrap;gap:7px;margin:9px 0 0;}
#v-panel .v-font-actions .v-studio-btn{min-height:35px;white-space:normal;}
#v-panel .v-font-actions .v-studio-btn:disabled{opacity:.36;cursor:not-allowed;}
#v-panel .v-font-file{display:none;}
#v-panel .v-font-status{margin:8px 0 0;color:var(--color-ink-subtle);font:500 11px/1.5 var(--v-text);overflow-wrap:anywhere;}
#v-panel .v-font-status[data-kind="error"]{color:#ff9090;}
#v-panel .v-font-status[data-kind="success"]{color:#a0dec1;}
html[data-v-rtl="on"] #v-panel .v-type-custom small{text-align:start;}
html[data-v-ready][data-v-arabic="on"][data-v-typography="custom"] :is(h1,h2,h3,h4,.v-hub-title),
html[data-v-ready]:lang(ar)[data-v-typography="custom"] :is(h1,h2,h3,h4,.v-hub-title){letter-spacing:normal!important;}

@html
<template id="v-template">
 <div id="v-progress" aria-hidden="true"><i></i></div>
 <button id="v-edge" type="button" data-open="false" aria-label="Open VOID navigation" title="Open navigation" aria-controls="v-rail" aria-expanded="false"></button>
 <aside id="v-rail" data-open="false" aria-label="Navigation" hidden>
  <div class="v-rail-head">
   <span class="v-logo" data-text="VOID" role="img" aria-label="Void">VOID</span>
  </div>
  <nav class="v-nav" data-v-nav></nav>
  <div class="v-rail-foot">
   <button class="v-navbtn" type="button" data-v-action="jump"><svg viewBox="0 0 24 24"><path fill-rule="evenodd" d="M10.5 3a7.5 7.5 0 015.9 12.1l4.3 4.3-1.4 1.4-4.3-4.3A7.5 7.5 0 1110.5 3zm0 2.5a5 5 0 100 10 5 5 0 000-10z"/></svg><span>Quick jump</span><kbd>Ctrl K</kbd></button>
   <button class="v-navbtn" type="button" data-v-action="panel"><svg viewBox="0 0 24 24"><path d="M4 6h9V4h2v2h5v2h-5v2h-2V8H4V6zm0 8h5v-2h2v2h9v2H11v2H9v-2H4v-2z"/></svg><span>Appearance</span></button>
   <button class="v-navbtn" type="button" data-v-view="settings"><svg viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12.000 3.900L13.951 2.192L15.827 2.761L16.500 5.265L17.728 6.272L20.315 6.444L21.239 8.173L19.944 10.420L20.100 12.000L21.808 13.951L21.239 15.827L18.735 16.500L17.728 17.728L17.556 20.315L15.827 21.239L13.580 19.944L12.000 20.100L10.049 21.808L8.173 21.239L7.500 18.735L6.272 17.728L3.685 17.556L2.761 15.827L4.056 13.580L3.900 12.000L2.192 10.049L2.761 8.173L5.265 7.500L6.272 6.272L6.444 3.685L8.173 2.761L10.420 4.056Z M15.5 12a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z"/></svg><span>Settings</span></button>
   <button class="v-navbtn" type="button" data-v-action="collapse"><svg viewBox="0 0 24 24"><path d="M14.6 5.4 8 12l6.6 6.6 1.8-1.8L11.6 12l4.8-4.8-1.8-1.8z"/></svg><span>Hide sidebar</span><kbd class="v-k1"><span>[</span></kbd></button>
  </div>
 </aside>
 <div id="v-jump" role="dialog" aria-modal="true" aria-label="Quick jump" hidden><div class="v-jump-box"><input type="text" role="combobox" aria-label="Jump to a page" aria-expanded="true" aria-controls="v-jump-options" aria-autocomplete="list" placeholder="Jump to a page" autocomplete="off" spellcheck="false"><ul id="v-jump-options" role="listbox"></ul><div class="v-jump-hint"><span><kbd>↑</kbd><kbd>↓</kbd>move</span><span><kbd>↵</kbd>open</span><span><kbd>esc</kbd>close</span></div></div></div>

 <section id="v-shortcuts" role="dialog" aria-modal="true" aria-labelledby="v-shortcuts-title" hidden>
  <div class="v-shortcuts-shell">
   <header class="v-shortcuts-head"><div class="v-shortcuts-heading"><div class="v-shortcuts-overline">VOID / REFERENCE</div><h3 id="v-shortcuts-title">Keyboard shortcuts</h3></div><button class="v-shortcuts-close" type="button" data-v-shortcut-close aria-label="Close keyboard shortcuts">×</button></header>
   <label class="v-shortcuts-search-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.75" cy="10.75" r="6.75"/><path d="m16 16 5 5"/></svg><input class="v-shortcuts-search" type="search" aria-label="Filter shortcuts" placeholder="Filter shortcuts…" autocomplete="off" spellcheck="false"></label>
   <div class="v-shortcuts-body">
    <section class="v-shortcuts-group" data-v-shortcut-group><h4>Global</h4>
     <div class="v-shortcuts-row" data-v-shortcut-row><div><div class="v-shortcuts-label">Open shortcut guide</div><div class="v-shortcuts-description">Anywhere except text fields and video playback</div></div><div class="v-shortcuts-keys"><kbd>?</kbd></div></div>
     <div class="v-shortcuts-row" data-v-shortcut-row><div><div class="v-shortcuts-label">Quick jump to a page</div><div class="v-shortcuts-description">Search Harbor sections from VOID</div></div><div class="v-shortcuts-keys"><kbd>Ctrl</kbd><kbd>K</kbd></div></div>
     <div class="v-shortcuts-row" data-v-shortcut-row><div><div class="v-shortcuts-label">Toggle sidebar</div><div class="v-shortcuts-description">Expand or collapse VOID navigation</div></div><div class="v-shortcuts-keys"><kbd>[</kbd></div></div>
     <div class="v-shortcuts-row" data-v-shortcut-row><div><div class="v-shortcuts-label">Close open VOID overlay</div><div class="v-shortcuts-description">Appearance, quick jump or shortcut guide</div></div><div class="v-shortcuts-keys"><kbd>Esc</kbd></div></div>
    </section>
    <section class="v-shortcuts-group" data-v-shortcut-group><h4>Cassette player · expanded</h4>
     <div class="v-shortcuts-row" data-v-shortcut-row><div><div class="v-shortcuts-label">Play or pause</div><div class="v-shortcuts-description">When the expanded cassette is open</div></div><div class="v-shortcuts-keys"><kbd>Space</kbd></div></div>
     <div class="v-shortcuts-row" data-v-shortcut-row><div><div class="v-shortcuts-label">Seek backward / forward 10 seconds</div><div class="v-shortcuts-description">When focus is outside a slider or text field</div></div><div class="v-shortcuts-keys"><kbd>←</kbd><kbd>→</kbd></div></div>
    </section>
    <section class="v-shortcuts-group" data-v-shortcut-group><h4>Cover flow · focused</h4>
     <div class="v-shortcuts-row" data-v-shortcut-row><div><div class="v-shortcuts-label">Select previous / next cover</div><div class="v-shortcuts-description">When a VOID cover-flow card has keyboard focus</div></div><div class="v-shortcuts-keys"><kbd>←</kbd><kbd>→</kbd></div></div>
     <div class="v-shortcuts-row" data-v-shortcut-row><div><div class="v-shortcuts-label">Open selected cover</div><div class="v-shortcuts-description">When a VOID cover-flow card has keyboard focus</div></div><div class="v-shortcuts-keys"><kbd>Enter</kbd><kbd>Space</kbd></div></div>
    </section>
    <p class="v-shortcuts-empty" hidden>No shortcuts match that search.</p>
   </div>
   <footer class="v-shortcuts-foot"><span>Reader arrow keys are experimental until native Harbor support is confirmed.</span><span><kbd>Esc</kbd> close</span></footer>
  </div>
 </section>
 <section id="v-panel" role="dialog" aria-modal="false" aria-labelledby="v-panel-title" hidden>
  <div class="v-panel-head"><h3 id="v-panel-title">Appearance</h3><button type="button" data-v-action="close-panel" aria-label="Close appearance" class="v-close">&#215;</button></div><p class="v-sub">Black, flat and quiet.</p>

  <details class="v-studio" data-v-studio>
   <summary><span>Preset Studio<span class="v-studio-caption">Save and share your VOID appearance</span></span><span class="v-studio-chevron" aria-hidden="true">›</span></summary>
   <div class="v-studio-body">
    <output class="v-studio-status" data-v-studio-status>Current appearance · no preset loaded</output>
    <p class="v-studio-feedback" role="status" aria-live="polite" data-v-studio-feedback></p>
    <label class="v-studio-label" for="v-studio-name">New preset name</label>
    <input class="v-studio-name" data-v-studio-name id="v-studio-name" type="text" placeholder="e.g. Carbon Minimal" maxlength="42" autocomplete="off" spellcheck="false">
    <div class="v-studio-actions"><button class="v-studio-btn" data-primary="true" type="button" data-v-preset-action="save">Save current</button><button class="v-studio-btn" type="button" data-v-preset-action="update">Update loaded</button></div>
    <label class="v-studio-label">Saved presets</label>
    <div class="v-studio-list" data-v-studio-list><p class="v-studio-empty">No presets saved yet.</p></div>
    <hr class="v-studio-divider">
    <div class="v-studio-actions"><button class="v-studio-btn" type="button" data-v-preset-action="export-all">Export all JSON</button><button class="v-studio-btn" type="button" data-v-preset-action="choose-file">Import .json file</button></div>
    <input class="v-studio-file" type="file" accept=".json,application/json" data-v-studio-file tabindex="-1" aria-label="Import VOID preset JSON file">
    <label class="v-studio-label" for="v-studio-json">Or paste preset JSON</label>
    <textarea class="v-studio-json" id="v-studio-json" data-v-studio-json rows="3" placeholder="Paste JSON here to import or copy an exported preset" spellcheck="false"></textarea>
    <div class="v-studio-actions"><button class="v-studio-btn" type="button" data-v-preset-action="import-text">Import pasted JSON</button><button class="v-studio-btn" type="button" data-v-preset-action="copy-json">Copy JSON</button></div>
    <p class="v-studio-help">Only VOID appearance settings are included. Imports never run code or alter Harbor accounts.</p>
   </div>
  </details>
  <div class="v-field">Tone</div>
  <div class="v-choices">
   <button class="v-choice" type="button" data-v-mood="carbon" aria-pressed="true"><i style="background:#ececf0"></i>Carbon</button>
   <button class="v-choice" type="button" data-v-mood="night" aria-pressed="false"><i style="background:#96b0d6"></i>Night</button>
   <button class="v-choice" type="button" data-v-mood="bone" aria-pressed="false"><i style="background:#e0d2be"></i>Bone</button>
   <button class="v-choice" type="button" data-v-mood="ember" aria-pressed="false"><i style="background:#e66e46"></i>Ember</button>
   <button class="v-choice" type="button" data-v-mood="netflix" aria-pressed="false"><i style="background:#e50914"></i>Netflix</button>
   <button class="v-choice" type="button" data-v-mood="hbo" aria-pressed="false"><i style="background:linear-gradient(135deg,#5822b4,#2b4bff)"></i>HBO</button>
   <button class="v-choice" type="button" data-v-mood="mocha" aria-pressed="false"><i style="background:#cba6f7"></i>Mocha</button>
  </div>
  <div class="v-field">Typography</div>
  <div class="v-choices" role="group" aria-label="Typography">
   <button class="v-choice v-type-choice" type="button" data-v-typography="signature" aria-pressed="true"><strong>Signature</strong><small>Syne</small></button>
   <button class="v-choice v-type-choice" type="button" data-v-typography="modern" aria-pressed="false"><strong>Modern</strong><small>Inter ExtraBold</small></button>
   <button class="v-choice v-type-choice v-type-custom" type="button" data-v-typography="custom" aria-pressed="false"><strong>Custom font</strong><small>Your own font file</small></button>
  </div>
  <div class="v-font-controls" aria-label="Custom font upload">
   <div class="v-font-current" data-v-font-current>No font uploaded</div>
   <div class="v-font-actions">
    <button class="v-studio-btn" type="button" data-v-action="upload-font">Choose font file</button>
    <button class="v-studio-btn" type="button" data-v-action="remove-font" disabled>Remove font</button>
   </div>
   <input class="v-font-file" type="file" accept=".woff2,.woff,.ttf,.otf,font/woff2,font/woff,font/ttf,font/otf" data-v-font-file tabindex="-1" aria-label="Choose custom font file">
   <p class="v-font-status" data-v-font-status role="status" aria-live="polite">WOFF2, WOFF, TTF, OTF · max 8 MB. Stored locally, not bundled with shared presets.</p>
  </div>
  <div class="v-type-preview" aria-hidden="true"><span class="v-type-preview-label">Live preview</span><strong class="v-type-preview-title">Continue Watching</strong></div>
  <div class="v-field">Sidebar</div>
  <div class="v-choices">
   <button class="v-choice" type="button" data-v-pin="false" aria-pressed="true">Auto-hide</button>
   <button class="v-choice" type="button" data-v-pin="true" aria-pressed="false">Pinned</button>
  </div>
  <div class="v-field">Corners</div>
  <div class="v-choices">
   <button class="v-choice" type="button" data-v-corners="round" aria-pressed="true">Round</button>
   <button class="v-choice" type="button" data-v-corners="sharp" aria-pressed="false">Sharp</button>
  </div>
  <div class="v-field">Top 10 numbers</div>
  <div class="v-choices" data-n="3">
   <button class="v-choice" type="button" data-v-ranks="chips" aria-pressed="true">Chips</button>
   <button class="v-choice" type="button" data-v-ranks="numerals" aria-pressed="false">Numerals</button>
   <button class="v-choice" type="button" data-v-ranks="off" aria-pressed="false">Off</button>
  </div>
  <div class="v-field">Top bar</div>
  <button class="v-switch" type="button" data-v-toggle="hey" aria-pressed="true"><span>Greeting<small>Hey, your name</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="clock" aria-pressed="false"><span>Clock<small>Local time next to the greeting</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="bar" aria-pressed="true"><span>Scroll line<small>Thin progress line at the very top</small></span><b></b></button>
  <div class="v-field">Home</div>
  <button class="v-switch" type="button" data-v-toggle="hfull" aria-pressed="true"><span>Full hero<small>Edge to edge and taller, even when Harbor's Full hero banner setting is off</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="order" aria-pressed="true"><span>Hero first<small>Hero, then Continue Watching, Your Streaming, then catalogues</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="hfade" aria-pressed="true"><span>Hero blur fade<small>Soft blur that melts the hero into the page</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="cta" aria-pressed="true"><span>Action switch<small>Play and Watchlist as one glass switch on the right</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="fill" aria-pressed="true"><span>Fill Top 10 row<small>Fill wide rows; retain horizontal scrolling on small screens</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="flow" aria-pressed="true"><span>Cover flow<small>Your Streaming as a flat stacked carousel</small></span><b></b></button>
  <div class="v-field">Music player</div>
  <button class="v-switch" type="button" data-v-toggle="deck" aria-pressed="true"><span>Compact music deck<small>Spinning record and expanded cassette view</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="ambient" aria-pressed="true"><span>Album ambient lighting<small>Subtle cassette glow sampled from album artwork; falls back to VOID accent when unavailable</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="ambpulse" aria-pressed="true"><span>Audio-reactive glow<small>Uses Harbor’s Dock Visualizer levels when enabled in Music → Audio settings; otherwise steady lighting</small></span><b></b></button>
  <div class="v-field">Physical media cases</div>
  <button class="v-switch" type="button" data-v-toggle="cases" aria-pressed="false"><span>Blu-ray / DVD poster cases<small>Optional physical cases on Films and Series cards; preserves native overlays and click actions</small></span><b></b></button>
  <div class="v-choices" data-v-case-choice>
   <button class="v-choice" type="button" data-v-casefmt="bluray" aria-pressed="true">Blu-ray</button>
   <button class="v-choice" type="button" data-v-casefmt="dvd" aria-pressed="false">DVD</button>
  </div>
  <div class="v-field">Manga</div>
  <button class="v-switch" type="button" data-v-toggle="books" aria-pressed="true"><span>Manga hardcovers<small>Bound spines, page edges and a hinged cover on hover or keyboard focus</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="flip" aria-pressed="true"><span>Page flip<small>Page leaves fan out and riffle when a hardcover opens</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="ribbons" aria-pressed="true"><span>Bookmark ribbons<small>Fabric tabs showing per-profile chapter reading progress and completed chapters</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="hub" aria-pressed="true"><span>Library bar<small>Shelf shortcuts above the manga rows</small></span><b></b></button>
  <div class="v-field">Feel &amp; Performance</div>
  <button class="v-switch" type="button" data-v-toggle="performance" aria-pressed="false"><span>Performance mode<small>Optional GPU-saving mode: flat hero fade and reduced decorative motion. Cassette and book interactions remain.</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="calm" aria-pressed="true"><span>Calm placeholders<small>Stop the shimmer animation on posters that are still loading</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="blur" aria-pressed="false"><span>Live blur<small>Frosted glass on the sidebar and hero switch. Prettier, but heavier on weak GPUs</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="accent" aria-pressed="true"><span>Tab accents<small>A muted color per page (neutral tones only)</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="fade" aria-pressed="true"><span>Page fade<small>Short fade when you change page</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="glitch" aria-pressed="true"><span>Glitch wordmark<small>Occasional signal tear on the logo</small></span><b></b></button>
  <button class="v-switch" type="button" data-v-toggle="motion" aria-pressed="true"><span>Motion<small>Enable theme animations and transitions</small></span><b></b></button>
  <div class="v-field">Keyboard</div>
  <button class="v-choice v-wide" type="button" data-v-action="shortcuts">Keyboard shortcut guide <span>?</span></button>
  <button class="v-choice v-wide" type="button" data-v-action="harbor-settings">Open Harbor settings<span>›</span></button>
  <button class="v-choice v-wide v-ghost" type="button" data-v-action="reset">Reset appearance<span>↺</span></button>
  <p class="v-foot">Poster size, quality and card style are in Harbor settings, Theme and appearance. Ctrl K jumps to any page. Press ? for keyboard help.</p>
 </section>
</template>

@js
(function(){'use strict';
  var win=window,doc=document,root=doc.documentElement;
  if(typeof win.__harborThemeCleanup==='function'){try{win.__harborThemeCleanup();}catch(_e){}}
  var live=true,abort=new AbortController(),rail=null,edge=null,panel=null,jump=null,shortcuts=null,shortcutsFocus=null,prog=null,hey=null,clock=null,observer=null,navObserver=null,navElement=null,ctaRO=null,ctaStage=null,ctaKey='',orderHost=null,liftEls=[],jumpFocus=null,panelFocus=null,flowNative=null,flowParent=null,flowParentPos='',flowNativeInert=false,flowCtl=null;
  var raf=0,timer=0,lastRun=0,poll=0,tick=0,bootT=0,bootTries=0,closeT=0,enterT=0,swapped=[],sideOpen=false,sideInit=false,jumpSel=0,lastPage=null,lastScroll=0;
  var flow=null,flowKey='',flowIdx=null,flowCards=[],flowTiles=[],flowHost=null,flowLock=0,drag=null;
  var scrollRaf=0,scrollMain=null,scrolledNow=null,lastPicker=0,dockEl=null,dockScan=0,wideTries=0,wideEl=null;
  var STORE='harbor.void.v20',FLOWKEY='harbor.void.flow',DXKEY='harbor.void.dx';
  var MT='[data-scroll-anchor="hero"] .harbor-hero-content .mt-9';
  var MOODS=['carbon','night','bone','ember','netflix','hbo','mocha'];
  var NEUTRAL=['carbon','night','bone','ember'];
  var DEFAULTS={mood:'carbon',typography:'signature',pin:false,flow:true,cta:true,order:true,hfade:true,hfull:true,fill:true,calm:true,blur:false,ranks:'chips',corners:'round',glitch:true,motion:true,autohide:true,hey:true,clock:false,accent:true,bar:true,fade:true,deck:true,books:true,flip:true,hub:true,performance:false,ribbons:true,ambient:true,ambpulse:true,cases:false,casefmt:'bluray'};
  var prefs=Object.assign({},DEFAULTS);
  try{var data=JSON.parse(localStorage.getItem(STORE)||localStorage.getItem('harbor.void.v19')||localStorage.getItem('harbor.void.v18')||'{}');if(data&&typeof data==='object'){
    if(MOODS.indexOf(data.mood)>-1)prefs.mood=data.mood;
    if(['signature','modern','custom'].indexOf(data.typography)>-1)prefs.typography=data.typography;
    if(['chips','numerals','off'].indexOf(data.ranks)>-1)prefs.ranks=data.ranks;
    if(['round','sharp'].indexOf(data.corners)>-1)prefs.corners=data.corners;
    if(['bluray','dvd'].indexOf(data.casefmt)>-1)prefs.casefmt=data.casefmt;
    Object.keys(DEFAULTS).forEach(function(k){if(typeof DEFAULTS[k]==='boolean'&&typeof data[k]==='boolean')prefs[k]=data[k];});
  }}catch(_e){}

  /* VOID v23.7 — Preset Studio. Serializes only the known appearance schema. */
  var PRESET_KEY='harbor.void.presets.v1',PRESET_MAX=20,PRESET_FILE_MAX=65536;
  var presetRows=[],presetActive='',presetDeletePending='';
  var presetColors={carbon:'#ececf0',night:'#96b0d6',bone:'#e0d2be',ember:'#e66e46',netflix:'#e50914',hbo:'#687eff',mocha:'#cba6f7'};
  function presetSnapshot(){var o={};Object.keys(DEFAULTS).forEach(function(k){o[k]=prefs[k];});return o;}
  function presetSanitize(s){if(!s||typeof s!=='object'||Array.isArray(s))return null;
    var out={},valid=0;
    Object.keys(DEFAULTS).forEach(function(k){var v=s[k];if(typeof DEFAULTS[k]==='boolean'){
      if(typeof v==='boolean'){out[k]=v;valid++;}
    }else if(k==='mood'&&MOODS.indexOf(v)>-1){out[k]=v;valid++;}
    else if(k==='ranks'&&['chips','numerals','off'].indexOf(v)>-1){out[k]=v;valid++;}
    else if(k==='corners'&&['round','sharp'].indexOf(v)>-1){out[k]=v;valid++;}
    else if(k==='casefmt'&&['bluray','dvd'].indexOf(v)>-1){out[k]=v;valid++;}
    else if(k==='typography'&&['signature','modern','custom'].indexOf(v)>-1){out[k]=v;valid++;}
    });return valid?out:null;
  }
  function presetCleanName(v){return String(v||'').replace(/[\x00-\x1F\x7F]/g,' ').replace(/\s+/g,' ').trim().slice(0,42);}
  function presetLoad(){try{var v=JSON.parse(localStorage.getItem(PRESET_KEY)||'{}');if(v&&v.version===1&&Array.isArray(v.presets)){
      presetRows=v.presets.slice(0,PRESET_MAX).map(function(row){var settings=presetSanitize(row&&row.settings),name=presetCleanName(row&&row.name);
        if(!settings||!name)return null;
        return{id:typeof row.id==='string'?row.id.slice(0,64):'',name:name,settings:settings,updatedAt:Number(row.updatedAt)||0};
      }).filter(Boolean);presetRows.forEach(function(row,i){if(!row.id||presetRows.findIndex(function(r){return r.id===row.id;})!==i)row.id='legacy-'+i;});
      presetActive=typeof v.activeId==='string'&&presetRows.some(function(row){return row.id===v.activeId;})?v.activeId:'';
    }}catch(_e){presetRows=[];presetActive='';}}
  function presetStore(){try{localStorage.setItem(PRESET_KEY,JSON.stringify({version:1,activeId:presetActive,presets:presetRows}));return true;}catch(_e){return false;}}
  function presetFeedback(message,kind){if(!panel)return;var el=q('[data-v-studio-feedback]',panel);if(el){el.textContent=message||'';el.dataset.kind=kind||'';}}
  function presetMatch(row){if(!row)return false;return Object.keys(DEFAULTS).every(function(k){return row.settings[k]===undefined||row.settings[k]===prefs[k];});}
  function presetStatus(){if(!panel)return;var out=q('[data-v-studio-status]',panel);if(!out)return;
    var row=presetRows.find(function(r){return r.id===presetActive;});
    out.textContent=row?(row.name+' · '+(presetMatch(row)?tx('Saved'):(arabicMode?'معدّل — احفظ التغييرات للتحديث':'Modified — save changes to update'))):tx('Current appearance · no preset loaded');
  }
  function presetLabel(row){var name=(row.settings.mood||'carbon').replace(/^./,function(c){return c.toUpperCase();});return tx(name);}
  function presetButton(label,action,id,primary){var el=doc.createElement('button');el.type='button';el.className='v-studio-btn';el.dataset.vPresetAction=action;
    if(id)el.dataset.vPresetId=id;if(primary)el.dataset.primary='true';el.textContent=label;return el;}
  function presetRender(){if(!panel)return;var list=q('[data-v-studio-list]',panel);if(!list)return;list.replaceChildren();
    if(!presetRows.length){var empty=doc.createElement('p');empty.className='v-studio-empty';empty.textContent=tx('No presets saved yet.');list.appendChild(empty);}
    presetRows.forEach(function(row){
      var card=doc.createElement('div');card.className='v-studio-row';card.dataset.current=String(row.id===presetActive);
      var head=doc.createElement('div');head.className='v-studio-row-head';
      var swatch=doc.createElement('span');swatch.className='v-studio-swatch';swatch.style.background=presetColors[row.settings.mood]||presetColors.carbon;
      var copy=doc.createElement('div');copy.className='v-studio-row-text';
      var name=doc.createElement('strong');name.className='v-studio-row-title';name.textContent=row.name;name.title=row.name;
      var sub=doc.createElement('small');sub.className='v-studio-row-sub';sub.textContent=presetLabel(row)+(row.id===presetActive?' · '+(presetMatch(row)?tx('Active'):tx('Modified')):'');
      copy.append(name,sub);head.append(swatch,copy);
      var buttons=doc.createElement('div');buttons.className='v-studio-row-actions';
      buttons.append(presetButton(tx('Apply'),'apply',row.id,true),presetButton(tx('Export'),'export',row.id),presetButton(tx('Delete'),'delete',row.id));
      card.append(head,buttons);list.appendChild(card);
    });
    var count=q('[data-v-studio-count]',panel);if(count)count.textContent=presetRows.length+' / '+PRESET_MAX;
    presetStatus();if(arabicMode)localeText(list);
  }
  function presetUniqueName(name){var candidate=name,i=2;while(presetRows.some(function(r){return r.name.toLowerCase()===candidate.toLowerCase();})&&i<=100){var suffix=' ('+(i++)+')';candidate=name.slice(0,42-suffix.length)+suffix;}return candidate;}
  function presetFile(row){return{format:'void-preset',version:1,theme:'VOID',name:row.name,settings:row.settings};}
  function presetExport(data,label){var raw=JSON.stringify(data,null,2),textarea=panel&&q('[data-v-studio-json]',panel);if(textarea)textarea.value=raw;
    try{var url=URL.createObjectURL(new Blob([raw],{type:'application/json'}));var a=doc.createElement('a');a.href=url;
      a.download=(label||'VOID-presets').replace(/[^a-z0-9_-]+/gi,'-').slice(0,60)+'.json';doc.body.appendChild(a);a.click();a.remove();win.setTimeout(function(){URL.revokeObjectURL(url);},1200);
      presetFeedback('JSON exported; also available in the text box.','success');}
    catch(_e){presetFeedback('JSON is in the text box. Copy it to share.','success');}
  }
  function presetImport(raw){if(!raw||raw.length>PRESET_FILE_MAX){presetFeedback('Invalid or oversized JSON (64 KB limit).','error');return;}
    var parsed;try{parsed=JSON.parse(raw);}catch(_e){presetFeedback('JSON could not be parsed.','error');return;}
    if(!parsed||parsed.version!==1||['void-preset','void-presets'].indexOf(parsed.format)<0){presetFeedback('Not a VOID preset export (version 1).','error');return;}
    var incoming=parsed.format==='void-presets'?parsed.presets:[parsed];
    if(!Array.isArray(incoming)||!incoming.length||incoming.length>PRESET_MAX){presetFeedback('Preset bundle must contain 1–'+PRESET_MAX+' entries.','error');return;}
    var valid=[];incoming.forEach(function(v){var st=presetSanitize(v&&v.settings),name=presetCleanName(v&&v.name);if(st&&name)valid.push({name:name,settings:st});});
    if(!valid.length){presetFeedback('No valid appearance presets found.','error');return;}
    var left=PRESET_MAX-presetRows.length;
    if(left<valid.length){presetFeedback('Not enough space: '+left+' slots remaining (max '+PRESET_MAX+').','error');return;}
    var added=[];valid.forEach(function(v){var row={id:'p-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,9),name:presetUniqueName(v.name),settings:v.settings,updatedAt:Date.now()};presetRows.push(row);added.push(row);});
    if(!presetStore()){presetRows.splice(presetRows.length-added.length,added.length);presetFeedback('Could not save imported presets to local storage.','error');return;}
    presetRender();presetFeedback('Imported '+added.length+' preset'+(added.length===1?'':'s')+'. Apply one to switch.','success');
  }
  function presetCancelDelete(){if(!presetDeletePending)return;
    var pending=presetDeletePending;presetDeletePending='';
    if(panel)qa('[data-v-preset-action="delete"]',panel).forEach(function(button){if(button.dataset.vPresetId===pending){button.textContent=tx('Delete');button.removeAttribute('data-confirm');}});
  }
  function presetAction(b){var act=b.dataset.vPresetAction,id=b.dataset.vPresetId||'',row=presetRows.find(function(r){return r.id===id;});
    if(presetDeletePending&&(act!=='delete'||id!==presetDeletePending))presetCancelDelete();
    var nameField=panel&&q('[data-v-studio-name]',panel);
    if(act==='save'){
      if(presetRows.length>=PRESET_MAX){presetFeedback('Preset limit reached (20).','error');return;}
      var name=presetCleanName(nameField&&nameField.value);
      if(!name){presetFeedback('Enter a name for this preset.','error');if(nameField)nameField.focus();return;}
      if(presetRows.some(function(r){return r.name.toLowerCase()===name.toLowerCase();})){presetFeedback('That name is already used. Apply it and choose Update loaded.','error');return;}
      var newRow={id:'p-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,9),name:name,settings:presetSnapshot(),updatedAt:Date.now()};
      var previousActive=presetActive;
      presetRows.push(newRow);presetActive=newRow.id;
      if(!presetStore()){presetRows.pop();presetActive=previousActive;presetFeedback('Could not save to local storage.','error');return;}
      presetRender();presetFeedback('Saved '+name+'.','success');if(nameField)nameField.value='';return;
    }
    if(act==='update'){
      row=presetRows.find(function(r){return r.id===presetActive;});if(!row){presetFeedback('Apply a saved preset first, or save a new one.','error');return;}
      var previousSettings=row.settings,previousUpdatedAt=row.updatedAt;
      row.settings=presetSnapshot();row.updatedAt=Date.now();
      if(!presetStore()){row.settings=previousSettings;row.updatedAt=previousUpdatedAt;presetFeedback('Could not save updated preset.','error');return;}
      presetRender();presetFeedback('Updated '+row.name+'.','success');return;
    }
    if(act==='apply'){
      if(!row)return;prefs=Object.assign({},prefs,row.settings);presetActive=row.id;applyPrefs();presetStore();presetRender();presetFeedback('Applied '+row.name+'.','success');return;
    }
    if(act==='delete'){
      if(!row)return;
      if(presetDeletePending!==row.id){presetDeletePending=row.id;b.textContent='Confirm delete';b.dataset.confirm='true';presetFeedback('Click Confirm delete again to remove '+row.name+'.');return;}
      var beforeRows=presetRows,beforeActive=presetActive;
      presetDeletePending='';presetRows=presetRows.filter(function(r){return r.id!==row.id;});if(presetActive===row.id)presetActive='';
      if(!presetStore()){presetRows=beforeRows;presetActive=beforeActive;presetRender();presetFeedback('Could not delete preset: local storage unavailable.','error');return;}
      presetRender();presetFeedback('Preset removed. Your current appearance is unchanged.','success');return;
    }
    if(act==='export'){
      if(row)presetExport(presetFile(row),'VOID-'+row.name);return;
    }
    if(act==='export-all'){
      if(!presetRows.length){presetFeedback('Save a preset first.','error');return;}
      presetExport({format:'void-presets',version:1,theme:'VOID',presets:presetRows.map(presetFile)},'VOID-all-presets');return;
    }
    if(act==='choose-file'){var file=panel&&q('[data-v-studio-file]',panel);if(file)file.click();return;}
    if(act==='import-text'){var txt=panel&&q('[data-v-studio-json]',panel);presetImport((txt&&txt.value||'').trim());return;}
    if(act==='copy-json'){var t=panel&&q('[data-v-studio-json]',panel);if(t&&!t.value.trim()){presetFeedback('Export a preset first or paste JSON.','error');return;}
      if(t){var fallback=function(){t.focus();t.select();var copied=false;
          try{copied=!!doc.execCommand('copy');}catch(_e){}
          presetFeedback(copied?'JSON copied to clipboard.':'JSON selected; press Ctrl+C to copy.',copied?'success':'');};
        if(win.navigator.clipboard&&win.navigator.clipboard.writeText){win.navigator.clipboard.writeText(t.value).then(function(){if(live)presetFeedback('JSON copied to clipboard.','success');}).catch(function(){if(live)fallback();});}
        else fallback();}
    }
  }
  presetLoad();

  try{var fi=parseInt(sessionStorage.getItem(FLOWKEY)||'',10);if(isFinite(fi)&&fi>=0)flowIdx=fi;}catch(_e){}
  function activeMain(){var ms=doc.querySelectorAll('main');for(var i=0;i<ms.length;i++){var m=ms[i];if(!m.closest('[hidden],[inert],[data-layer-inactive],[aria-hidden="true"]')&&m.getClientRects().length)return m;}return null;}
  function q(s,h){if(!h&&s==='main')return activeMain();if(!h&&s.indexOf('main ')===0){var m=activeMain();return m?m.querySelector(s.slice(5)):null;}return(h||doc).querySelector(s);}
  function qa(s,h){if(!h&&s.indexOf('main ')===0){var m=activeMain();return m?Array.prototype.slice.call(m.querySelectorAll(s.slice(5))):[];}return Array.prototype.slice.call((h||doc).querySelectorAll(s));}
  function listen(t,type,fn,o){if(t)t.addEventListener(type,fn,Object.assign({},o||{},{signal:abort.signal}));}
  /* User fonts are stored as binary in IndexedDB, never in localStorage, exported presets,
     a remote URL, or the .harborstyle package. No Harbor-specific private APIs required. */
  var FONT_DB='harbor.void.user-fonts.v1',FONT_STORE='fontfiles',FONT_ID='heading',FONT_MAX=8*1024*1024;
  var customFace=null,customName='',fontBusy=false,fontMessage='',fontKind='',fontSeq=0;
  function fontNotice(message,kind){fontMessage=message||'';fontKind=kind||'';fontUpdateUI();}
  function fontUpdateUI(){if(!panel)return;
    var display=q('[data-v-font-current]',panel),remove=q('[data-v-action="remove-font"]',panel),upload=q('[data-v-action="upload-font"]',panel),status=q('[data-v-font-status]',panel);
    if(display)display.textContent=customName?((arabicMode?'الخط الحالي: ':'Current font: ')+customName):(arabicMode?'لم يتم رفع أي خط':'No font uploaded');
    if(remove)remove.disabled=!customName||fontBusy;
    if(upload)upload.disabled=fontBusy;
    if(status){status.textContent=fontMessage||((arabicMode?'WOFF2 وWOFF وTTF وOTF · بحد أقصى ٨ ميغابايت. الخط محفوظ على هذا الجهاز فقط ولا يُدرج في ملفات الإعدادات المشتركة.':'WOFF2, WOFF, TTF, OTF · max 8 MB. Saved only on this device, not included in exported presets.'));status.dataset.kind=fontKind;}
  }
  function fontDB(){return new Promise(function(resolve,reject){
    if(!win.indexedDB){reject(new Error('IndexedDB unavailable'));return;}
    var req;try{req=win.indexedDB.open(FONT_DB,1);}catch(err){reject(err);return;}
    req.onupgradeneeded=function(){var db=req.result;if(!db.objectStoreNames.contains(FONT_STORE))db.createObjectStore(FONT_STORE,{keyPath:'id'});};
    req.onerror=function(){reject(req.error||new Error('Font database failed'));};
    req.onblocked=function(){reject(new Error('Font database blocked'));};
    req.onsuccess=function(){resolve(req.result);};
  });}
  function fontTransaction(kind,record){return fontDB().then(function(db){return new Promise(function(resolve,reject){
    var tx,request,result;try{tx=db.transaction(FONT_STORE,kind==='get'?'readonly':'readwrite');
      var store=tx.objectStore(FONT_STORE);
      request=kind==='get'?store.get(FONT_ID):kind==='put'?store.put(record):store.delete(FONT_ID);
    }catch(err){db.close();reject(err);return;}
    request.onsuccess=function(){result=request.result;};
    tx.oncomplete=function(){db.close();resolve(result);};
    tx.onerror=function(){db.close();reject(tx.error||new Error('Font storage failed'));};
    tx.onabort=function(){db.close();reject(tx.error||new Error('Font storage cancelled'));};
  });});}
  function fontHeaderValid(ab){if(!(ab instanceof ArrayBuffer)||ab.byteLength<4)return false;
    var b=new Uint8Array(ab,0,4),sig=String.fromCharCode(b[0],b[1],b[2],b[3]);
    return sig==='wOFF'||sig==='wOF2'||sig==='OTTO'||sig==='true'||sig==='typ1'||(b[0]===0&&b[1]===1&&b[2]===0&&b[3]===0);
  }
  async function fontPrepare(ab){if(!doc.fonts||!win.FontFace)throw new Error('Font loading unsupported');
    if(!fontHeaderValid(ab)||ab.byteLength>FONT_MAX)throw new Error('Not a supported font file');
    var face=new FontFace('VOID User Typeface',ab,{style:'normal',weight:'400 900'});
    await face.load();return face;
  }
  function fontActivate(face,name){if(customFace){try{doc.fonts.delete(customFace);}catch(_e){}}
    customFace=face;customName=name;doc.fonts.add(face);root.setAttribute('data-v-custom-font','ready');
    fontUpdateUI();schedule(true);
  }
  function fontPick(){if(!panel||fontBusy)return;var input=q('[data-v-font-file]',panel);if(input){input.value='';input.click();}}
  async function fontUpload(file){if(fontBusy||!file)return;
    if(!/\.(woff2?|ttf|otf)$/i.test(file.name||'')){fontNotice(arabicMode?'اختر ملف WOFF2 أو WOFF أو TTF أو OTF.':'Choose a WOFF2, WOFF, TTF, or OTF font.','error');return;}
    if(!file.size||file.size>FONT_MAX){fontNotice(arabicMode?'الحد الأقصى لحجم ملف الخط هو ٨ ميغابايت.':'Font must be nonempty and at most 8 MB.','error');return;}
    var ticket=++fontSeq;fontBusy=true;fontNotice(arabicMode?'جارٍ فحص الخط…':'Validating font…','');
    try{var bytes=await file.arrayBuffer();var face=await fontPrepare(bytes);if(!live||ticket!==fontSeq)return;
      var persist=true;try{await fontTransaction('put',{id:FONT_ID,bytes:bytes,name:file.name.slice(0,110),savedAt:Date.now()});}
      catch(_storageError){persist=false;}
      if(!live||ticket!==fontSeq)return;
      fontActivate(face,file.name.slice(0,110));prefs.typography='custom';applyPrefs();
      fontNotice(persist?(arabicMode?'تم حفظ الخط على هذا الجهاز.':'Font saved on this device.'):(arabicMode?'الخط يعمل الآن، لكن تعذّر حفظه؛ أعد رفعه بعد إعادة التشغيل.':'Font active for this session only. Device storage was unavailable.'),persist?'success':'error');
    }catch(_err){if(live&&ticket===fontSeq)fontNotice(arabicMode?'تعذّر قراءة الخط أو تحميله. جرّب ملفاً آخر.':'Font could not be loaded. Try another valid font file.','error');}
    finally{if(ticket===fontSeq){fontBusy=false;fontUpdateUI();}}
  }
  async function fontRestore(){var ticket=++fontSeq;fontBusy=true;fontUpdateUI();
    try{var record=await fontTransaction('get');if(!live||ticket!==fontSeq)return;
      if(record&&record.bytes&&typeof record.name==='string'){
        var face=await fontPrepare(record.bytes);if(!live||ticket!==fontSeq)return;
        fontActivate(face,record.name);fontNotice('','');
      }else if(prefs.typography==='custom')fontNotice(arabicMode?'الخط المخصص غير موجود على هذا الجهاز. اختر ملفاً.':'No custom font saved on this device. Choose a file.','error');
    }catch(_err){if(live&&ticket===fontSeq&&prefs.typography==='custom')fontNotice(arabicMode?'تعذّر تحميل الخط المحفوظ. يمكنك رفعه مجدداً.':'Could not restore saved font. You can upload it again.','error');}
    finally{if(ticket===fontSeq){fontBusy=false;fontUpdateUI();}}
  }
  async function fontRemove(){if(fontBusy||!customName)return;var ticket=++fontSeq;fontBusy=true;fontUpdateUI();
    try{await fontTransaction('delete');if(!live||ticket!==fontSeq)return;
      if(customFace){try{doc.fonts.delete(customFace);}catch(_e){}}
      customFace=null;customName='';root.removeAttribute('data-v-custom-font');
      if(prefs.typography==='custom'){prefs.typography='signature';applyPrefs();}
      fontNotice(arabicMode?'تم حذف الخط المحلي.':'Custom font removed.','success');
    }catch(_err){if(live&&ticket===fontSeq)fontNotice(arabicMode?'تعذّر حذف الخط المخزن. أعد المحاولة.':'Could not remove the stored font. Try again.','error');}
    finally{if(ticket===fontSeq){fontBusy=false;fontUpdateUI();}}
