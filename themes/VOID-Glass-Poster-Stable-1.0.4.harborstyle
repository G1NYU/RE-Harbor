    try{
      var a=el.animate(
        [{transform:'rotate(0deg)'},{transform:'rotate(360deg)'}],
        {duration:part.duration,iterations:Infinity,easing:'linear',fill:'both'}
      );
      a.pause();
      part.el=el;part.a=a;part.rate=0;part.goal=0;
      el.setAttribute('data-v-motor','');
    }catch(_e){part.a=null;part.el=null;}
  }
  function motorRate(part,rate){
    if(!part.a)return;
    rate=Math.max(0,Math.min(2.2,rate));
    if(rate<=.001){
      if(part.a.playState!=='paused')part.a.pause();
      return;
    }
    if(part.a.playState!=='running'){
      // Establish the timeline at a positive rate before ramping.
      part.a.playbackRate=Math.max(rate,.12);
      part.a.play();
      return;
    }
    if(part.a.pending||Math.abs(part.a.playbackRate-rate)<.002)return;
    try{part.a.playbackRate=rate;}
    catch(_e){try{part.a.updatePlaybackRate(rate);}catch(_ignored){}}
  }
