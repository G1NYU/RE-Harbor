  var arabicGlyphs=/[\u0600-\u06ff\u0750-\u077f\u08a0-\u08ff\ufb50-\ufdff\ufe70-\ufeff]/;
  var rtlGlyphs=/[\u0590-\u08ff\ufb1d-\ufdff\ufe70-\ufeff]/;
  var originalText=new WeakMap(),originalAttrs=new WeakMap();
  function tx(s){return arabicMode&&Object.prototype.hasOwnProperty.call(AR_TEXT,s)?AR_TEXT[s]:s;}
  function isArabicString(s){return arabicGlyphs.test(s||'');}
  function localeText(host){if(!host)return;
    var walker=doc.createTreeWalker(host,NodeFilter.SHOW_TEXT),n;
    while((n=walker.nextNode())){
      if(n.parentElement&&n.parentElement.closest('script,style,svg,kbd,.v-logo,[data-v-studio-json],textarea'))continue;
      var orig=originalText.has(n)?originalText.get(n):n.nodeValue;
      var match=orig.match(/^(\s*)([\s\S]*?)(\s*)$/);
      if(!match)continue;
      var t=match[2],translated=AR_TEXT[t];
      if(translated){if(!originalText.has(n))originalText.set(n,orig);
        var replacement=arabicMode?match[1]+translated+match[3]:orig;
        if(n.nodeValue!==replacement)n.nodeValue=replacement;
      }
    }
    var props=['aria-label','title','placeholder'];
    host.querySelectorAll('[aria-label],[title],[placeholder]').forEach(function(el){
      props.forEach(function(prop){if(!el.hasAttribute(prop))return;
        var saved=originalAttrs.get(el)||{},orig=Object.prototype.hasOwnProperty.call(saved,prop)?saved[prop]:el.getAttribute(prop);
        if(!Object.prototype.hasOwnProperty.call(AR_TEXT,orig))return;
        if(!Object.prototype.hasOwnProperty.call(saved,prop)){saved[prop]=orig;originalAttrs.set(el,saved);}
        var value=arabicMode?AR_TEXT[orig]:orig;
        if(el.getAttribute(prop)!==value)el.setAttribute(prop,value);
      });
    });
  }
  function nativeLocale(){var items=nativeItems(),sidebar=native(),app=sidebar&&sidebar.parentElement;
    var languages=[root.getAttribute('lang'),doc.body&&doc.body.getAttribute('lang'),app&&app.getAttribute('lang')].filter(Boolean);
    var hasArabicNav=items.some(function(it){return isArabicString(it.label)||isArabicString(it.node.textContent);});
    var ar=languages.some(function(s){return /^ar(?:-|$)/i.test(s);})||hasArabicNav;
    var directions=[root.getAttribute('dir'),doc.body&&doc.body.getAttribute('dir'),app&&app.getAttribute('dir')].filter(Boolean);
    var inheritedRtl=!!sidebar&&win.getComputedStyle(sidebar).direction==='rtl';
    var rtl=ar||inheritedRtl||directions.some(function(s){return s.toLowerCase()==='rtl';})||items.some(function(it){return rtlGlyphs.test(it.label||'')||rtlGlyphs.test(it.node.textContent||'');});
    return{rtl:rtl,arabic:ar};
  }
  function syncLocale(){var mode=nativeLocale(),key=(mode.rtl?'rtl':'ltr')+'-'+(mode.arabic?'ar':'other');
    if(localeSeen===key)return false;
    localeSeen=key;rtlMode=mode.rtl;arabicMode=mode.arabic;
    root.setAttribute('data-v-rtl',rtlMode?'on':'off');root.setAttribute('data-v-arabic',arabicMode?'on':'off');
    [rail,edge,panel,jump,shortcuts].forEach(function(el){if(el)el.setAttribute('dir',rtlMode?'rtl':'ltr');});
    [rail,edge,panel,jump,shortcuts,hub,topBtn,musicDesk,musicFull].forEach(localeText);
    if(panel){presetRender();presetFeedback('');if(!fontBusy){fontMessage='';fontKind='';if(prefs.typography==='custom'&&!customFace){fontMessage=arabicMode?'الخط المخصص غير موجود على هذا الجهاز. اختر ملفاً.':'No custom font saved on this device. Choose a file.';fontKind='error';}}fontUpdateUI();}
    if(rail){var nav=q('[data-v-nav]',rail);if(nav)delete nav.dataset.key;}
    return true;
  }
  function navLabel(it){if(!arabicMode)return names[it.id]||it.label||it.id;
    return isArabicString(it.label)?it.label:AR_NAV[it.id]||it.label||it.id;
  }

  function navTo(id){var it=nativeItems().find(function(x){return x.id===id;});if(it&&it.node.isConnected){it.node.click();return true;}return false;}
  function activeItem(items){return items.find(function(x){var active=x.node.getAttribute('data-active');return (active!==null&&active!=='false'&&active!=='0')||x.node.getAttribute('aria-current')==='page'||x.node.getAttribute('aria-selected')==='true';});}
  function setPage(id){if(root.getAttribute('data-v-page')===id)return;root.setAttribute('data-v-page',id);
    if(lastPage!==null&&prefs.fade){root.setAttribute('data-v-entering','');clearTimeout(enterT);enterT=win.setTimeout(function(){root.removeAttribute('data-v-entering');},300);}
    lastPage=id;}
  function syncNav(items){var a=activeItem(items);setPage(a?a.id:'');var setting=items.some(function(x){return x.id==='settings';});var sb=q('[data-v-view="settings"]',rail);if(sb)sb.hidden=!setting;
    qa('[data-v-view]',rail).forEach(function(el){var on=Boolean(a&&a.id===el.dataset.vView);var cur=el.getAttribute('data-active')==='true';if(on!==cur){el.setAttribute('data-active',String(on));if(on)el.setAttribute('aria-current','page');else el.removeAttribute('aria-current');}});}
  function buildNav(){if(!rail)return;syncLocale();var host=q('[data-v-nav]',rail);var items=nativeItems();var key=items.map(function(x){return x.id+':'+x.label;}).join('|');
    if(!items.length){root.removeAttribute('data-v-nav');return;}
    if(host.dataset.key===key){syncNav(items);if(root.getAttribute('data-v-nav')!=='ready')root.setAttribute('data-v-nav','ready');return;}
    host.dataset.key=key;host.replaceChildren();
    var buckets=groups.map(function(){return[];});
    groups.forEach(function(g,gi){g[1].forEach(function(id){var it=items.find(function(i){return i.id===id;});if(it)buckets[gi].push(it);});});
    items.forEach(function(it){if(it.id==='settings')return;var known=groups.some(function(g){return g[1].indexOf(it.id)>-1;});if(!known)buckets[groupOf(it)].push(it);});
    buckets.forEach(function(list,gi){if(!list.length)return;
      if(groups[gi][0]){var l=doc.createElement('div');l.className='v-nav-label';l.textContent=tx(groups[gi][0]);host.appendChild(l);}
      list.forEach(function(it){var b=doc.createElement('button');b.className='v-navbtn';b.type='button';b.dataset.vView=it.id;var n=navLabel(it);b.setAttribute('aria-label',n);b.title=n;b.innerHTML=icon(iconKey(it.id,it.label))+'<span></span>';b.lastChild.textContent=n;host.appendChild(b);});
    });
    syncNav(items);root.setAttribute('data-v-nav','ready');
  }
  function measureDock(){var d=q('[data-music-dock]');var now=Date.now();
    if(!d){if(dockEl&&dockEl.isConnected)d=dockEl;else if(now-dockScan>2500){dockScan=now;d=qa('[class*="fixed"][class*="bottom-0"]').find(function(el){if(el.closest('#v-rail,#v-panel,#v-jump'))return false;var r=el.getBoundingClientRect();return r.width>=win.innerWidth*0.8&&r.height>=36&&r.height<=150&&r.bottom>=win.innerHeight-2&&el.querySelector('button');})||null;dockEl=d;}}
    var h=0;if(d){var r=d.getBoundingClientRect();if((!d.hasAttribute('data-auto-hidden')||musicFull)&&r.height>0&&r.bottom>=win.innerHeight-6&&win.getComputedStyle(d).display!=='none')h=Math.round(r.height);}
    var nv=h+'px';if(root.style.getPropertyValue('--v-dock-h')!==nv)root.style.setProperty('--v-dock-h',nv);}
  function setSide(open){open=!!open;
    if(sideInit&&open===sideOpen)return;
    var restoreFocus=!open&&rail&&rail.contains(doc.activeElement);
    sideInit=true;sideOpen=open;var v=open?'true':'false';
    if(rail){rail.setAttribute('data-open',v);rail.inert=!open;rail.setAttribute('aria-hidden',String(!open));}
    if(edge){edge.setAttribute('data-open',v);edge.setAttribute('aria-expanded',v);
      edge.tabIndex=open||prefs.pin?-1:0;
      edge.setAttribute('aria-label',tx(open?'VOID navigation open':'Open VOID navigation'));}
    if(restoreFocus&&edge)edge.focus({preventScroll:true});
    // Preserve the active destination in view on smaller screens and long menus.
    if(open){win.requestAnimationFrame(function(){if(!live||!sideOpen||!rail)return;
      var selected=q('.v-navbtn[data-active="true"]',rail),nav=q('[data-v-nav]',rail);
      if(selected&&nav){var a=selected.getBoundingClientRect(),n=nav.getBoundingClientRect();
        if(a.top<n.top)nav.scrollTop-=n.top-a.top+9;
        else if(a.bottom>n.bottom)nav.scrollTop+=a.bottom-n.bottom+9;}
    });}
  }
  function scheduleClose(delay){clearTimeout(closeT);if(prefs.pin)return;closeT=win.setTimeout(function(){closeT=0;if(!live||prefs.pin||!rail)return;if(rail.matches(':hover')||rail.contains(doc.activeElement))return;setSide(false);},delay||380);}
  function togglePanel(v){if(!panel)return;var show=typeof v==='boolean'?v:panel.hidden;if(show===!panel.hidden)return;
    if(show){if(jump&&!jump.hidden)closeJump();if(shortcuts&&!shortcuts.hidden)closeShortcuts();
      panelFocus=doc.activeElement;panel.hidden=false;var c=q('[data-v-action="close-panel"]',panel);if(c)c.focus({preventScroll:true});}
    else{presetCancelDelete();panel.hidden=true;if(panelFocus&&panelFocus.isConnected&&!panelFocus.closest('[inert]'))panelFocus.focus({preventScroll:true});panelFocus=null;}}
  function applyPrefs(){
    root.setAttribute('data-v-mood',prefs.mood);root.setAttribute('data-v-pin',prefs.pin?'on':'off');root.setAttribute('data-v-ranks',prefs.ranks);root.setAttribute('data-v-corners',prefs.corners);root.setAttribute('data-v-casefmt',prefs.casefmt);root.setAttribute('data-v-typography',prefs.typography);
    if(musicHost)motorSync();
    root.setAttribute('data-v-accent',(prefs.accent&&NEUTRAL.indexOf(prefs.mood)>-1)?'on':'off');
