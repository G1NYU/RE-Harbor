# Harbor Style
# VOID — signature Harbor theme, refined and release-tested.
name: VOID Glass - Poster Stable
blurb: A refined cinematic Harbor experience with tactile media details, polished navigation, flexible moods and native actions. By giinyu.
layout: sidebar
card: flat
button: flat
font: general-sans
bokeh: false
swatch: #060607, #141416, #ececf0

@tokens
--color-canvas: #060607
--color-surface: #0d0d0f
--color-elevated: #141416
--color-raised: #1c1c1f
--color-ink: #f3f3f5
--color-ink-muted: #b4b4ba
--color-ink-subtle: #7c7c84
--color-edge: #ffffff22
--color-edge-soft: #ffffff10
--color-accent: #ececf0
--color-accent-soft: #ececf026
--color-danger: #ff6b6b

@css
@import url("https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Arabic:wght@400;500;600;700;800&family=Syne:wght@500;600;700;800&family=Permanent+Marker&display=swap");
/* VOID v17 — carbon black, flat surfaces, light glass. Harbor 1.0.3 ready: full hero without touching Harbor's setting, Top 10 row that fills its width. Fonts: Inter Tight + Inter (SIL OFL). */

html[data-v-ready]{
  --v-display:'Inter Tight','Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
  --v-text:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
  --v-ease:cubic-bezier(.16,1,.3,1);
  --v-side:272px;--v-dock-h:0px;--v-overlap:clamp(40px,6vw,96px);
  --v-bg-rgb:6,6,7;--v-a-rgb:236,236,240;--v-ac-rgb:var(--v-a-rgb);
  --v-flat:#0b0b0d;--v-flat-2:#111114;--v-hair:rgba(255,255,255,.08);
  --v-glass:linear-gradient(150deg,rgba(255,255,255,.07),rgba(255,255,255,.024));
  --v-rim:rgba(255,255,255,.11);
  --v-r:14px;
  --font-sans:var(--v-text);--font-display:var(--v-display);
  --color-accent:rgb(var(--v-a-rgb));--color-accent-soft:rgba(var(--v-a-rgb),.16);
  color-scheme:dark;caret-color:rgb(var(--v-ac-rgb));
}
html[data-v-mood="carbon"]{--v-bg-rgb:6,6,7;--v-a-rgb:236,236,240;--color-canvas:#060607!important;}
html[data-v-mood="night"]{--v-bg-rgb:4,6,10;--v-a-rgb:150,176,214;--color-canvas:#04060a!important;--v-flat:#090c11;--v-flat-2:#0e1218;}
html[data-v-mood="bone"]{--v-bg-rgb:8,7,6;--v-a-rgb:224,210,190;--color-canvas:#080706!important;--v-flat:#0e0c0a;--v-flat-2:#14110e;}
html[data-v-mood="ember"]{--v-bg-rgb:9,6,5;--v-a-rgb:230,110,70;--color-canvas:#090605!important;--v-flat:#100a08;--v-flat-2:#170f0c;}
html[data-v-mood="netflix"]{--v-bg-rgb:8,8,8;--v-a-rgb:229,9,20;--color-canvas:#080808!important;--color-surface:#101010!important;--color-elevated:#171717!important;--color-raised:#202020!important;--v-flat:#101010;--v-flat-2:#171717;}
html[data-v-mood="hbo"]{--v-bg-rgb:5,6,14;--v-a-rgb:104,126,255;--color-canvas:#05060e!important;--color-surface:#0b0d1a!important;--color-elevated:#11142a!important;--color-raised:#191d38!important;--v-flat:#0b0d1a;--v-flat-2:#11142a;}
html[data-v-mood="mocha"]{--v-bg-rgb:9,9,14;--v-a-rgb:203,166,247;--color-canvas:#09090e!important;--color-surface:#101018!important;--color-elevated:#161622!important;--color-raised:#1e1e2e!important;--color-ink:#cdd6f4!important;--color-ink-muted:#a6adc8!important;--color-ink-subtle:#7f849c!important;--v-flat:#101018;--v-flat-2:#161622;}
html[data-v-accent="on"][data-v-page="movies"]{--v-ac-rgb:222,170,110;}
html[data-v-accent="on"][data-v-page="shows"]{--v-ac-rgb:128,190,172;}
html[data-v-accent="on"][data-v-page="anime"]{--v-ac-rgb:230,132,172;}
html[data-v-accent="on"][data-v-page="manga"]{--v-ac-rgb:214,190,150;}
html[data-v-accent="on"][data-v-page="music"]{--v-ac-rgb:214,142,122;}
html[data-v-accent="on"][data-v-page="games"]{--v-ac-rgb:150,200,128;}
html[data-v-accent="on"][data-v-page="live"]{--v-ac-rgb:232,104,104;}
html[data-v-accent="on"][data-v-page="sports"]{--v-ac-rgb:116,192,136;}
html[data-v-accent="on"][data-v-page="calendar"]{--v-ac-rgb:134,164,222;}
html[data-v-accent="on"][data-v-page="library"],html[data-v-accent="on"][data-v-page="collections"]{--v-ac-rgb:230,144,164;}
html[data-v-accent="on"][data-v-page="downloads"]{--v-ac-rgb:134,182,222;}
html[data-v-corners="sharp"]{--v-r:4px;}
html[data-v-ready] body{font-family:var(--v-text);}
html[data-v-ready] :is(h1,h2,h3,h4){font-family:var(--v-display)!important;letter-spacing:-.02em!important;}
html[data-v-ready] ::selection{background:rgba(var(--v-ac-rgb),.3);color:#fff;}
html[data-v-ready] main{scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.14) transparent;}
html[data-v-ready] main:hover{scrollbar-color:rgba(255,255,255,.28) transparent;}
html[data-v-ready] :focus-visible{outline-color:rgba(var(--v-ac-rgb),.9);}
html[data-v-ready] main :is(.bg-elevated\/40,.bg-elevated\/60){background:var(--v-flat)!important;border-color:var(--v-hair)!important;box-shadow:none!important;--tw-ring-shadow:0 0 #0000!important;}
html[data-v-ready] main [class*="text-ink-subtle"]:is(button,a):hover{color:#fff;}
html[data-v-fade="on"][data-v-entering] main .harbor-hero-content{animation:v-enter .25s var(--v-ease);}
@keyframes v-enter{from{opacity:0}}
html[data-v-calm="on"] :is(.harbor-shimmer,.animate-shimmer){animation:none!important;}

#v-progress{position:fixed;z-index:150;left:0;right:0;top:0;height:2px;pointer-events:none;}
#v-progress i{display:block;height:100%;width:100%;background:rgb(var(--v-ac-rgb));transform:scaleX(0);transform-origin:left;will-change:transform;}
html[data-v-bar="off"] #v-progress{display:none;}

html[data-v-nav="ready"] aside[data-harbor-sidebar]{flex:0 0 0!important;width:0!important;min-width:0!important;max-width:0!important;opacity:0!important;border:0!important;overflow:hidden!important;pointer-events:none!important;visibility:hidden!important;}
#v-edge{position:fixed;z-index:139;left:0;top:56px;bottom:var(--v-dock-h,0px);width:26px;}
#v-edge::after{content:"";position:absolute;left:5px;top:50%;width:3px;height:64px;margin-top:-32px;border-radius:3px;background:rgba(255,255,255,.28);transition:opacity .2s,height .3s var(--v-ease),background .2s;}
#v-edge:hover::after{height:96px;margin-top:-48px;background:rgba(255,255,255,.6);}
#v-edge[data-open="true"],html[data-v-pin="on"] #v-edge{pointer-events:none;}
#v-edge[data-open="true"]::after,html[data-v-pin="on"] #v-edge::after{opacity:0;}
#v-rail{position:fixed;z-index:140;left:14px;top:14px;bottom:calc(14px + var(--v-dock-h,0px));width:calc(var(--v-side) - 14px);display:flex;flex-direction:column;border-radius:26px;overflow:hidden;contain:layout paint;will-change:transform,opacity;
  background:var(--v-glass),rgba(var(--v-bg-rgb),.94);border:1px solid var(--v-rim);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 24px 60px -30px rgba(0,0,0,.95);
  transition:transform .24s cubic-bezier(.2,.9,.25,1),opacity .12s ease,visibility 0s;font-family:var(--v-text);color:var(--color-ink);}
#v-rail[data-open="false"]{transform:translate3d(calc(-100% - 40px),0,0);opacity:0;pointer-events:none;visibility:hidden;transition:transform .2s cubic-bezier(.4,0,.8,.4),opacity .14s ease,visibility 0s .2s;}
#v-rail[hidden]{display:none;}
.v-rail-head{display:flex;flex-direction:column;align-items:center;padding:34px 20px 26px;border-bottom:1px solid rgba(255,255,255,.07);}
.v-nav{flex:1;min-height:0;overflow-y:auto;padding:10px 14px 12px;scrollbar-width:none;display:flex;flex-direction:column;gap:2px;}
.v-nav::-webkit-scrollbar{display:none;}
.v-nav-label{margin:22px 14px 8px;font:600 10px var(--v-text);letter-spacing:.24em;text-transform:uppercase;color:rgba(255,255,255,.36);}
.v-nav-label:first-child{margin-top:6px;}
.v-navbtn{appearance:none;border:0;background:transparent;color:var(--color-ink-muted);display:flex;align-items:center;gap:14px;width:100%;height:40px;padding:0 12px 0 14px;border-radius:12px;cursor:pointer;position:relative;text-align:left;font:500 14px var(--v-text);letter-spacing:-.005em;transition:background .2s,color .2s,transform .3s var(--v-ease);}
.v-navbtn svg{width:18px;height:18px;flex:none;fill:currentColor;opacity:.78;transition:opacity .2s;}
.v-navbtn:hover{background:rgba(255,255,255,.06);color:#fff;transform:translateX(2px);}
.v-navbtn:hover svg{opacity:1;}
.v-navbtn[data-active="true"]{color:#fff;background:rgba(255,255,255,.09);}
.v-navbtn[data-active="true"]::before{content:"";position:absolute;left:-14px;top:10px;bottom:10px;width:3px;border-radius:0 3px 3px 0;background:rgb(var(--v-ac-rgb));}
.v-navbtn[data-active="true"] svg{opacity:1;color:rgb(var(--v-ac-rgb));}
.v-navbtn kbd{margin-left:auto;flex:none;display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:24px;height:22px;padding:0 7px;border:1px solid rgba(255,255,255,.16);border-radius:7px;background:rgba(255,255,255,.04);font:600 11px/1 var(--v-text);letter-spacing:.02em;color:rgba(255,255,255,.5);}
.v-navbtn kbd.v-k1{width:24px;padding:0;font-size:12px;}
.v-navbtn kbd.v-k1 span{display:block;transform:translateY(-.5px);}
.v-navbtn:hover kbd{border-color:rgba(255,255,255,.3);color:#fff;}
.v-navbtn:focus-visible{outline:2px solid rgba(255,255,255,.8);outline-offset:-2px;}
.v-rail-foot{padding:10px 14px 16px;border-top:1px solid rgba(255,255,255,.07);display:flex;flex-direction:column;gap:2px;}
@media (min-width:1001px){html[data-v-pin="on"] main.flex-1.overflow-y-auto{padding-left:calc(var(--v-side) + 22px)!important;}}
html[data-v-ready] main.flex-1.overflow-y-auto{transition:padding-left .3s var(--v-ease);}

.v-logo{position:relative;display:inline-block;font:800 21px/1 var(--v-display);letter-spacing:.62em;padding-left:.62em;color:transparent;text-transform:uppercase;white-space:nowrap;user-select:none;}
.v-logo::before,.v-logo::after{content:attr(data-text);position:absolute;left:.62em;top:0;white-space:nowrap;letter-spacing:inherit;color:#f6f6f8;pointer-events:none;}
.v-logo::before{clip-path:inset(0 0 50% 0);transform:translateX(-1.5px);animation:v-g1 8s steps(1) infinite;}
.v-logo::after{clip-path:inset(50% 0 0 0);transform:translateX(1.5px);animation:v-g2 8s steps(1) infinite;}
@keyframes v-g1{0%,68%,100%{clip-path:inset(0 0 50% 0);transform:translateX(-1.5px);text-shadow:none}69%{clip-path:inset(10% 0 62% 0);transform:translateX(-7px);text-shadow:-2px 0 #00e5ff}71%{clip-path:inset(0 0 50% 0);transform:translateX(4px);text-shadow:2px 0 #ff2e7e}73%{clip-path:inset(34% 0 30% 0);transform:translateX(-4px);text-shadow:-2px 0 #00e5ff}75%{clip-path:inset(0 0 50% 0);transform:translateX(-1.5px);text-shadow:none}92%{clip-path:inset(60% 0 8% 0);transform:translateX(-6px);text-shadow:-2px 0 #00e5ff}93.5%{clip-path:inset(0 0 50% 0);transform:translateX(-1.5px);text-shadow:none}}
@keyframes v-g2{0%,68%,100%{clip-path:inset(50% 0 0 0);transform:translateX(1.5px);text-shadow:none}69%{clip-path:inset(58% 0 6% 0);transform:translateX(7px);text-shadow:2px 0 #ff2e7e}71%{clip-path:inset(50% 0 0 0);transform:translateX(-4px);text-shadow:-2px 0 #00e5ff}73%{clip-path:inset(18% 0 52% 0);transform:translateX(5px);text-shadow:2px 0 #ff2e7e}75%{clip-path:inset(50% 0 0 0);transform:translateX(1.5px);text-shadow:none}92%{clip-path:inset(8% 0 62% 0);transform:translateX(6px);text-shadow:2px 0 #ff2e7e}93.5%{clip-path:inset(50% 0 0 0);transform:translateX(1.5px);text-shadow:none}}
html[data-v-glitch="off"] .v-logo::before,html[data-v-glitch="off"] .v-logo::after,html[data-v-motion="off"] .v-logo::before,html[data-v-motion="off"] .v-logo::after,#v-rail[data-open="false"] .v-logo::before,#v-rail[data-open="false"] .v-logo::after{animation:none;}

html[data-v-ready] header:has([data-harbor-topbar-content]){background:transparent!important;border:0!important;box-shadow:none!important;}
html[data-v-scrolled="true"] header:has([data-harbor-topbar-content]){background:linear-gradient(180deg,rgba(var(--v-bg-rgb),.96),rgba(var(--v-bg-rgb),.72))!important;box-shadow:0 1px 0 rgba(255,255,255,.06)!important;}
html[data-v-ready] header [data-harbor-search]{border-radius:999px!important;border:1px solid var(--v-rim)!important;background:var(--v-glass),rgba(var(--v-bg-rgb),.7)!important;box-shadow:none!important;font-family:var(--v-text);transition:border-color .25s;}
html[data-v-ready] header [data-harbor-search]:hover,html[data-v-ready] header [data-harbor-search]:focus-within{border-color:rgba(255,255,255,.4)!important;}
html[data-v-ready] header [data-harbor-topbar-actions] button{border-radius:50%!important;transition:background .2s;}
html[data-v-ready] header [data-harbor-topbar-actions] button:hover{background:rgba(255,255,255,.09)!important;}
.v-hey,.v-clock{display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 14px 0 12px;margin-right:6px;border-radius:999px;border:1px solid var(--v-rim);background:rgba(255,255,255,.04);font:500 13px var(--v-text);color:var(--color-ink-muted);white-space:nowrap;}
.v-hey::before{content:"";width:6px;height:6px;border-radius:50%;background:rgb(var(--v-ac-rgb));}
.v-hey b{font-weight:650;color:#fff;}
.v-clock{padding:0 12px;font-variant-numeric:tabular-nums;letter-spacing:.02em;}
.v-hey[data-float="true"]{position:fixed;z-index:120;top:14px;right:210px;}
html[data-v-hey="off"] .v-hey,html[data-v-clock="off"] .v-clock{display:none;}
@media (max-width:900px){.v-hey,.v-clock{display:none}}

/* home order: hero, Continue Watching, Your Streaming, then the rest. Harbor 1.0.3 slides sit at z-index 10, so Continue Watching is above that. */
html[data-v-order="on"] [data-v-home]{display:flex!important;flex-direction:column!important;}
html[data-v-order="on"] [data-v-ord="1"]{order:1;}
html[data-v-order="on"] [data-v-ord="2"]{order:2;position:relative;z-index:20;margin-top:calc(-1*var(--v-overlap))!important;pointer-events:none;}
html[data-v-order="on"] [data-v-ord="2"] *{pointer-events:auto;}
html[data-v-order="on"] [data-v-ord="3"]{order:3;}
html[data-v-order="on"] [data-v-ord="4"]{order:4;}
html[data-v-order="on"] main [data-tv-hero-zone][data-scroll-anchor="hero"] .harbor-hero-content{padding-bottom:calc(var(--v-overlap) + 28px)!important;}
/* Harbor's own full hero: keep it under the top bar even with Continue Watching set to the top, and let our overlap replace its bottom pull */
html[data-v-order="on"] main [data-tv-hero-zone][data-scroll-anchor="hero"].harbor-hero-full{margin-top:-6rem!important;margin-bottom:0!important;}
@media (min-width:1024px){html[data-v-order="on"] main [data-tv-hero-zone][data-scroll-anchor="hero"].harbor-hero-full{margin-top:-7rem!important;}}
/* theme full hero: the same edge-to-edge look when Harbor's "Full hero banner" setting is off (it defaults to off, without changing Harbor's saved setting) */
html[data-v-hfull="on"] main [data-tv-hero-zone][data-scroll-anchor="hero"]:not(.harbor-hero-full):not(.harbor-anime-hero){margin-inline:-1.25rem;margin-top:-6rem;margin-bottom:0;}
@media (min-width:640px){html[data-v-hfull="on"] main [data-tv-hero-zone][data-scroll-anchor="hero"]:not(.harbor-hero-full):not(.harbor-anime-hero){margin-inline:-2rem;}}
@media (min-width:1024px){html[data-v-hfull="on"] main [data-tv-hero-zone][data-scroll-anchor="hero"]:not(.harbor-hero-full):not(.harbor-anime-hero){margin-top:-7rem;}}
html[data-v-hfull="on"] main [data-tv-hero-zone][data-scroll-anchor="hero"]:not(.harbor-hero-full):not(.harbor-anime-hero) .harbor-hero-stage{height:max(78vh,640px)!important;min-height:640px!important;}
[data-v-lift]{translate:0 var(--v-dy,0px);z-index:40;}

/* Top 10 and other short rows: spread their cards across the full row instead of leaving a blank slot */
html[data-v-fill="on"] [data-v-fillrow]{grid-auto-columns:max(144px,calc((100% - (var(--v-n,10) - 1)*var(--v-gap,20px))/var(--v-n,10)))!important;}

html[data-v-ready] main [data-tv-hero-zone][data-scroll-anchor="hero"] .harbor-hero-stage,html[data-v-ready] main .harbor-bleed-stremio,html[data-v-ready] main .harbor-anime-hero .harbor-hero-bleed,html[data-v-ready] main [data-tv-hero-zone][data-scroll-anchor="hero"] .group.select-none.overflow-hidden{border-radius:0!important;}
html[data-v-ready] main [data-tv-hero-zone][data-scroll-anchor="hero"] .harbor-hero-stage{overflow:hidden;box-shadow:none!important;border:0!important;}
html[data-v-ready] main :is([data-scroll-anchor="hero"] .harbor-hero-stage,.harbor-bleed-stremio) img,html[data-v-ready] main :is([data-scroll-anchor="hero"] .harbor-hero-stage,.harbor-bleed-stremio):hover img{transform:none!important;transition:opacity .6s!important;}
html[data-v-ready] main [data-tv-hero-zone][data-scroll-anchor="hero"] .harbor-hero-stage::after{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(90deg,color-mix(in srgb,var(--color-canvas) 92%,transparent) 0,color-mix(in srgb,var(--color-canvas) 60%,transparent) 26%,color-mix(in srgb,var(--color-canvas) 10%,transparent) 62%,transparent 86%),linear-gradient(0deg,var(--color-canvas) 0,color-mix(in srgb,var(--color-canvas) 94%,transparent) 8%,color-mix(in srgb,var(--color-canvas) 70%,transparent) 20%,color-mix(in srgb,var(--color-canvas) 30%,transparent) 38%,transparent 62%);}
html[data-v-hfade="on"] main [data-tv-hero-zone][data-scroll-anchor="hero"] .harbor-hero-stage::before{content:"";position:absolute;left:0;right:0;bottom:0;height:52%;z-index:1;pointer-events:none;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);-webkit-mask-image:linear-gradient(to bottom,transparent 0,rgba(0,0,0,.55) 35%,#000 75%);mask-image:linear-gradient(to bottom,transparent 0,rgba(0,0,0,.55) 35%,#000 75%);}
html[data-v-ready] .harbor-hero-content{z-index:3!important;}
html[data-v-ready] .harbor-hero-content h1,html[data-v-ready] .harbor-hero-content h2{font-weight:700!important;font-size:clamp(40px,5vw,84px)!important;line-height:.98!important;letter-spacing:-.035em!important;text-shadow:0 4px 24px rgba(0,0,0,.5);}
html[data-v-ready] .harbor-hero-content p{font-size:clamp(14px,1.05vw,17px);line-height:1.65;color:rgba(255,255,255,.84);text-shadow:0 1px 10px rgba(0,0,0,.8);}
html[data-v-ready] :is(.harbor-hero-content,.harbor-hero-bleed,.harbor-anime-hero) :is(span,small,li){text-shadow:0 1px 3px rgba(0,0,0,.8);}
html[data-v-ready] main button[class*="bg-ink"][class*="rounded-full"]{background:#f4f4f6!important;color:#060607!important;border:0!important;text-shadow:none!important;box-shadow:none!important;transition:transform .3s var(--v-ease),background .2s!important;}
html[data-v-ready] main button[class*="bg-ink"][class*="rounded-full"]:hover{transform:translateY(-1px) scale(1.02);background:#fff!important;}
html[data-v-ready] .harbor-hero-bleed .z-10 .flex.flex-col.items-end>.flex{padding:8px 14px;border-radius:14px;background:rgba(var(--v-bg-rgb),.78);box-shadow:inset 0 0 0 1px rgba(255,255,255,.08);}

html[data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el]){position:relative;isolation:isolate;z-index:6;display:flex!important;align-items:stretch;gap:0!important;margin-top:0!important;padding:6px;height:68px;width:max-content;box-sizing:border-box;border-radius:999px;pointer-events:auto!important;
  background:var(--v-glass),rgba(var(--v-bg-rgb),.62);border:1px solid var(--v-rim);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.16),inset 0 -1px 0 rgba(0,0,0,.4),0 18px 40px -22px rgba(0,0,0,.95);
  transform:translate3d(var(--v-dx,0px),0,0);}
html[data-v-cta="on"][data-v-cta-ready] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el]){transition:transform .45s var(--v-ease);}
html[data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el])::before{content:"";position:absolute;z-index:0;left:6px;top:6px;width:calc(50% - 6px);height:calc(100% - 12px);border-radius:999px;background:linear-gradient(180deg,#fff,#e2e2e7);box-shadow:0 6px 16px -8px rgba(0,0,0,.75),inset 0 -2px 0 rgba(0,0,0,.08);transition:transform .4s var(--v-ease);will-change:transform;}
html[data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el]):has(>button:nth-child(2):hover)::before,html[data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el]):has(>button:nth-child(2):focus-visible)::before{transform:translateX(100%);}
html[data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el])>button{position:relative;z-index:1;flex:1 1 0!important;min-width:176px;height:100%!important;margin:0!important;padding:0 28px!important;border:0!important;border-radius:999px!important;background:transparent!important;box-shadow:none!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;display:inline-flex!important;align-items:center;justify-content:center;gap:10px;font:650 15.5px var(--v-text)!important;letter-spacing:-.005em;white-space:nowrap;text-shadow:none!important;transform:none!important;cursor:pointer;transition:color .25s!important;}
html[data-v-cta="on"] :is([data-scroll-anchor="hero"] .harbor-hero-content .mt-9,[data-v-cta-el])>button svg{width:18px;height:18px;flex:none;}
