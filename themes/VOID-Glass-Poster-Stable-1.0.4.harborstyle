    q('.v-cassette-close',view).addEventListener('click',function(){closeMusicFull();},{signal:musicViewCtrl.signal});
    view.tabIndex=-1;view.addEventListener('keydown',onDeckSpace,{capture:true,signal:musicViewCtrl.signal});view.addEventListener('keyup',onDeckSpaceUp,{capture:true,signal:musicViewCtrl.signal});updateMusicFull();view.focus({preventScroll:true});
  }
  function clearMusicMarks(host){if(!host)return;
    [host].concat(qa('[data-v-m-grid],[data-v-m-column],[data-v-m-toggle]',host)).forEach(function(el){['data-v-m-deck','data-v-m-grid','data-v-m-column','data-v-m-toggle','data-v-m-playing'].forEach(function(k){el.removeAttribute(k);});});
    qa('.v-m-expand',host).forEach(function(el){el.remove();});var floating=q('body > .v-m-record');if(floating)floating.remove();
  }
  function decorateMusic(){if(!live)return;var host=qa('[data-music-dock]').find(function(d){return !d.hasAttribute('data-music-dock-tab');})||q('[data-music-dock]');
    if(host!==musicHost){motorStop();if(musicObserver)musicObserver.disconnect();clearMusicMarks(musicHost);musicHost=host;lastSig=null;lastChange=0;lastState=false;if(!host)closeMusicFull(false);
      if(host){musicObserver=new MutationObserver(function(ms){if(!live||musicRaf)return;if(ms.some(function(m){return !(m.target instanceof Element)||!m.target.closest('.v-m-record,.v-m-expand');}))musicRaf=win.requestAnimationFrame(function(){musicRaf=0;if(live)decorateMusic();});});musicObserver.observe(host,{subtree:true,childList:true,attributes:true,attributeFilter:['class','d','aria-pressed','aria-label','data-expanded','data-music-dock-tab','data-auto-hidden']});}
    }
    if(!host)return;
    if(!prefs.deck||host.hasAttribute('data-music-dock-tab')||host.hasAttribute('data-expanded')){if(host.hasAttribute('data-v-m-deck'))clearMusicMarks(host);closeMusicFull(false);return;}
    var play=q('.music-dock-play',host);if(!play){clearMusicMarks(host);closeMusicFull(false);return;}var grid=play;while(grid.parentElement&&grid.parentElement!==host)grid=grid.parentElement;
    var cols=Array.prototype.slice.call(grid.children);if(grid.parentElement!==host||cols.length!==3||!cols[1].contains(play)){clearMusicMarks(host);closeMusicFull(false);return;}
    musicMark(host,'data-v-m-deck','');musicMark(grid,'data-v-m-grid','');cols.forEach(function(c,i){musicMark(c,'data-v-m-column',['info','transport','tools'][i]);});
    qa('button',cols[1]).forEach(function(button){if(musicPath(button,'M1.6,5.1h3.2')||musicPath(button,'M9,19H6.7'))musicMark(button,'data-v-m-toggle',String(button.getAttribute('aria-pressed')==='true'||button.classList.contains('music-dock-icon-on'))==='true'?'on':'off');});
    musicMark(host,'data-v-m-playing',String(musicPlaying(play)));
    var peek=q('body > .v-m-record');
    if(!peek){peek=doc.createElement('button');peek.type='button';peek.className='v-m-record';peek.setAttribute('data-v-cd-portal','');peek.setAttribute('aria-label',tx('Open cassette player'));peek.title=tx('Open cassette player');var disc=doc.createElement('span');disc.className='v-cd';var art=doc.createElement('img');art.className='v-cd-art';art.alt='';art.draggable=false;art.hidden=true;disc.appendChild(art);peek.appendChild(disc);doc.body.appendChild(peek);
      // ONE native click, handled on the non-rotating button itself. Never
      // open on pointerdown and then close on its synthetic follow-up click.
      listen(peek,'click',function(e){if(e.button!==0)return;e.preventDefault();e.stopPropagation();if(!musicFull)openMusicFull();else closeMusicFull();});}
    musicMark(peek,'data-v-floating-play',String(musicPlaying(play)));
    musicMark(peek,'data-v-dock-hidden',String(host.hasAttribute('data-auto-hidden')||host.hasAttribute('data-closing')));
    if(!q('.v-m-expand',cols[2])){var expand=doc.createElement('button');expand.type='button';expand.className='v-m-expand';expand.setAttribute('aria-label',tx('Expand cassette player'));expand.title=tx('Expand cassette player');expand.setAttribute('aria-expanded',String(!!musicFull));expand.setAttribute('aria-controls','v-cassette-view');expand.innerHTML=MUSIC_EXPAND_SVG;cols[2].appendChild(expand);listen(expand,'click',openMusicFull);}
    updateMusicFull();syncSpin();if(musicDesk&&musicDesk.isConnected)musicDeskSync();
  }
  function clearMusic(){motorStop();if(musicObserver)musicObserver.disconnect();musicObserver=null;if(musicRaf)win.cancelAnimationFrame(musicRaf);musicRaf=0;closeMusicFull(false);clearMusicMarks(musicHost);musicHost=null;}


  var bookHost=null,bookObserver=null,bookRaf=0,bookItems=[];

  /* Native Harbor chapter progress: harbor.mangaread.v1.<profile>. No extra
     writable database and no library-wide completion claims. The completed
     flag means the CURRENT CHAPTER was completed, not the entire manga. */
  var ribbonProfile='',ribbonStorage=null,ribbonTitles=new Map();
  function ribbonNormalize(t){return String(t||'').normalize('NFKD').toLowerCase().replace(/[\u0300-\u036f]/g,'').replace(/[^\p{L}\p{N}]+/gu,'');}
  function ribbonProfileId(){
    try{
      var provider=localStorage.getItem('harbor.account-provider');
      if(!provider){var sets=localStorage.getItem('harbor.settings.shared')||localStorage.getItem('harbor.settings');if(sets)provider=JSON.parse(sets).accountProvider||'';}
      if(provider==='nuvio'){
        var nuvio=JSON.parse(localStorage.getItem('harbor.nuvio.state.v1')||localStorage.getItem('harbor.nuvio.state')||'{}');
        var slot=Number(nuvio.activeProfileIndex);return 'nuvio-'+(Number.isInteger(slot)&&slot>=1&&slot<=6?slot:1);
      }
      var profiles=JSON.parse(localStorage.getItem('harbor.profiles.v1')||'{}');
      return typeof profiles.activeId==='string'&&profiles.activeId?profiles.activeId:'default';
    }catch(_e){return 'default';}
  }
  function ribbonSnapshot(){
    if(!prefs.ribbons){ribbonTitles.clear();ribbonStorage=null;return;}
    var pid=ribbonProfileId(),raw=null;
    try{raw=localStorage.getItem('harbor.mangaread.v1.'+pid);}catch(_e){}
    if(pid===ribbonProfile&&raw===ribbonStorage)return;
    ribbonProfile=pid;ribbonStorage=raw;ribbonTitles=new Map();
    if(!raw)return;
    try{var entries=JSON.parse(raw);if(!Array.isArray(entries))return;
      entries.forEach(function(e){if(!e||typeof e.title!=='string'||!e.chapterId)return;
        var key=ribbonNormalize(e.title);if(!key)return;
        var prev=ribbonTitles.get(key);if(!prev||(Number(e.updatedAt)||0)>(Number(prev.updatedAt)||0))ribbonTitles.set(key,e);
      });
    }catch(_e){}
  }
  function ribbonFor(item,name){
    if(!prefs.ribbons){if(item.ribbon){item.ribbon.remove();item.ribbon=null;}return;}
    var key=ribbonNormalize(name),entry=key?ribbonTitles.get(key):null;
    if(!entry){if(item.ribbon){item.ribbon.remove();item.ribbon=null;}return;}
    var completed=entry.completed===true&&!entry.upNext;
    var next=entry.upNext===true;
    var total=Math.max(0,Number(entry.totalPages)||0),page=Math.max(0,Number(entry.page)||0);
    var percent=completed?100:(total>0?Math.max(0,Math.min(100,Math.round(page/total*100))):0);
    var state=completed?'done':next?'next':'reading';
    var label=completed?'Current chapter finished':next?'Next chapter ready':'Current chapter in progress';
    var chap=String(entry.chapterLabel||entry.chapterNumber||'').trim();
    var descr=label+(chap?' · '+chap:'')+(total>0?' · '+Math.min(page,total)+' / '+total+' pages':'');
    if(!item.ribbon){
      var node=doc.createElement('span');node.className='v-book-ribbon';node.setAttribute('aria-hidden','true');
      node.innerHTML='<span class="v-ribbon-icon"></span><span class="v-ribbon-progress"></span><span class="v-ribbon-track"><i></i></span>';
      item.ribbon=node;
    }
    if(item.ribbon.parentElement!==item.stage)item.stage.appendChild(item.ribbon);
    if(item.ribbon.dataset.state!==state)item.ribbon.dataset.state=state;
    if(item.ribbon.dataset.readSignature!==descr){
      item.ribbon.dataset.readSignature=descr;
      item.ribbon.title=descr;
      q('.v-ribbon-icon',item.ribbon).textContent=completed?'✓':next?'›':'•';
      q('.v-ribbon-progress',item.ribbon).textContent=next?'NEXT':completed?'READ':percent+'%';
      item.ribbon.style.setProperty('--v-progress',percent+'%');
    }
  }

  function releaseBook(item){
    item.card.removeAttribute('data-v-book');item.stage.removeAttribute('data-v-book-stage');item.poster.removeAttribute('data-v-book-cover');
    if(item.spine&&item.spine.parentNode)item.spine.remove();
    if(item.leaves&&item.leaves.parentNode)item.leaves.remove();if(item.gloss&&item.gloss.parentNode)item.gloss.remove();if(item.plank&&item.plank.parentNode)item.plank.remove();if(item.ribbon&&item.ribbon.parentNode)item.ribbon.remove();
  }
  function clearBooks(){if(bookObserver)bookObserver.disconnect();bookObserver=null;if(bookRaf)win.cancelAnimationFrame(bookRaf);bookRaf=0;bookItems.forEach(releaseBook);bookItems=[];bookHost=null;}
  function decorateBooks(){
    if(!live)return;var host=prefs.books&&root.getAttribute('data-v-page')==='manga'?activeMain():null;
    if(host!==bookHost){clearBooks();bookHost=host;if(host){bookObserver=new MutationObserver(function(ms){
      if(!live||bookRaf)return;var changed=ms.some(function(m){var target=m.target.nodeType===1?m.target:m.target.parentElement;if(target&&target.closest('.v-book-spine,.v-book-leaves,.v-book-gloss,.v-book-plank,.v-book-ribbon,.v-hub'))return false;
        if(m.type==='characterData')return true;var nodes=Array.prototype.slice.call(m.addedNodes).concat(Array.prototype.slice.call(m.removedNodes));return nodes.some(function(n){return !(n.nodeType===1&&(n.classList.contains('v-book-spine')||n.classList.contains('v-book-leaves')||n.classList.contains('v-book-gloss')||n.classList.contains('v-book-plank')||n.classList.contains('v-book-ribbon')||n.classList.contains('v-hub')));});});
      if(changed)bookRaf=win.requestAnimationFrame(function(){bookRaf=0;if(live)decorateBooks();});
    });bookObserver.observe(host,{subtree:true,childList:true,characterData:true});}}
    if(!host)return;
    ribbonSnapshot();
    bookItems=bookItems.filter(function(item){if(item.card.isConnected&&host.contains(item.card)&&item.stage.parentElement===item.card&&item.poster.parentElement===item.stage)return true;releaseBook(item);return false;});
    var bookLookup=new Map();bookItems.forEach(function(item){
      bookLookup.set(item.card,item);
      // Native React can update a title without remounting a poster.
      if(item.titleEl&&item.spine){var latest=(item.titleEl.textContent||'').trim();if(item.spine.textContent!==latest)item.spine.textContent=latest;ribbonFor(item,latest);}
      // Recover physical layers after a partial React subtree update.
      if(item.spine&&!item.spine.isConnected)item.stage.appendChild(item.spine);
      if(item.leaves&&!item.leaves.isConnected)item.stage.insertBefore(item.leaves,item.poster);
      if(item.gloss&&!item.gloss.isConnected)item.poster.appendChild(item.gloss);
    });
    qa('button.group.flex-col.w-full:not([data-v-book])',host).forEach(function(card){
      if(!card.classList.contains('flex-col')||!card.classList.contains('w-full')||card.children.length<2)return;
      var stage=card.children[0],meta=Array.prototype.slice.call(card.children).filter(function(c,ci){return ci>0&&!c.classList.contains('v-book-plank');})[0],poster=q(':scope > .harbor-poster',stage),title=q('p',meta);
      if(!poster||!meta||!title)return;
      var item=bookLookup.get(card);
      if(!item){var spine=doc.createElement('span');spine.className='v-book-spine';spine.setAttribute('aria-hidden','true');stage.appendChild(spine);item={card:card,stage:stage,poster:poster,titleEl:title,spine:spine,leaves:null,gloss:null,plank:null};bookItems.push(item);bookLookup.set(card,item);}
      if(!item.spine.isConnected)stage.appendChild(item.spine);
      if(!item.leaves){var lv=doc.createElement('span');lv.className='v-book-leaves';lv.setAttribute('aria-hidden','true');for(var li=0;li<4;li++){var lf=doc.createElement('i');lf.style.setProperty('--i',String(li));lv.appendChild(lf);}item.leaves=lv;}
      if(!item.leaves.isConnected)stage.insertBefore(item.leaves,poster);
      if(!item.gloss){item.gloss=doc.createElement('span');item.gloss.className='v-book-gloss';item.gloss.setAttribute('aria-hidden','true');}
      if(!item.gloss.isConnected)poster.appendChild(item.gloss);
      if(!item.plank){item.plank=doc.createElement('span');item.plank.className='v-book-plank';item.plank.setAttribute('aria-hidden','true');}
      if(!item.plank.isConnected)card.insertBefore(item.plank,meta);
      var name=(title.textContent||'').trim();if(item.spine.textContent!==name)item.spine.textContent=name;ribbonFor(item,name);
      if(!card.hasAttribute('data-v-book'))card.setAttribute('data-v-book','');if(!stage.hasAttribute('data-v-book-stage'))stage.setAttribute('data-v-book-stage','');if(!poster.hasAttribute('data-v-book-cover'))poster.setAttribute('data-v-book-cover','');
    });
  }

  function tagArt(){var mv=q('[data-music-view]');if(!mv)return;qa('img:not([data-v-art])',mv).forEach(function(im){if(im.closest('.v-m-record,#v-cassette-view,.music-feature-controls'))return;var w=im.clientWidth,h=im.clientHeight;if(w>=110&&Math.abs(w-h)<8&&!im.closest('.music-home-feature'))im.setAttribute('data-v-art','');});}
  function clearArt(){qa('[data-v-art]').forEach(function(n){n.removeAttribute('data-v-art');});}
  var hub=null,hubKey='',topBtn=null;
  function buildHub(){var on=root.getAttribute('data-v-page')==='manga'&&prefs.hub;var m=on?activeMain():null;
    if(!m){if(hub){hub.remove();hub=null;hubKey='';}return;}
    var hs=qa('section h2',m).filter(function(h){return (h.textContent||'').trim();});
    var key=hs.map(function(h){return h.textContent.trim();}).join('|');
    if(hub&&hub.isConnected&&hubKey===key&&m.contains(hub))return;
    if(hub)hub.remove();hubKey=key;hub=doc.createElement('div');hub.className='v-hub';
    hub.innerHTML='<div class="v-hub-title">Library<small>Manga</small></div><div class="v-hub-chips" role="toolbar" aria-label="Jump to shelf"></div><div class="v-hub-end">Right to left</div>';localeText(hub);
    var chips=q('.v-hub-chips',hub);
    hs.slice(0,14).forEach(function(h){var b=doc.createElement('button');b.type='button';b.textContent=h.textContent.trim();listen(b,'click',function(){h.scrollIntoView({behavior:vScrollBehavior(),block:'start'});qa('button',chips).forEach(function(x){x.removeAttribute('aria-current');});b.setAttribute('aria-current','true');});chips.appendChild(b);});
    if(!hs.length)chips.hidden=true;
    var tp=hs.length?hs[0]:null;while(tp&&tp.parentElement&&tp.parentElement!==m)tp=tp.parentElement;if(tp&&tp.parentElement===m)m.insertBefore(hub,tp);else m.insertBefore(hub,m.firstChild);}
  function mountTop(){if(topBtn&&topBtn.isConnected)return;topBtn=doc.createElement('button');topBtn.type='button';topBtn.className='v-top';topBtn.setAttribute('aria-label',tx('Back to top'));topBtn.title=tx('Back to top');topBtn.innerHTML='<svg viewBox="0 0 24 24"><path d="M6 14l6-6 6 6"/></svg>';
    listen(topBtn,'click',function(){var m=scrollMain||activeMain();if(m)m.scrollTo({top:0,behavior:vScrollBehavior()});});doc.body.appendChild(topBtn);}

  /* VOID music desk: uses the real dock and Harbor Music tabs. No duplicated
     playback engine, no chart API, and no per-frame DOM scanning. */
  var musicDesk=null,musicDeskHome=null,musicDeskSig='';
  function removeMusicDesk(){if(musicDesk){musicDesk.remove();musicDesk=null;}musicDeskHome=null;musicDeskSig='';}
  function musicDeskMount(){
    var home=q('[data-music-view] .music-home-intro');
    if(!home){if(musicDesk&&!musicDesk.isConnected){musicDesk=null;musicDeskHome=null;musicDeskSig='';}return;}
    if(musicDesk&&musicDesk.isConnected&&musicDeskHome===home)return;
    if(musicDesk)musicDesk.remove();
    musicDeskHome=home;musicDeskSig='';musicDesk=doc.createElement('section');
    musicDesk.className='v-music-desk';musicDesk.setAttribute('aria-label',tx('VOID music dashboard'));
    musicDesk.innerHTML='<div class="v-music-desk-lead">'+
      '<span class="v-music-eyebrow">VOID / MUSIC</span>'+ 
      '<h2>Your rotation.<br>Your rules.</h2>'+ 
      '<p>Pick up where you left off, revisit favorites, or discover something new.</p>'+ 
      '<div class="v-music-links"><button type="button" data-v-music-go="library">My Library</button><button type="button" data-v-music-go="explore">Explore Music</button></div></div>'+ 
      '<div class="v-music-now"><div class="v-music-now-info"><img class="v-music-now-art" alt="" />'+
      '<div class="v-music-now-lines"><div class="v-music-now-state">LISTENING DESK</div>'+ 
      '<div class="v-music-now-title">Ready when you are</div><div class="v-music-now-artist">Choose a track to start listening</div></div></div>'+ 
      '<div class="v-music-now-progress" aria-hidden="true"><span></span></div>'+ 
      '<div class="v-music-now-actions"><button type="button" data-v-music-go="play" disabled>Play</button>'+ 
      '<button type="button" data-v-music-go="cassette" disabled>Open Cassette</button></div></div>';
    home.insertBefore(musicDesk,home.firstChild);localeText(musicDesk);
    listen(musicDesk,'click',function(e){var b=e.target.closest('button[data-v-music-go]');if(!b||b.disabled)return;
      var a=b.getAttribute('data-v-music-go');if(a==='library'||a==='explore'){var tab=doc.getElementById('music-tab-'+a);if(tab)tab.click();}
      else if(a==='play')deckAction('play');else if(a==='cassette')openMusicFull();});
    musicDeskSync();
  }
  function musicDeskSync(){
    if(!musicDesk||!musicDesk.isConnected)return;
    var info=musicHost&&q('[data-v-m-column="info"]',musicHost),play=musicHost&&q('.music-dock-play',musicHost);
    var title=tx('Ready when you are'),artist=tx('Choose a track to start listening'),url='',active=false;
    if(info&&play){
      var trackInfo=info.matches('.music-dock-track')?info:q('.music-dock-track',info),trackTitle=trackInfo&&q('button[title]',trackInfo);
      var artistLink=trackTitle&&trackTitle.parentElement&&q('span[title]',trackTitle.parentElement);
      if(trackTitle){title=(trackTitle.getAttribute('title')||trackTitle.textContent||'').trim();
        artist=artistLink?(artistLink.getAttribute('title')||artistLink.textContent||'').trim():'';active=!!title;}
      else{var textLines=(info.innerText||'').split(/\n/).map(function(s){return s.trim();}).filter(Boolean);
        if(textLines.length){title=textLines[0];artist=textLines[1]||'';active=true;}}
      var img=q('img',info);if(img)url=img.getAttribute('src')||'';
    }
    var playing=!!(active&&play&&musicPlaying(play));
    var button=q('[data-v-music-go="play"]',musicDesk),cassette=q('[data-v-music-go="cassette"]',musicDesk);
    var sig=[title,artist,url,playing,!!(play&&play.disabled),active,arabicMode].join('|');
    if(sig!==musicDeskSig){musicDeskSig=sig;
      var t=q('.v-music-now-title',musicDesk),a=q('.v-music-now-artist',musicDesk),state=q('.v-music-now-state',musicDesk),img=q('.v-music-now-art',musicDesk);
      if(t)t.textContent=title;if(a)a.textContent=artist;
      if(state)state.textContent=tx(!active?'LISTENING DESK':play&&play.disabled?'CONNECTING':playing?'NOW PLAYING':'ON DECK');
      if(img&&img.getAttribute('src')!==url){if(url)img.setAttribute('src',url);else img.removeAttribute('src');}
      if(button){button.disabled=!active||play.disabled;button.textContent=tx(play&&play.disabled?'Loading…':playing?'Pause':'Play');}
      if(cassette)cassette.disabled=!musicHost||!musicHost.hasAttribute('data-v-m-deck');
    }
    var r=deckRange(),p=r?Math.max(0,Math.min(100,(Number(r.value)/Math.max(1,Number(r.max)))*100)):0;
    var bar=q('.v-music-now-progress > span',musicDesk);if(bar){var next=p.toFixed(1)+'%';if(bar.style.width!==next)bar.style.width=next;}
  }

  function refresh(){raf=0;if(!live||!rail||doc.hidden)return;
    if(performance.now()-lastScroll<250){schedule();return;}
    lastRun=performance.now();
    // Native navigation is the source of truth; read the route AFTER syncing it.
    watchNativeNav();buildNav();var page=root.getAttribute('data-v-page');
    mountTop();decorateMusic();measureDock();mountHey();mountClock();
    if(page==='manga'){decorateBooks();buildHub();}
    else if(bookHost||hub){decorateBooks();buildHub();}
    if(page==='music'){widenMusic();musicDeskMount();musicDeskSync();}
    if(page!=='music'){tagOrder();tagRanks();fillRows();tagBrands();tagPicker();placeCta();liftControls();buildFlow();}
    else if(flow){buildFlow();}
  }
  function schedule(now){if(!live||raf||timer)return;var wait=now?0:Math.max(150,300-(performance.now()-lastRun));timer=win.setTimeout(function(){timer=0;if(!live||raf)return;raf=win.requestAnimationFrame(refresh);},wait);}
  // The navigation state is much smaller than the page. Observe the actual
  // native sidebar, not every poster/image/ARIA mutation in the document.
  function watchNativeNav(){
    var next=q('aside[data-harbor-sidebar]');
    if(next===navElement)return;
    if(navObserver)navObserver.disconnect();
    navElement=next;
    if(next){navObserver=new MutationObserver(function(ms){
      if(!live)return;
      for(var i=0;i<ms.length;i++){
        var t=ms[i].target;
        if(t instanceof Element&&t.closest('[data-harbor-nav]')){schedule();return;}
      }
    });navObserver.observe(next,{subtree:true,attributes:true,attributeFilter:['data-active','aria-current','aria-selected','aria-label']});}
  }
  function relevantAdd(m){
    for(var j=0;j<m.addedNodes.length;j++){
      var n=m.addedNodes[j];if(n.nodeType!==1)continue;
      if(n.matches('main,aside[data-harbor-sidebar],[data-scroll-anchor],.harbor-service-tile,[data-no-card-ring],[data-music-view],[data-music-dock],.music-home-intro'))return true;
      if(n.querySelector('[data-scroll-anchor],.harbor-service-tile,[data-no-card-ring],[data-music-view],[data-music-dock],.music-home-intro,aside[data-harbor-sidebar]'))return true;
    }
    return false;
  }
  function mutation(ms){
    // Do not respond to poster loading, its fallback/shimmer DOM, or React-owned
    // media cards. The dedicated Manga/Music observers already handle those views.
    for(var i=0;i<ms.length;i++){
      var m=ms[i],t=m.target;
      if(!(t instanceof Element)||t.closest('.harbor-poster,[data-media-card],[data-music-dock],#v-rail,#v-panel,#v-edge,#v-jump,#v-shortcuts,.v-flow,.v-hey,.v-clock,#v-cassette-view,.v-music-desk'))continue;
      if(!relevantAdd(m))continue;
      watchNativeNav();schedule();return;
    }
  }
  function install(){if(!live)return;var tpl=q('#v-template');if(!tpl||!doc.body){if(++bootTries<80)bootT=win.setTimeout(install,110);return;}
    var c=tpl.content;prog=q('#v-progress',c).cloneNode(true);edge=q('#v-edge',c).cloneNode(true);rail=q('#v-rail',c).cloneNode(true);jump=q('#v-jump',c).cloneNode(true);shortcuts=q('#v-shortcuts',c).cloneNode(true);panel=q('#v-panel',c).cloneNode(true);
    doc.body.append(prog,edge,rail,jump,panel,shortcuts);rail.hidden=false;syncLocale();presetRender();
    listen(shortcuts,'click',function(e){if(e.target===shortcuts||e.target.closest('[data-v-shortcut-close]'))closeShortcuts();});
    listen(q('.v-shortcuts-search',shortcuts),'input',filterShortcuts);
    var fontInput=q('[data-v-font-file]',panel);if(fontInput)listen(fontInput,'change',function(){
      var file=fontInput.files&&fontInput.files[0];fontInput.value='';if(file)fontUpload(file);
    });
    var importInput=q('[data-v-studio-file]',panel);if(importInput)listen(importInput,'change',function(){var file=importInput.files&&importInput.files[0];if(!file)return;importInput.value='';
      if(file.size>PRESET_FILE_MAX){presetFeedback('File exceeds 64 KB limit.','error');return;}
      file.text().then(function(raw){if(live)presetImport(raw);}).catch(function(){if(live)presetFeedback('Could not read file.','error');});});
    listen(rail,'click',onAction);listen(panel,'click',onAction);
    listen(jump,'click',function(e){var li=e.target.closest('li[data-id]');if(li){jumpSel=qa('li',jump).indexOf(li);runJump();}else if(e.target===jump)closeJump();});
    listen(q('input',jump),'input',function(){jumpSel=0;renderJump();});
    listen(q('input',jump),'keydown',function(e){var n=jumpItems().length;if(e.key==='Tab'){e.preventDefault();return;}if(e.key==='ArrowDown'){e.preventDefault();jumpSel=Math.min(n-1,jumpSel+1);renderJump();}else if(e.key==='ArrowUp'){e.preventDefault();jumpSel=Math.max(0,jumpSel-1);renderJump();}else if(e.key==='Enter'){e.preventDefault();runJump();}});
    listen(edge,'pointerenter',function(e){if(e.pointerType!=='touch'&&e.pointerType!=='pen'){clearTimeout(closeT);setSide(true);}});
    // A genuine button keeps the auto-hide rail reachable on touch and by keyboard.
    listen(edge,'click',function(){if(chromeBlocked())return;clearTimeout(closeT);setSide(true);
      var first=q('.v-navbtn[data-active="true"]',rail)||q('.v-navbtn',rail);
      if(first)first.focus({preventScroll:true});});
    listen(doc,'pointerdown',function(e){if(prefs.pin||!sideOpen||!rail||e.target.closest('#v-rail,#v-edge,#v-panel,#v-jump,#v-shortcuts'))return;
      setSide(false);},{capture:true});
    listen(doc,'pointermove',onMove,{passive:true});
    listen(rail,'pointerenter',function(){clearTimeout(closeT);});
    listen(rail,'pointerleave',function(){scheduleClose(380);});
    listen(rail,'focusin',function(){clearTimeout(closeT);closeT=0;});
    listen(rail,'focusout',function(e){if(!rail.contains(e.relatedTarget))scheduleClose(380);});
    listen(doc,'pointerdown',function(e){if(!panel.hidden&&!panel.contains(e.target)&&!e.target.closest('[data-v-action="panel"]'))togglePanel(false);},{capture:true});
    listen(win,'keydown',onGlobalKey,{capture:true});
    listen(win,'keydown',onReaderArrow,{capture:true});
    listen(win,'keydown',onDeckSpace,{capture:true});
    listen(doc,'keydown',onDeckSpace,{capture:true});
    listen(win,'keyup',onDeckSpaceUp,{capture:true});
    listen(win,'keydown',onDeckSeekKey,{capture:true});
    listen(doc,'keyup',onDeckSpaceUp,{capture:true});
    listen(win,'keydown',function(e){if(!musicFull||e.defaultPrevented)return;var target=e.target instanceof Element?e.target.closest('[role=dialog]'):null;if(target&&target!==musicFull)return;
      if(e.key==='Escape'){e.preventDefault();closeMusicFull();return;}
      if(e.key==='Tab'){var nodes=musicChromeButtons().concat(qa('button,a[href],input,select,textarea,[tabindex="0"]',musicFull)).concat(qa('button,a[href],input,select,textarea,[tabindex="0"]',musicHost)).filter(function(el,i,all){return all.indexOf(el)===i&&!el.disabled&&!el.closest('[hidden],[inert]')&&el.getClientRects().length&&win.getComputedStyle(el).visibility!=='hidden';}).sort(function(a,b){return a===b?0:(a.compareDocumentPosition(b)&4?-1:1);});if(!nodes.length)return;var first=nodes[0],last=nodes[nodes.length-1],a=doc.activeElement;if(e.shiftKey&&(a===first||nodes.indexOf(a)<0)){e.preventDefault();last.focus({preventScroll:true});}else if(!e.shiftKey&&(a===last||nodes.indexOf(a)<0)){e.preventDefault();first.focus({preventScroll:true});}}
    });
    listen(doc,'scroll',onScroll,{capture:true,passive:true});listen(win,'resize',function(){ctaKey='';if(flow)layoutFlow();musicWindowEdge();schedule();},{passive:true});listen(win,'storage',function(){schedule();});listen(win,'harbor:active-profile-changed',function(){schedule(true);});
    listen(doc,'visibilitychange',function(){if(!doc.hidden)schedule(true);motorSync();atmoSyncSettings();});
    ['play','pause','ended','playing'].forEach(function(ev){listen(doc,ev,function(){if(musicHost)decorateMusic();},{capture:true});});
    observer=new MutationObserver(mutation);observer.observe(doc.body,{subtree:true,childList:true});watchNativeNav();
    localeObserver=new MutationObserver(function(){if(live){buildNav();mountHey();mountClock();}});localeObserver.observe(root,{attributes:true,attributeFilter:['dir','lang']});localeObserver.observe(doc.body,{attributes:true,attributeFilter:['dir','lang']});
    if(doc.fonts&&doc.fonts.ready)doc.fonts.ready.then(function(){if(live){ctaKey='';schedule(true);}});
    root.setAttribute('data-v-ready','');setSide(prefs.pin);applyPrefs();fontRestore();buildNav();schedule(true);poll=win.setInterval(function(){if(!doc.hidden){mountClock();schedule();}},30000);tick=win.setInterval(function(){if(doc.hidden||!musicHost)return;
      if(musicFull){syncSpin();deckUpdateControls();}
      if(musicDesk&&musicDesk.isConnected)musicDeskSync();
    },1000);
  }
  function cleanup(){if(!live)return;live=false;fontSeq++;if(customFace){try{doc.fonts.delete(customFace);}catch(_e){}customFace=null;}abort.abort();clearTimeout(bootT);clearTimeout(closeT);clearTimeout(enterT);clearTimeout(timer);clearInterval(poll);clearInterval(tick);if(raf)cancelAnimationFrame(raf);if(scrollRaf)cancelAnimationFrame(scrollRaf);if(observer)observer.disconnect();if(navObserver)navObserver.disconnect();navElement=null;if(localeObserver)localeObserver.disconnect();if(ctaRO)ctaRO.disconnect();
    removeMusicDesk();clearBooks();clearMusic();clearArt();if(hub)hub.remove();if(topBtn)topBtn.remove();removeFlow();clearOrder();clearLift();clearFill();
    qa('[data-v-cta-el]').forEach(function(n){n.removeAttribute('data-v-cta-el');});
    swapped.forEach(function(im){var o=im.getAttribute('data-v-orig');if(o!==null){im.setAttribute('src',o);im.removeAttribute('data-v-orig');}});
    qa('[data-v-brand]').forEach(function(t){t.removeAttribute('data-v-brand');t.style.removeProperty('--v-brand-rgb');});
    qa('[data-v-rank]').forEach(function(t){t.removeAttribute('data-v-rank');});
    qa('[data-v-wide]').forEach(function(t){t.removeAttribute('data-v-wide');});
    clearPicker();qa('[data-q]').forEach(function(n){n.removeAttribute('data-q');});
    root.style.removeProperty('--v-dock-h');root.style.removeProperty('--v-dx');
    [prog,edge,rail,jump,panel,shortcuts,hey,clock].forEach(function(el){if(el)el.remove();});
    Array.prototype.slice.call(root.attributes).map(function(a){return a.name;}).filter(function(n){return n.indexOf('data-v-')===0;}).forEach(function(n){root.removeAttribute(n);});
    if(win.__harborThemeCleanup===cleanup)delete win.__harborThemeCleanup;
  }
  win.__harborThemeCleanup=cleanup;
  if(doc.readyState==='loading')listen(doc,'DOMContentLoaded',install,{once:true});else install();
})();
